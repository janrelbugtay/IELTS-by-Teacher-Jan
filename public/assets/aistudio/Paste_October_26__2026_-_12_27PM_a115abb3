        // --- HIGH-DEFINITION 2048x2048 GRASS COURT TEXTURE + BUMP/NORMAL GENERATOR ---
        function generateHighResGrassCourtTextures() {
            const size = 2048;
            const colorCanvas = document.createElement('canvas');
            colorCanvas.width = size;
            colorCanvas.height = size;
            const ctx = colorCanvas.getContext('2d');

            const bumpCanvas = document.createElement('canvas');
            bumpCanvas.width = 1024;
            bumpCanvas.height = 1024;
            const bCtx = bumpCanvas.getContext('2d');

            // Base lush championship lawn green
            ctx.fillStyle = '#6db33f';
            ctx.fillRect(0, 0, size, size);

            // Dual-directional mowed grass checkerboard stripes (matching screenshot!)
            const numCols = 14;
            const numRows = 22;
            const colW = size / numCols;
            const rowH = size / numRows;

            for (let r = 0; r < numRows; r++) {
                for (let c = 0; c < numCols; c++) {
                    const isLightCol = c % 2 === 0;
                    const isLightRow = r % 2 === 0;
                    let luma = 0;
                    if (isLightCol && isLightRow) luma = 14;
                    else if (!isLightCol && !isLightRow) luma = -12;
                    else if (isLightCol && !isLightRow) luma = 4;
                    else luma = -4;

                    const R = Math.min(255, Math.max(0, 108 + luma));
                    const G = Math.min(255, Math.max(0, 178 + luma));
                    const B = Math.min(255, Math.max(0, 60 + Math.round(luma * 0.6)));
                    ctx.fillStyle = `rgb(${R},${G},${B})`;
                    ctx.fillRect(c * colW, r * rowH, colW + 1, rowH + 1);
                }
            }

            // Add hundreds of thousands of sharp micro grass blades & organic turf grain
            const imgData = ctx.getImageData(0, 0, size, size);
            const data = imgData.data;
            for (let i = 0; i < data.length; i += 4) {
                const grain = (Math.random() - 0.5) * 18;
                data[i]     = Math.min(255, Math.max(0, data[i] + grain * 0.8));
                data[i + 1] = Math.min(255, Math.max(0, data[i + 1] + grain));
                data[i + 2] = Math.min(255, Math.max(0, data[i + 2] + grain * 0.5));
            }
            ctx.putImageData(imgData, 0, 0);

            // Subtle baseline footwork wear patches
            const wearGrad1 = ctx.createRadialGradient(size * 0.5, size * 0.82, 10, size * 0.5, size * 0.82, 190);
            wearGrad1.addColorStop(0, 'rgba(138, 125, 70, 0.22)');
            wearGrad1.addColorStop(1, 'rgba(138, 125, 70, 0)');
            ctx.fillStyle = wearGrad1;
            ctx.fillRect(0, 0, size, size);

            const wearGrad2 = ctx.createRadialGradient(size * 0.5, size * 0.18, 10, size * 0.5, size * 0.18, 190);
            wearGrad2.addColorStop(0, 'rgba(138, 125, 70, 0.22)');
            wearGrad2.addColorStop(1, 'rgba(138, 125, 70, 0)');
            ctx.fillStyle = wearGrad2;
            ctx.fillRect(0, 0, size, size);

            // --- CRISP CHALK WHITE COURT LINES ---
            // Plane dimensions: 34m wide x 38m long
            const planeW = 34.0;
            const planeL = 38.0;
            const toX = (m) => (0.5 + m / planeW) * size;
            const toY = (m) => (0.5 + m / planeL) * size;

            ctx.strokeStyle = '#fafdff';
            ctx.fillStyle = '#fafdff';
            ctx.lineCap = 'square';

            const lineWidthPx = (0.11 / planeW) * size;
            ctx.lineWidth = lineWidthPx;

            const hwDoubles = COURT.doublesWidth / 2;
            const hwSingles = COURT.singlesWidth / 2;
            const hl = COURT.halfLength;
            const sl = COURT.serviceLine;

            // Outer Doubles Rectangle
            ctx.strokeRect(
                toX(-hwDoubles),
                toY(-hl),
                (COURT.doublesWidth / planeW) * size,
                (COURT.length / planeL) * size
            );

            // Singles Sidelines
            ctx.beginPath();
            ctx.moveTo(toX(-hwSingles), toY(-hl));
            ctx.lineTo(toX(-hwSingles), toY(hl));
            ctx.moveTo(toX(hwSingles), toY(-hl));
            ctx.lineTo(toX(hwSingles), toY(hl));

            // Service Lines
            ctx.moveTo(toX(-hwSingles), toY(-sl));
            ctx.lineTo(toX(hwSingles), toY(-sl));
            ctx.moveTo(toX(-hwSingles), toY(sl));
            ctx.lineTo(toX(hwSingles), toY(sl));

            // Center Service Line
            ctx.moveTo(toX(0), toY(-sl));
            ctx.lineTo(toX(0), toY(sl));

            // Baseline Center Marks
            ctx.moveTo(toX(0), toY(-hl));
            ctx.lineTo(toX(0), toY(-hl + 0.45));
            ctx.moveTo(toX(0), toY(hl));
            ctx.lineTo(toX(0), toY(hl - 0.45));
            ctx.stroke();

            // High-Frequency Grass Blade Bump Map
            const bImg = bCtx.createImageData(1024, 1024);
            for (let i = 0; i < bImg.data.length; i += 4) {
                const v = Math.floor(110 + Math.random() * 145);
                bImg.data[i] = v;
                bImg.data[i + 1] = v;
                bImg.data[i + 2] = v;
                bImg.data[i + 3] = 255;
            }
            bCtx.putImageData(bImg, 0, 0);

            const colorTex = new THREE.CanvasTexture(colorCanvas);
            colorTex.anisotropy = maxAnisotropy;
            colorTex.encoding = THREE.sRGBEncoding;
            colorTex.needsUpdate = true;

            const bumpTex = new THREE.CanvasTexture(bumpCanvas);
            bumpTex.anisotropy = maxAnisotropy;
            bumpTex.wrapS = bumpTex.wrapT = THREE.RepeatWrapping;
            bumpTex.repeat.set(6, 6);

            return { colorTex, bumpTex, planeW, planeL };
        }

        // Helper for "Era Tennis Court" Wall Branding Banners
        function createWallBrandTexture() {
            const c = document.createElement('canvas');
            c.width = 512;
