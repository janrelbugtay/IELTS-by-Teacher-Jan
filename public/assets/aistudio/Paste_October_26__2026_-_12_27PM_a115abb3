        // Position all 4 players cleanly for the current serve side & tactic
        function setupPlayersForServe() {
            const side = state.serveSide; // 1 = Deuce (Right), -1 = Ad (Left)
            const isServerRed = (state.serverIndex === 0 || state.serverIndex === 2);
            state.serverIndex = isServerRed ? 0 : 1;

            // Red Baseline
            athletes[0].homeX = side * 2.5;
            athletes[0].homeZ = 11.8;
            // Blue Baseline
            athletes[1].homeX = -side * 2.6;
            athletes[1].homeZ = -11.8;

            // Red Net Partner (Responds to Selected Doubles Tactic)
            if (state.doublesTactic === 'I-Formation' && isServerRed) {
                athletes[2].homeX = 0.0;
                athletes[2].homeZ = 5.4;
            } else if (state.doublesTactic === 'Net Rush') {
                athletes[2].homeX = -side * 1.9;
                athletes[2].homeZ = 3.1;
            } else {
                athletes[2].homeX = -side * 2.3;
                athletes[2].homeZ = 4.4;
            }

            // Blue Net Partner
            athletes[3].homeX = side * 2.3;
            athletes[3].homeZ = -5.0;

            athletes.forEach(a => {
                a.targetX = a.homeX;
                a.targetZ = a.homeZ;
                a.group.position.set(a.homeX, 0, a.homeZ);
                a.group.visible = state.isDoubles || a.role === 'baseline';
                a.emoteTimer = 0;
                a.setFacialExpression('neutral');
            });

            if (state.autoSwitchRed) state.controlledRedIdx = 0;

            state.phase = 'SERVE_WAIT';
            state.hittingTeam = isServerRed ? 'red' : 'blue';
            state.bounceCount = 0;
            state.rallyCount = 0;
            state.replayFrames = [];
            ball.attachToServer();

            updateActionPrompt('SERVE TOSS');
            updateEraSuperUI(0);
            document.getElementById('server-badge').style.opacity = '1';
