        /***********************************************************************
         * 5. TENNIS BALL WITH FELT SHADER, GROUND SHADOW & SPIN RIBBON TRAIL
         ***********************************************************************/
        class FeltTennisBall {
            constructor() {
                const geo = new THREE.SphereGeometry(0.17, 24, 24);
                const mat = new THREE.MeshStandardMaterial({
                    color: 0xd9f905,
                    emissive: 0x84cc16,
                    emissiveIntensity: 0.35,
                    roughness: 0.65
                });
                this.mesh = new THREE.Mesh(geo, mat);
                this.mesh.castShadow = true;
                scene.add(this.mesh);

                // Crisp Ground Target Ring
                const shadowGeo = new THREE.CircleGeometry(0.24, 20);
                const shadowMat = new THREE.MeshBasicMaterial({
                    color: 0x143309,
                    transparent: true,
                    opacity: 0.55
                });
                this.shadowMesh = new THREE.Mesh(shadowGeo, shadowMat);
                this.shadowMesh.rotation.x = -Math.PI / 2;
                this.shadowMesh.position.y = 0.025;
                scene.add(this.shadowMesh);

                // Aerodynamic Trail Ribbon
                this.trailCount = 20;
                this.trailPts = Array.from({ length: this.trailCount }, () => new THREE.Vector3(0, 1, 10));
                const trailGeo = new THREE.BufferGeometry().setFromPoints(this.trailPts);
                const trailMat = new THREE.LineBasicMaterial({
                    color: 0xfef08a,
                    transparent: true,
                    opacity: 0.72
                });
                this.trailLine = new THREE.Line(trailGeo, trailMat);
                scene.add(this.trailLine);

                this.pos = this.mesh.position;
                this.vel = new THREE.Vector3();
                this.spinY = 0;
                this.curveX = 0;
            }

            attachToServer() {
                const server = athletes[state.serverIndex];
                const zSign = server.zSide;
                this.pos.set(
                    server.group.position.x - 0.42 * zSign,
                    1.02 + Math.sin(performance.now() * 0.005) * 0.04,
                    server.group.position.z - 0.25 * zSign
                );
                this.vel.set(0, 0, 0);
                this.shadowMesh.position.set(this.pos.x, 0.025, this.pos.z);
                for (let i = 0; i < this.trailCount; i++) {
                    this.trailPts[i].copy(this.pos);
                }
                this.trailLine.geometry.setFromPoints(this.trailPts);
            }

            launchToTarget(targetX, targetZ, flightTime, topspin = 4.5, sidespin = 0, trailHex = 0xfef08a) {
                const dx = targetX - this.pos.x;
                const dz = targetZ - this.pos.z;
                const effG = COURT.gravity + topspin;

                this.vel.x = dx / flightTime - 0.5 * sidespin * flightTime;
                this.vel.z = dz / flightTime;
                this.vel.y = (0.17 - this.pos.y + 0.5 * effG * flightTime * flightTime) / flightTime;

                this.spinY = topspin;
                this.curveX = sidespin;
                this.trailLine.material.color.setHex(trailHex);
            }

            update(dt) {
                if (state.phase === 'SERVE_WAIT') {
                    this.attachToServer();
                    return;
                }
                if (state.phase === 'REPLAY') return;

                const prevZ = this.pos.z;
                const effG = state.phase === 'SERVE_TOSS' ? COURT.gravity : (COURT.gravity + this.spinY);
                this.vel.y -= effG * dt;
                this.vel.x += this.curveX * dt;
                this.pos.addScaledVector(this.vel, dt);

                // Net Collision Check at Z = 0
                if ((prevZ > 0 && this.pos.z <= 0) || (prevZ < 0 && this.pos.z >= 0)) {
                    if (this.pos.y < COURT.netHeight + 0.08) {
                        if (this.pos.y >= COURT.netHeight - 0.10) {
                            // Net cord clip over
                            this.pos.y = COURT.netHeight + 0.12;
                            this.vel.z *= 0.52;
                            this.vel.y = 2.6;
                            spawnWorldCallout('NET CORD!', this.pos, '#facc15');
                        } else {
                            // Into the net
                            this.vel.z *= -0.25;
                            this.vel.x *= 0.4;
                            this.pos.z = prevZ > 0 ? 0.2 : -0.2;
                            if (state.phase === 'RALLY') {
                                const winner = state.hittingTeam === 'red' ? 'blue' : 'red';
                                finishPoint(winner, 'NET!');
                            }
                        }
                    }
                }

                // Grass Court Bounce
                if (this.pos.y <= 0.17 && this.vel.y < 0) {
                    this.pos.y = 0.17;

                    if (state.phase === 'SERVE_TOSS') {
                        // Let toss drop without hitting -> reset toss
                        state.phase = 'SERVE_WAIT';
                        updateActionPrompt('SERVE TOSS');
                        return;
                    }

                    this.vel.y = -this.vel.y * 0.72;
                    this.vel.x *= 0.86;
                    this.vel.z *= 0.84;

                    sound.playGrassBounce();
                    spawnChalkBurst(this.pos.x, this.pos.z);

                    if (state.phase === 'RALLY') {
                        evaluateBounceRules(this.pos.x, this.pos.z);
                    }
                }

                this.shadowMesh.position.set(this.pos.x, 0.025, this.pos.z);
                this.trailPts.pop();
                this.trailPts.unshift(this.pos.clone());
                this.trailLine.geometry.setFromPoints(this.trailPts);
            }
        }

        const ball = new FeltTennisBall();

        // Chalk / Grass Puff Particles on Bounce
        const puffs = [];
        const puffGeo = new THREE.SphereGeometry(0.055, 6, 6);

        function spawnChalkBurst(x, z, count = 10) {
            for (let i = 0; i < count; i++) {
                const mat = new THREE.MeshBasicMaterial({ color: 0xf8fafc, transparent: true, opacity: 0.85 });
                const m = new THREE.Mesh(puffGeo, mat);
                m.position.set(x, 0.06, z);
                const ang = (i / count) * Math.PI * 2 + Math.random() * 0.5;
                const spd = 1.0 + Math.random() * 2.2;
                scene.add(m);
                puffs.push({
                    mesh: m,
                    vel: new THREE.Vector3(Math.cos(ang) * spd, 1.2 + Math.random() * 1.8, Math.sin(ang) * spd),
                    life: 1.0
                });
            }
        }

        function updatePuffs(dt) {
            for (let i = puffs.length - 1; i >= 0; i--) {
                const p = puffs[i];
                p.life -= dt * 2.6;
                if (p.life <= 0) {
                    scene.remove(p.mesh);
                    p.mesh.material.dispose();
                    puffs.splice(i, 1);
                } else {
                    p.vel.y -= 9.8 * dt;
                    p.mesh.position.addScaledVector(p.vel, dt);
                    p.mesh.material.opacity = p.life * 0.8;
                    p.mesh.scale.setScalar(p.life);
                }
            }
        }

