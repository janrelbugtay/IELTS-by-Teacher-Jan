            triggerSwing(ballPos, isVolley = false) {
                this.isSwinging = true;
                this.swingProgress = 0;
                this.setFacialExpression('effort');

                const relX = (ballPos.x - this.group.position.x) * this.zSide;
                const reachDist = Math.hypot(ballPos.x - this.group.position.x, ballPos.z - this.group.position.z);
                this.lungeFactor = THREE.MathUtils.clamp((reachDist - 1.6) * 0.5, 0, 1);

                if (ballPos.y > 2.02) {
                    this.swingSide = 0; // Jumping Overhead Smash
                    this.jumpHeight = 0.55;
                } else if (isVolley || this.role === 'net') {
                    this.swingSide = relX >= -0.15 ? 1 : -1;
                } else {
                    this.swingSide = relX >= -0.2 ? 1 : -1;
                }
            }

            update(dt, ballPos, elapsed) {
                const prevX = this.group.position.x;
                const prevZ = this.group.position.z;

                const moveSpeed = this.role === 'net' ? 10.4 : 11.8;
                this.group.position.x += (this.targetX - this.group.position.x) * Math.min(1, dt * moveSpeed);
                this.group.position.z += (this.targetZ - this.group.position.z) * Math.min(1, dt * moveSpeed);

                const vx = (this.group.position.x - prevX) / Math.max(dt, 0.001);
                const vz = (this.group.position.z - prevZ) / Math.max(dt, 0.001);
                const speed = Math.hypot(vx, vz);

                // Highlight ring for currently controlled Red Team athlete
                const isControlled = this.team === 'red' && state.controlledRedIdx === this.id;
                this.activeRing.material.opacity = isControlled ? (0.45 + Math.sin(elapsed * 6) * 0.18) : 0.0;
                this.activeRing.rotation.z = elapsed * 1.2;

                // Natural Blinking Eyelids
                this.blinkTimer -= dt;
                if (this.blinkTimer <= 0) {
                    const blinking = this.blinkTimer > -0.12;
                    this.leftEyeRig.eyelid.visible = blinking;
                    this.rightEyeRig.eyelid.visible = blinking;
                    if (!blinking) this.blinkTimer = 2.4 + Math.random() * 3.2;
                }

                // Dynamic Pupil Tracking toward the ball
                const dx = ballPos.x - this.group.position.x;
                const dz = ballPos.z - this.group.position.z;
                const pupilShiftX = THREE.MathUtils.clamp(dx * 0.004, -0.018, 0.018);
                const pupilShiftY = THREE.MathUtils.clamp((ballPos.y - 1.3) * 0.006, -0.015, 0.018);
                this.leftEyeRig.pupil.position.x = pupilShiftX;
                this.leftEyeRig.pupil.position.y = pupilShiftY;
                this.rightEyeRig.pupil.position.x = pupilShiftX;
                this.rightEyeRig.pupil.position.y = pupilShiftY;

                // Ponytail Physics Sway
                if (this.ponytailPivot) {
                    this.ponytailPivot.rotation.z = THREE.MathUtils.clamp(-vx * 0.06, -0.45, 0.45);
                    this.ponytailPivot.rotation.x = THREE.MathUtils.clamp(speed * 0.04, 0, 0.35);
                }

                // Post-Point Celebration / Emote Animations
                if (this.emoteTimer > 0) {
                    this.emoteTimer -= dt;
                    if (this.emoteState === 'fistpump') {
                        const jump = Math.abs(Math.sin(elapsed * 11)) * 0.34;
                        this.bodyRoot.position.y = jump;
                        this.leftShoulder.rotation.x = -Math.PI * 0.82;
                        this.leftElbow.rotation.x = -0.5;
                        this.racketPivot.rotation.z = -0.8 + Math.sin(elapsed * 16) * 0.25;
                    } else if (this.emoteState === 'twirl') {
                        this.bodyRoot.rotation.y = (1.75 - this.emoteTimer) * Math.PI * 2.2;
                        this.racketGroup.rotation.z = elapsed * 18;
                    } else if (this.emoteState === 'slump') {
                        this.spineGroup.rotation.x = this.zSide * 0.28;
                        this.headGroup.rotation.x = this.zSide * 0.25;
                    }
                    if (this.emoteTimer <= 0) {
                        this.emoteState = 'none';
                        this.bodyRoot.rotation.y = 0;
                        this.racketGroup.rotation.z = 0;
                        this.spineGroup.rotation.x = 0;
                        this.headGroup.rotation.x = 0;
                        this.setFacialExpression('neutral');
                    }
                    return;
                }

                // Split-Step Hop Decay
                let splitHopY = 0;
                if (this.splitStepTimer > 0) {
                    this.splitStepTimer -= dt;
                    splitHopY = Math.sin((this.splitStepTimer / 0.26) * Math.PI) * 0.18;
                }

                // Jump Smash Elevation Decay
                if (this.jumpHeight > 0) {
                    this.jumpHeight = Math.max(0, this.jumpHeight - dt * 1.4);
                }

                // Articulated Hip, Knee & Footwork Stride
                if (speed > 0.35) {
                    const phase = elapsed * 17;
                    const stride = Math.sin(phase) * Math.min(speed * 0.095, 0.55);
                    this.leftLegRig.hipGroup.rotation.x = stride;
                    this.rightLegRig.hipGroup.rotation.x = -stride;
                    this.leftLegRig.kneeGroup.rotation.x = Math.max(0, -stride * 0.85) * this.zSide;
                    this.rightLegRig.kneeGroup.rotation.x = Math.max(0, stride * 0.85) * this.zSide;
                    this.bodyRoot.position.y = Math.abs(Math.cos(phase)) * 0.10 + splitHopY + this.jumpHeight;
                } else {
                    const idleKnee = this.splitStepTimer > 0 ? 0.25 : 0.08;
                    this.leftLegRig.hipGroup.rotation.x = THREE.MathUtils.lerp(this.leftLegRig.hipGroup.rotation.x, -idleKnee * this.zSide, dt * 10);
                    this.rightLegRig.hipGroup.rotation.x = THREE.MathUtils.lerp(this.rightLegRig.hipGroup.rotation.x, -idleKnee * this.zSide, dt * 10);
                    this.leftLegRig.kneeGroup.rotation.x = THREE.MathUtils.lerp(this.leftLegRig.kneeGroup.rotation.x, idleKnee * 1.4 * this.zSide, dt * 10);
                    this.rightLegRig.kneeGroup.rotation.x = THREE.MathUtils.lerp(this.rightLegRig.kneeGroup.rotation.x, idleKnee * 1.4 * this.zSide, dt * 10);
                    this.bodyRoot.position.y = Math.abs(Math.sin(elapsed * 3.8 + this.id)) * 0.032 + splitHopY + this.jumpHeight;
                }

                this.bodyRoot.rotation.z = THREE.MathUtils.lerp(this.bodyRoot.rotation.z, -vx * 0.028, dt * 10);

                // Automatic Unit-Turn Shoulder Coil Preparation when ball is incoming
                const isBallIncoming = (this.team === 'red' && state.hittingTeam === 'blue') ||
                                       (this.team === 'blue' && state.hittingTeam === 'red');
                if (state.phase === 'RALLY' && isBallIncoming && !this.isSwinging) {
                    const relBallX = (ballPos.x - this.group.position.x) * this.zSide;
                    const desiredCoil = relBallX >= -0.15 ? -0.48 : 0.52;
                    this.prepCoil = THREE.MathUtils.lerp(this.prepCoil, desiredCoil, dt * 8);
                } else if (!this.isSwinging) {
                    this.prepCoil = THREE.MathUtils.lerp(this.prepCoil, 0, dt * 8);
                }

                // Head Tracking Ball
                this.headGroup.rotation.y = THREE.MathUtils.clamp(Math.atan2(dx, Math.abs(dz)) * 0.48 - this.prepCoil * 0.4, -0.6, 0.6);

                // Left Arm Serve Ball-Toss Animation vs Balance Arm
                const isServingToss = (state.phase === 'SERVE_TOSS' && state.serverIndex === this.id);
                if (isServingToss) {
                    this.leftShoulder.rotation.x = THREE.MathUtils.lerp(this.leftShoulder.rotation.x, -this.zSide * 1.45, dt * 10);
                    this.leftElbow.rotation.x = THREE.MathUtils.lerp(this.leftElbow.rotation.x, -this.zSide * 0.35, dt * 10);
                } else {
                    this.leftShoulder.rotation.x = THREE.MathUtils.lerp(this.leftShoulder.rotation.x, -this.zSide * 0.25, dt * 8);
                    this.leftShoulder.rotation.z = THREE.MathUtils.lerp(this.leftShoulder.rotation.z, 0.22 + this.prepCoil * 0.3, dt * 8);
                    this.leftElbow.rotation.x = THREE.MathUtils.lerp(this.leftElbow.rotation.x, -this.zSide * 0.45, dt * 8);
                }

                // Full Articulated Racket Swing & Unit-Turn Follow-Through Kinematics
                if (this.isSwinging) {
                    this.swingProgress += dt * 4.6;
                    const p = Math.min(1, this.swingProgress);
                    const arc = Math.sin(p * Math.PI);

                    if (this.swingSide === 0) {
                        // Jumping Overhead Smash / Serve Kinetic Chain
                        this.spineGroup.rotation.y = (0.5 - p) * 0.85;
                        this.spineGroup.rotation.x = -this.zSide * (p - 0.3) * 0.35;
                        this.racketPivot.position.set(0.36, 0.72 + arc * 0.42, -this.zSide * arc * 0.48);
                        this.racketPivot.rotation.set(-this.zSide * (p * 2.45 - 0.7), 0, -0.15);
                    } else {
                        // Forehand / Backhand Whip with Torso Uncoiling & Lunge Stretch
                        const s = this.swingSide;
                        this.spineGroup.rotation.y = s * (0.55 - p * 1.25);
                        this.spineGroup.rotation.x = -this.zSide * this.lungeFactor * 0.28 * arc;

                        this.racketPivot.position.set(
                            s * (0.42 + this.lungeFactor * 0.18 * arc),
                            0.46 + p * 0.26,
                            -this.zSide * arc * 0.58
                        );
                        this.racketPivot.rotation.z = -s * (0.38 + arc * 0.68);
                        this.racketPivot.rotation.y = s * (1.15 - p * 2.3);
                        this.racketPivot.rotation.x = -this.zSide * arc * 0.48;
                    }

                    if (this.swingProgress >= 1) {
                        this.isSwinging = false;
                        this.lungeFactor = 0;
                        this.setFacialExpression('neutral');
                    }
                } else {
                    // Ready Split-Step / Unit-Turn Pose
                    this.spineGroup.rotation.y = THREE.MathUtils.lerp(this.spineGroup.rotation.y, this.prepCoil, dt * 10);
                    this.spineGroup.rotation.x = THREE.MathUtils.lerp(this.spineGroup.rotation.x, 0, dt * 10);

                    this.racketPivot.position.x = THREE.MathUtils.lerp(this.racketPivot.position.x, 0.38 - this.prepCoil * 0.18, dt * 10);
                    this.racketPivot.position.y = THREE.MathUtils.lerp(this.racketPivot.position.y, 0.46, dt * 10);
                    this.racketPivot.position.z = THREE.MathUtils.lerp(this.racketPivot.position.z, -this.zSide * 0.18, dt * 10);

                    this.racketPivot.rotation.z = THREE.MathUtils.lerp(this.racketPivot.rotation.z, -0.35, dt * 10);
                    this.racketPivot.rotation.x = THREE.MathUtils.lerp(this.racketPivot.rotation.x, -this.zSide * 0.25, dt * 10);
                    this.racketPivot.rotation.y = THREE.MathUtils.lerp(this.racketPivot.rotation.y, 0.2 + this.prepCoil * 0.6, dt * 10);
                }
            }
        }

