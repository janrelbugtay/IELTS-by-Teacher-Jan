        // Player Input Swing (Handles Serve Toss, Serve Smash, Super Shot, and Timing-Based Groundstrokes/Volleys)
        function executeUserSwing(shotStyle = 'topspin') {
            if (state.phase === 'POINT_OVER' || state.phase === 'REPLAY') return;
            sound.init();

            const server = athletes[state.serverIndex];

            // 1. SERVE TOSS
            if (state.phase === 'SERVE_WAIT' && server.team === 'red') {
                state.phase = 'SERVE_TOSS';
                ball.vel.set(0, 7.5, 0);
                updateActionPrompt('HIT SERVE');
                return;
            }

            // 2. SERVE STRIKE AT APEX
            if (state.phase === 'SERVE_TOSS' && server.team === 'red') {
                server.triggerSwing(ball.pos);
                triggerTeamSplitStep('blue');
                document.getElementById('server-badge').style.opacity = '0';

                // Timing quality based on toss height near apex (y ~ 2.4m)
                const apexError = Math.abs(ball.pos.y - 2.35);
                const isSweet = apexError < 0.48;
                const timingVal = ball.vel.y > 0.5 ? 0.22 : (isSweet ? 0.50 : 0.80);
                updateTimingNeedle(timingVal);
                updateEraSuperUI(isSweet ? 22 : 12);

                const targetX = -state.serveSide * (1.7 + Math.random() * 1.6);
                const targetZ = -(COURT.serviceLine - 1.1);
                const flightTime = isSweet ? 0.65 : 0.78;

                sound.playRacketHit(isSweet ? 'sweet' : 'normal', true);
                ball.launchToTarget(targetX, targetZ, flightTime, 4.5, 0, isSweet ? 0xfacc15 : 0xfef08a);
                spawnWorldCallout(isSweet ? 'ERA ACE SERVE!' : 'SERVE', server.group.position, isSweet ? '#4ade80' : '#facc15');

                state.phase = 'RALLY';
                state.hittingTeam = 'red';
                state.bounceCount = 0;
                state.rallyCount = 1;
                updateActionPrompt('TIMING SWING');
                return;
            }

            // 3. RALLY TIMING-BASED SHOT (Either Red Net Partner Volley or Red Baseline Groundstroke)
            if (state.phase === 'RALLY' && state.hittingTeam === 'blue') {
                let hitter = athletes[state.controlledRedIdx];
                if (state.isDoubles && state.autoSwitchRed) {
                    const d0 = athletes[0].group.position.distanceTo(ball.pos);
                    const d2 = athletes[2].group.position.distanceTo(ball.pos);
                    if (d2 < d0 && ball.pos.z < 7.2) {
                        hitter = athletes[2];
                        state.controlledRedIdx = 2;
                    } else {
                        hitter = athletes[0];
                        state.controlledRedIdx = 0;
                    }
                }

                const dist = hitter.group.position.distanceTo(ball.pos);
                if (ball.pos.z > -1.2 && dist < 5.0) {
                    const isNetVolley = hitter.id === 2 && ball.pos.z < 6.8;
                    hitter.triggerSwing(ball.pos, isNetVolley);
                    triggerTeamSplitStep('blue');

                    // Calculate Early (Cross) / Sweet Spot / Late (Line) based on Z offset relative to hitter
                    const zDelta = ball.pos.z - (hitter.group.position.z - 0.65);
                    const normTiming = THREE.MathUtils.clamp(0.5 + zDelta * 0.35, 0.08, 0.92);
                    updateTimingNeedle(normTiming);

                    const courtLimitW = state.isDoubles ? COURT.doublesWidth * 0.42 : COURT.singlesWidth * 0.42;
                    const hitterSideSign = hitter.group.position.x >= 0 ? 1 : -1;

                    let targetX = 0;
                    let targetZ = -(COURT.halfLength - 1.8);
                    let flightTime = isNetVolley ? 0.60 : 0.78;
                    let topspin = 5.5;
                    let sidespin = 0;
                    let trailHex = 0xfef08a;
                    let callText = isNetVolley ? 'REFLEX VOLLEY!' : 'SWEET SPOT!';
                    let callColor = '#4ade80';

                    if (normTiming < 0.36) {
                        // EARLY -> Sharp Cross-Court Angle!
                        targetX = -hitterSideSign * courtLimitW * (0.78 + Math.random() * 0.18);
                        flightTime = isNetVolley ? 0.58 : 0.75;
                        callText = isNetVolley ? 'CROSS VOLLEY!' : 'EARLY (Cross)';
                        callColor = '#60a5fa';
                        trailHex = 0x60a5fa;
                        updateEraSuperUI(14);
                    } else if (normTiming > 0.64) {
                        // LATE -> Down the Line!
                        targetX = hitterSideSign * courtLimitW * (0.70 + Math.random() * 0.18);
                        flightTime = isNetVolley ? 0.60 : 0.77;
                        callText = isNetVolley ? 'LINE VOLLEY!' : 'LATE (Line)';
                        callColor = '#fb923c';
                        trailHex = 0xfb923c;
                        updateEraSuperUI(14);
                    } else {
                        // SWEET SPOT -> Blistering Power Winner away from Blue Baseline!
                        const openDir = athletes[1].group.position.x > 0 ? -1 : 1;
                        targetX = openDir * courtLimitW * 0.84;
                        flightTime = isNetVolley ? 0.52 : 0.61;
                        topspin = 7.8;
                        callText = isNetVolley ? 'SWEET VOLLEY!' : 'SWEET SPOT!';
                        callColor = '#4ade80';
                        trailHex = 0xfacc15;
                        updateEraSuperUI(25);
                    }

                    // Apply Shot Style Modifiers (Super Shot, Lob, Drop Shot, Slice)
                    if (shotStyle === 'super' && state.eraCharge >= 100) {
                        updateEraSuperUI(-100);
                        const openDir = athletes[1].group.position.x > 0 ? -1 : 1;
                        targetX = openDir * courtLimitW * 0.88;
                        targetZ = -(COURT.halfLength - 1.2);
                        flightTime = 0.44;
                        topspin = 11.5;
                        sidespin = -openDir * 3.8;
                        trailHex = 0x22d3ee;
                        callText = '⚡ ERA SUPER SHOT!';
                        callColor = '#22d3ee';
                        spawnChalkBurst(hitter.group.position.x, hitter.group.position.z, 18);
                    } else if (shotStyle === 'lob') {
                        flightTime = 1.32;
                        topspin = 1.8;
                        targetZ = -(COURT.halfLength - 1.0);
                        callText = 'MOON LOB!';
                        callColor = '#c084fc';
                    } else if (shotStyle === 'slice') {
                        flightTime = 0.90;
                        topspin = -3.8;
                        sidespin = hitterSideSign * 2.4;
                        targetZ = -(COURT.serviceLine - 1.6); // Drop-slice short ball
                        callText = 'CARVE DROP SLICE!';
                        callColor = '#38bdf8';
                    }

                    const isSmash = (ball.pos.y > 2.02 && shotStyle !== 'lob') || shotStyle === 'super';
                    if (ball.pos.y > 2.02 && shotStyle !== 'lob' && shotStyle !== 'super') {
                        flightTime = 0.48;
                        topspin = 9.0;
                        callText = 'JUMP OVERHEAD SMASH!';
                        callColor = '#facc15';
                    }

                    sound.playRacketHit(normTiming >= 0.36 && normTiming <= 0.64 ? 'sweet' : 'normal', isSmash);
                    ball.launchToTarget(targetX, targetZ, flightTime, topspin, sidespin, trailHex);
                    spawnWorldCallout(callText, hitter.group.position, callColor);

                    state.hittingTeam = 'red';
                    state.bounceCount = 0;
                    state.rallyCount++;
                } else {
                    hitter.triggerSwing(ball.pos);
                }
            }
        }

        function evaluateBounceRules(bx, bz) {
            state.bounceCount++;
            // If Red hit the ball last, it must land on Blue side (bz < 0)
            const expectedSide = state.hittingTeam === 'red' ? -1 : 1;
            const actualSide = bz < 0 ? -1 : 1;

            const maxW = (state.isDoubles ? COURT.doublesWidth : COURT.singlesWidth) / 2 + 0.25;
            const maxL = COURT.halfLength + 0.28;

            if (state.bounceCount === 1) {
                if (actualSide !== expectedSide || Math.abs(bx) > maxW || Math.abs(bz) > maxL) {
                    const winner = state.hittingTeam === 'red' ? 'blue' : 'red';
                    finishPoint(winner, 'OUT!');
                }
            } else if (state.bounceCount >= 2) {
                const winner = state.hittingTeam === 'red' ? 'red' : 'blue';
                finishPoint(winner, 'WINNER!');
            }
        }

        // --- AI TEAM & PARTNER MOVEMENT + AUTO-ASSIST ---
        let aiServeDelay = 0;

        function updateAllAthletesAI(dt) {
            // 1. Blue AI Serve when it is Blue's turn to serve
            const server = athletes[state.serverIndex];
            if (state.phase === 'SERVE_WAIT' && server.team === 'blue') {
                aiServeDelay += dt;
                if (aiServeDelay > 1.15) {
                    state.phase = 'SERVE_TOSS';
                    ball.vel.set(0, 7.3, 0);
                    aiServeDelay = 0;
                }
                return;
            }

            if (state.phase === 'SERVE_TOSS' && server.team === 'blue') {
                if (ball.vel.y < 1.0 && ball.pos.y > 1.9) {
                    server.triggerSwing(ball.pos);
                    triggerTeamSplitStep('red');
                    document.getElementById('server-badge').style.opacity = '0';
                    sound.playRacketHit('sweet', true);

                    const tx = state.serveSide * (1.8 + Math.random() * 1.5);
                    const tz = COURT.serviceLine - 1.1;
                    ball.launchToTarget(tx, tz, 0.74, 4.2, 0, 0x60a5fa);

                    state.phase = 'RALLY';
                    state.hittingTeam = 'blue';
                    state.bounceCount = 0;
                    state.rallyCount = 1;
                    updateActionPrompt('TIMING SWING');
                }
                return;
            }

            if (state.phase !== 'RALLY') return;

            // 2. Red Team Movement (Baseline Player + Net Partner with Poaching & Formation)
            let manualX = 0;
            let manualZ = 0;
            if (state.keys['KeyA'] || state.keys['ArrowLeft']) manualX -= 1;
            if (state.keys['KeyD'] || state.keys['ArrowRight']) manualX += 1;
            if (state.keys['KeyW'] || state.keys['ArrowUp']) manualZ -= 1;
            if (state.keys['KeyS'] || state.keys['ArrowDown']) manualZ += 1;

            if (state.hittingTeam === 'blue') {
                // Ball is coming toward Red Court (+Z)
                const netInterceptable = state.isDoubles && ball.pos.z > 0.2 && ball.pos.z < 6.4 &&
                    Math.abs(ball.pos.x - athletes[2].group.position.x) < 3.1;

                if (state.autoSwitchRed) {
                    state.controlledRedIdx = netInterceptable ? 2 : 0;
                }

                if (state.controlledRedIdx === 2 && state.isDoubles) {
                    athletes[2].targetX = THREE.MathUtils.clamp(ball.pos.x + manualX * 2.6, -6.2, 6.2);
                    athletes[2].targetZ = THREE.MathUtils.clamp(athletes[2].homeZ + manualZ * 1.8, 2.2, 7.2);
                    athletes[0].targetX = THREE.MathUtils.clamp(ball.pos.x * 0.75, -6.2, 6.2);
                    athletes[0].targetZ = 11.4;
                } else {
                    athletes[0].targetX = THREE.MathUtils.clamp(ball.pos.x + manualX * 2.5, -6.5, 6.5);
                    athletes[0].targetZ = ball.pos.z > 2.5
                        ? THREE.MathUtils.clamp(ball.pos.z + 1.0 + manualZ * 1.5, 5.2, 13.5)
                        : 11.5;

                    if (state.isDoubles) {
                        const poachInfluence = state.doublesTactic === 'Net Rush' ? 0.65 : 0.42;
                        athletes[2].targetX = THREE.MathUtils.clamp(
                            athletes[2].homeX * (1 - poachInfluence) + ball.pos.x * poachInfluence,
                            -5.2, 5.2
                        );
                        athletes[2].targetZ = state.doublesTactic === 'Net Rush' ? 3.2 : 4.2;
                    }
                }

                // Live Timing Bar Preview Needle while ball approaches Red Player
                if (ball.pos.z > 0) {
                    const activeRed = athletes[state.controlledRedIdx];
                    const previewNorm = THREE.MathUtils.clamp(0.5 + (ball.pos.z - (activeRed.group.position.z - 0.65)) * 0.18, 0.05, 0.95);
                    updateTimingNeedle(previewNorm);
                }
            } else {
                // Recover toward home positions after hitting
                athletes[0].targetX = athletes[0].homeX * 0.35 + manualX * 3.0;
                athletes[0].targetZ = state.doublesTactic === 'Net Rush' ? 6.8 : 11.6;
                if (state.isDoubles) {
                    athletes[2].targetX = athletes[2].homeX * 0.70 + manualX * 2.0;
                    athletes[2].targetZ = state.doublesTactic === 'Net Rush' ? 3.2 : 4.2;
                }
            }

            // 3. Blue AI Team Movement & Shot Return (Far Court -Z)
            if (state.hittingTeam === 'red') {
                // Blue Net Partner checks if they can intercept a volley at the net
                if (state.isDoubles) {
                    athletes[3].targetX = THREE.MathUtils.clamp(athletes[3].homeX * 0.55 + ball.pos.x * 0.45, -5.2, 5.2);
                    athletes[3].targetZ = -4.6;

                    const netDistX = Math.abs(athletes[3].group.position.x - ball.pos.x);
                    const netDistZ = Math.abs(athletes[3].group.position.z - ball.pos.z);
                    if (ball.pos.z < -2.0 && ball.pos.z > -6.2 && netDistX < 1.85 && netDistZ < 1.7 && ball.pos.y < 2.2) {
                        athletes[3].triggerSwing(ball.pos, true);
                        triggerTeamSplitStep('red');
                        sound.playRacketHit('sweet', false);
                        const aimX = (Math.random() - 0.5) * 8.5;
                        ball.launchToTarget(aimX, 9.2, 0.68, 4.0, 0, 0x60a5fa);
                        spawnWorldCallout('NET VOLLEY!', athletes[3].group.position, '#60a5fa');
                        state.hittingTeam = 'blue';
                        state.bounceCount = 0;
                        state.rallyCount++;
                        return;
                    }
                }

                // Blue Baseline AI tracks ball
                athletes[1].targetX = THREE.MathUtils.clamp(ball.pos.x, -6.5, 6.5);
                athletes[1].targetZ = ball.pos.z < -2.5
                    ? THREE.MathUtils.clamp(ball.pos.z - 0.6, -13.5, -4.5)
                    : -11.5;

                const baseDistX = Math.abs(athletes[1].group.position.x - ball.pos.x);
                const baseDistZ = Math.abs(athletes[1].group.position.z - ball.pos.z);
                if (ball.pos.z < -2.0 && baseDistX < 2.35 && baseDistZ < 2.25 && ball.pos.y < 2.5) {
                    athletes[1].triggerSwing(ball.pos, false);
                    triggerTeamSplitStep('red');
                    sound.playRacketHit('normal', false);

                    const courtLimit = (state.isDoubles ? COURT.doublesWidth : COURT.singlesWidth) * 0.38;
                    const aimX = THREE.MathUtils.clamp((athletes[0].group.position.x > 0 ? -1 : 1) * courtLimit * (0.5 + Math.random() * 0.45), -courtLimit, courtLimit);
                    const aimZ = 10.2 + Math.random() * 1.5;
                    ball.launchToTarget(aimX, aimZ, 0.80, 5.5, 0, 0x60a5fa);

                    state.hittingTeam = 'blue';
                    state.bounceCount = 0;
                    state.rallyCount++;
                }
            } else {
                // Blue Team recovers to ready positions
                athletes[1].targetX = ball.pos.x * 0.25;
                athletes[1].targetZ = -11.6;
                if (state.isDoubles) {
                    athletes[3].targetX = athletes[3].homeX * 0.75;
                    athletes[3].targetZ = -4.8;
                }
            }
        }

        // --- POINT SCORING, CHARACTER CELEBRATION EMOTES & SCOREBOARD UPDATES ---
        const SCORE_STRINGS = ['00', '15', '30', '40'];

        function finishPoint(winningTeam, reasonLabel) {
            if (state.phase === 'POINT_OVER') return;
            state.phase = 'POINT_OVER';

            const redWon = winningTeam === 'red';
            sound.playCrowdApplause(redWon);
            spawnWorldCallout(`${reasonLabel} (${redWon ? 'RED POINT' : 'BLUE POINT'})`, ball.pos, redWon ? '#4ade80' : '#60a5fa');

            // Trigger Character Emotes (Fist pump & racket twirl for winners, slump for losers)
            athletes.forEach((a, idx) => {
                if (a.team === winningTeam) {
                    a.triggerEmote(idx % 2 === 0 ? 'fistpump' : 'twirl');
                } else {
                    a.triggerEmote('slump');
                }
            });

            if (redWon) state.redPoints++;
            else state.bluePoints++;

            let gameWinner = null;
            if (state.redPoints >= 4 && state.redPoints - state.bluePoints >= 2) gameWinner = 'red';
            else if (state.bluePoints >= 4 && state.bluePoints - state.redPoints >= 2) gameWinner = 'blue';

            if (gameWinner) {
                if (gameWinner === 'red') state.redGames++;
                else state.blueGames++;
                state.redPoints = 0;
                state.bluePoints = 0;
                state.serverIndex = state.serverIndex === 0 ? 1 : 0;
                state.serveSide = 1;
                sound.announce(gameWinner === 'red' ? 'Game, Red Team on Era Tennis Court!' : 'Game, Blue Team on Era Tennis Court!');
            } else {
                state.serveSide *= -1;
            }

            refreshScoreboardHUD();

            setTimeout(() => {
                if (state.phase !== 'REPLAY') {
                    setupPlayersForServe();
                }
            }, 2100);
        }

        function refreshScoreboardHUD() {
            const r = state.redPoints;
            const b = state.bluePoints;
            const rEl = document.getElementById('hud-score-red');
            const bEl = document.getElementById('hud-score-blue');

            if (r >= 3 && b >= 3) {
                if (r === b) {
                    rEl.textContent = '40';
                    bEl.textContent = '40';
                } else if (r > b) {
                    rEl.textContent = 'AD';
                    bEl.textContent = '40';
                } else {
                    rEl.textContent = '40';
                    bEl.textContent = 'AD';
                }
            } else {
                rEl.textContent = SCORE_STRINGS[Math.min(r, 3)];
                bEl.textContent = SCORE_STRINGS[Math.min(b, 3)];
            }

            document.getElementById('red-games-count').textContent = state.redGames;
            document.getElementById('blue-games-count').textContent = state.blueGames;

            document.getElementById('red-game-dot-1').className = `w-3.5 h-3.5 rounded-full border border-white/40 ${state.redGames >= 1 ? 'bg-red-500 shadow-[0_0_8px_#ef4444]' : 'bg-white/10'}`;
            document.getElementById('red-game-dot-2').className = `w-3.5 h-3.5 rounded-full border border-white/40 ${state.redGames >= 2 ? 'bg-red-500 shadow-[0_0_8px_#ef4444]' : 'bg-white/10'}`;
            document.getElementById('blue-game-dot-1').className = `w-3.5 h-3.5 rounded-full border border-white/40 ${state.blueGames >= 1 ? 'bg-blue-500 shadow-[0_0_8px_#3b82f6]' : 'bg-white/10'}`;
            document.getElementById('blue-game-dot-2').className = `w-3.5 h-3.5 rounded-full border border-white/40 ${state.blueGames >= 2 ? 'bg-blue-500 shadow-[0_0_8px_#3b82f6]' : 'bg-white/10'}`;
        }

        /***********************************************************************
         * 7. INSTANT REPLAY SYSTEM, CAMERA MODES & UI CONTROLS
         ***********************************************************************/
        function recordReplaySnapshot() {
            if (state.phase !== 'RALLY' && state.phase !== 'SERVE_TOSS') return;
            state.replayFrames.push({
                ballPos: ball.pos.clone(),
                athletesPos: athletes.map(a => ({
                    x: a.group.position.x,
                    z: a.group.position.z,
                    swing: a.isSwinging,
                    swingProg: a.swingProgress
                }))
            });
            if (state.replayFrames.length > 260) {
                state.replayFrames.shift();
            }
        }

        function triggerInstantReplay() {
            if (state.replayFrames.length < 15) {
                spawnWorldCallout('PLAY A RALLY FIRST!', athletes[0].group.position, '#facc15');
                return;
            }
            state.phase = 'REPLAY';
            state.replayPlaybackIdx = 0;
            document.getElementById('match-status-text').textContent = '🎥 INSTANT SLOW-MO REPLAY';
            document.getElementById('server-badge').style.opacity = '0';
        }

        function updateReplayPlayback() {
            if (state.phase !== 'REPLAY') return;
            const idx = Math.floor(state.replayPlaybackIdx);
            if (idx >= state.replayFrames.length) {
                document.getElementById('match-status-text').textContent = 'ERA TENNIS COURT • UPWARD FLICK / CLICK OR SPACE TO SERVE';
                setupPlayersForServe();
                return;
            }
            const frame = state.replayFrames[idx];
            ball.pos.copy(frame.ballPos);
            ball.shadowMesh.position.set(ball.pos.x, 0.025, ball.pos.z);
            frame.athletesPos.forEach((ap, i) => {
                athletes[i].group.position.x = ap.x;
                athletes[i].group.position.z = ap.z;
            });
            state.replayPlaybackIdx += 0.55; // Smooth slow-motion
        }

        function toggleLyriaAudio() {
            state.lyriaEnabled = !state.lyriaEnabled;
            const dot = document.getElementById('lyria-dot');
            if (state.lyriaEnabled) {
                dot.className = 'w-2.5 h-2.5 rounded-full bg-emerald-400 shadow-[0_0_8px_#34d399]';
                sound.init();
            } else {
                dot.className = 'w-2.5 h-2.5 rounded-full bg-slate-500';
            }
        }

        function cycleCameraMode() {
            const modes = ['Rally', 'Broadcast', 'Low', 'Flyover'];
            const next = (modes.indexOf(state.cameraMode) + 1) % modes.length;
            state.cameraMode = modes[next];
            document.getElementById('cam-label').textContent = state.cameraMode;
        }

        function toggleDoublesMode() {
            state.isDoubles = !state.isDoubles;
            document.getElementById('mode-label').textContent = state.isDoubles ? '2v2 Doubles' : '1v1 Singles';
            document.getElementById('avatar-red-2').classList.toggle('hidden', !state.isDoubles);
            document.getElementById('avatar-blue-2').classList.toggle('hidden', !state.isDoubles);
            setupPlayersForServe();
        }

        // --- WEBCAM MOTION TRACKER ---
        let camStream = null;
        let prevCamFrame = null;
        let lastCamSwing = 0;

        async function toggleWebcam() {
            const pip = document.getElementById('webcam-pip');
            const dot = document.getElementById('webcam-dot');
            const video = document.getElementById('webcam-video');

            if (state.webcamEnabled) {
                state.webcamEnabled = false;
                pip.classList.add('hidden');
                dot.className = 'w-2 h-2 rounded-full bg-slate-400';
                if (camStream) {
                    camStream.getTracks().forEach(t => t.stop());
                    camStream = null;
                }
                return;
            }

            try {
                camStream = await navigator.mediaDevices.getUserMedia({
                    video: { width: 160, height: 120, facingMode: 'user' },
                    audio: false
                });
                video.srcObject = camStream;
                state.webcamEnabled = true;
                pip.classList.remove('hidden');
                dot.className = 'w-2 h-2 rounded-full bg-emerald-400 animate-ping';
            } catch (e) {
                spawnWorldCallout('WEBCAM PERMISSION DENIED', athletes[0].group.position, '#f87171');
            }
        }

        function processWebcamFrame() {
            if (!state.webcamEnabled) return;
            const video = document.getElementById('webcam-video');
            const cCanvas = document.getElementById('webcam-canvas');
            if (video.readyState < 2) return;

            const ctx = cCanvas.getContext('2d', { willReadFrequently: true });
            const w = cCanvas.width;
            const h = cCanvas.height;

            ctx.save();
            ctx.scale(-1, 1);
            ctx.drawImage(video, -w, 0, w, h);
            ctx.restore();

            const frame = ctx.getImageData(0, 0, w, h);
            const data = frame.data;

            if (prevCamFrame) {
                let sx = 0, sy = 0, count = 0;
                for (let y = 0; y < h; y += 2) {
                    for (let x = 0; x < w; x += 2) {
                        const i = (y * w + x) * 4;
                        const diff = Math.abs(data[i] - prevCamFrame[i]) +
                                     Math.abs(data[i + 1] - prevCamFrame[i + 1]) +
                                     Math.abs(data[i + 2] - prevCamFrame[i + 2]);
                        if (diff > 75) {
                            sx += x; sy += y; count++;
                            data[i] = 52; data[i + 1] = 211; data[i + 2] = 153;
                        }
                    }
                }
                ctx.putImageData(frame, 0, 0);

                if (count > 25) {
                    const cx = (sx / count) / w;
                    const cy = (sy / count) / h;
                    const marker = document.getElementById('webcam-marker');
                    marker.style.left = `${cx * 100}%`;
                    marker.style.top = `${cy * 100}%`;

                    const now = performance.now();
                    if (count > 165 && now - lastCamSwing > 360) {
                        lastCamSwing = now;
                        document.getElementById('webcam-state-text').textContent = 'SWING!';
                        executeUserSwing('topspin');
                    } else {
                        document.getElementById('webcam-state-text').textContent = 'ACTIVE';
                    }
                }
            }
            prevCamFrame = new Uint8ClampedArray(data);
        }

        // --- MOUSE FLICK & KEYBOARD INPUT LISTENERS ---
        let dragStart = null;

        canvas.addEventListener('pointerdown', (e) => {
            dragStart = { x: e.clientX, y: e.clientY, t: performance.now() };
            if (state.phase === 'SERVE_WAIT' || state.phase === 'SERVE_TOSS') {
                executeUserSwing('topspin');
            }
        });

        window.addEventListener('pointerup', (e) => {
            if (!dragStart) return;
            const dy = e.clientY - dragStart.y;
            const dt = performance.now() - dragStart.t;
            dragStart = null;

            if (state.phase === 'RALLY' && dt < 450) {
                if (state.eraCharge >= 100 && dy < -60) {
                    executeUserSwing('super');
                } else {
                    const style = dy > 45 ? 'slice' : 'topspin';
                    executeUserSwing(style);
                }
            }
        });

        window.addEventListener('keydown', (e) => {
            state.keys[e.code] = true;
            if (e.code === 'Space') {
                e.preventDefault();
                executeUserSwing(state.eraCharge >= 100 && e.shiftKey ? 'super' : 'topspin');
            } else if (e.code === 'KeyQ' || e.code === 'ShiftLeft' || e.code === 'ShiftRight') {
                if (state.eraCharge >= 100) executeUserSwing('super');
                else executeUserSwing('topspin');
            } else if (e.code === 'KeyJ') {
                executeUserSwing('topspin');
            } else if (e.code === 'KeyK') {
                executeUserSwing('slice');
            } else if (e.code === 'KeyL') {
                executeUserSwing('lob');
            } else if (e.code === 'KeyE' || e.code === 'Tab') {
                e.preventDefault();
                triggerNetPoachOrSwitch();
            } else if (e.code === 'KeyT') {
                cycleDoublesTactic();
            } else if (e.code === 'KeyC') {
                cycleCameraMode();
            } else if (e.code === 'KeyR') {
                triggerInstantReplay();
            }
        });

        window.addEventListener('keyup', (e) => {
            state.keys[e.code] = false;
        });

        /***********************************************************************
         * 8. MAIN RENDER, SPECTATOR WAVE & FLOATING SERVER TAG LOOP
         ***********************************************************************/
        function updateFloatingServerBadge(elapsed) {
            const badge = document.getElementById('server-badge');
            if (!badge || state.phase === 'RALLY' || state.phase === 'REPLAY') return;

            const server = athletes[state.serverIndex];
            const worldPos = server.group.position.clone();
            worldPos.y += 2.35 + Math.sin(elapsed * 4.5) * 0.08;

            const proj = worldPos.project(camera);
            const x = (proj.x * 0.5 + 0.5) * window.innerWidth;
            const y = (-proj.y * 0.5 + 0.5) * window.innerHeight;

            badge.style.left = `${x}px`;
            badge.style.top = `${y}px`;
        }

        function updateCameraView(dt, elapsed) {
            const targetPos = new THREE.Vector3();
            const lookTarget = new THREE.Vector3();

            if (state.phase === 'REPLAY') {
                // Dramatic Orbiting Replay Camera
                targetPos.set(Math.sin(elapsed * 0.65) * 16, 8.5, Math.cos(elapsed * 0.65) * 18);
                lookTarget.copy(ball.pos);
            } else if (state.cameraMode === 'Rally') {
                // Exact Camera Framing from Reference Screenshot
                targetPos.set(athletes[0].group.position.x * 0.16, 12.6, 23.6);
                lookTarget.set(ball.pos.x * 0.15, 0.5, -1.2);
            } else if (state.cameraMode === 'Broadcast') {
                targetPos.set(0, 15.5, 26.8);
                lookTarget.set(0, 0.2, -1.5);
            } else if (state.cameraMode === 'Low') {
                targetPos.set(athletes[0].group.position.x * 0.55, 4.6, athletes[0].group.position.z + 6.8);
                lookTarget.set(ball.pos.x * 0.35, 1.0, ball.pos.z * 0.3 - 3.0);
            } else if (state.cameraMode === 'Flyover') {
                // Center Court Flyover Drone Orbit
                targetPos.set(Math.sin(elapsed * 0.35) * 24, 15.0, Math.cos(elapsed * 0.35) * 24);
                lookTarget.set(0, 1.0, 0);
            }

            camera.position.lerp(targetPos, Math.min(1, dt * 5.5));
            camera.lookAt(lookTarget);
        }

        let prevTime = performance.now();

        function animate(now) {
            requestAnimationFrame(animate);
            const dt = Math.min((now - prevTime) / 1000, 0.05);
            prevTime = now;
            const elapsed = now * 0.001;

            processWebcamFrame();

            if (state.phase === 'REPLAY') {
                updateReplayPlayback();
            } else {
                updateAllAthletesAI(dt);
                ball.update(dt);
                recordReplaySnapshot();
            }

            athletes.forEach(a => a.update(dt, ball.pos, elapsed));
            updatePuffs(dt);

            // Animate 140+ Spectators (Head-turning to follow ball + Cheering on Points)
            const isCheering = state.phase === 'POINT_OVER';
            for (let i = 0; i < spectators.length; i++) {
                const s = spectators[i];
                if (isCheering) {
                    s.position.y = s.userData.baseY + Math.abs(Math.sin(elapsed * 12 + s.userData.phase)) * 0.22;
                } else {
                    s.position.y = s.userData.baseY;
                }
                // Subtle head turn following the tennis ball along Z
                const lookZ = (ball.pos.z - s.position.z) * 0.025 * s.userData.sideSign;
                s.userData.headPivot.rotation.y = THREE.MathUtils.clamp(lookZ, -0.45, 0.45);
            }

            updateCameraView(dt, elapsed);
            updateFloatingServerBadge(elapsed);

            renderer.render(scene, camera);
        }

        window.addEventListener('resize', () => {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        });

        window.onload = function () {
            setupPlayersForServe();
            refreshScoreboardHUD();
            requestAnimationFrame(animate);
        };
    </script>
</body>
</html>