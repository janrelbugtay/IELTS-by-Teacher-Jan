    <script>
        /***********************************************************************
         * ERA TENNIS COURT — ULTRA-SHARP LAKESIDE GRASS STADIUM & ARTICULATED 3D CHARACTERS
         ***********************************************************************/

        // --- COURT DIMENSIONS (Realistic Proportions Matching Screenshot) ---
        const COURT = {
            singlesWidth: 10.5,
            doublesWidth: 13.6,
            length: 25.0,
            halfLength: 12.5,
            serviceLine: 6.4,
            netHeight: 1.0,
            gravity: 19.2
        };

        // --- GAME & MATCH STATE ---
        const state = {
            phase: 'SERVE_WAIT',     // 'SERVE_WAIT', 'SERVE_TOSS', 'RALLY', 'POINT_OVER', 'REPLAY'
            isDoubles: true,         // 2v2 Doubles (4 Players) by default
            serverIndex: 0,          // 0: Red Baseline, 1: Blue Baseline, 2: Red Partner, 3: Blue Partner
            serveSide: 1,            // 1 = Deuce (Right side), -1 = Ad (Left side)
            hittingTeam: 'red',      // 'red' (near court) or 'blue' (far court)
            bounceCount: 0,
            rallyCount: 0,

            // Character Control, Formation & Era Super Charge
            controlledRedIdx: 0,     // 0 = Baseline Red, 2 = Net Partner Red
            autoSwitchRed: true,     // Automatically routes control to best Red athlete
            doublesTactic: 'Classic',// 'Classic', 'I-Formation', 'Net Rush'
            eraCharge: 35,           // 0 to 100% Super Shot meter

            // Scoring
            redPoints: 0,
            bluePoints: 0,
            redGames: 0,
            blueGames: 0,

            // Camera & Audio
            cameraMode: 'Rally',     // 'Rally', 'Broadcast', 'Low', 'Flyover'
            lyriaEnabled: true,
            webcamEnabled: false,

            // Input & Timing
            pointerX: 0,
            pointerY: 0,
            keys: {},
            lastTimingValue: 0.5,    // 0.0 = Early (Cross), 0.5 = Sweet Spot, 1.0 = Late (Line)

            // Instant Replay Circular Buffer
            replayFrames: [],
            replayPlaybackIdx: 0
        };

        /***********************************************************************
         * 1. LYRIA-3 STYLE AMBIENT & ORCHESTRAL SYNTH AUDIO ENGINE
         ***********************************************************************/
        class LyriaAudioSystem {
            constructor() {
                this.ctx = null;
                this.timer = null;
                this.step = 0;
            }

            init() {
                if (!this.ctx) {
                    const AudioCtx = window.AudioContext || window.webkitAudioContext;
                    this.ctx = new AudioCtx();
                }
                if (this.ctx && this.ctx.state === 'suspended') {
                    this.ctx.resume();
                }
                if (state.lyriaEnabled && !this.timer) {
                    this.startAmbientSoundtrack();
                }
            }

            playRacketHit(quality = 'sweet', isSmash = false) {
                if (!state.lyriaEnabled) return;
                this.init();
                const now = this.ctx.currentTime;

                // Crisp string bed thwack
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = quality === 'sweet' ? 'triangle' : 'sine';
                const freq = isSmash ? 195 : (quality === 'sweet' ? 165 : 140);
                osc.frequency.setValueAtTime(freq, now);
                osc.frequency.exponentialRampToValueAtTime(46, now + 0.12);

                gain.gain.setValueAtTime(0.5, now);
                gain.gain.exponentialRampToValueAtTime(0.001, now + 0.13);
                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start(now);
                osc.stop(now + 0.14);

                // Sweet spot crystalline harmonic chime
                if (quality === 'sweet' || isSmash) {
                    const chime = this.ctx.createOscillator();
                    const cGain = this.ctx.createGain();
                    chime.type = 'sine';
                    chime.frequency.setValueAtTime(isSmash ? 1174.66 : 987.77, now);
                    chime.frequency.exponentialRampToValueAtTime(1567.98, now + 0.18);
                    cGain.gain.setValueAtTime(0.14, now);
                    cGain.gain.exponentialRampToValueAtTime(0.001, now + 0.19);
                    chime.connect(cGain);
                    cGain.connect(this.ctx.destination);
                    chime.start(now);
                    chime.stop(now + 0.2);
                }
            }

            playGrassBounce() {
                if (!state.lyriaEnabled) return;
                this.init();
                const now = this.ctx.currentTime;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(175, now);
                osc.frequency.exponentialRampToValueAtTime(52, now + 0.075);
                gain.gain.setValueAtTime(0.24, now);
                gain.gain.exponentialRampToValueAtTime(0.001, now + 0.08);
                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start(now);
                osc.stop(now + 0.085);
            }

            playCrowdApplause(isWin = true) {
                if (!state.lyriaEnabled) return;
                this.init();
                const now = this.ctx.currentTime;

                // Soft stadium applause noise envelope
                const bufferSize = this.ctx.sampleRate * 0.65;
                const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
                const data = buffer.getChannelData(0);
                for (let i = 0; i < bufferSize; i++) {
                    data[i] = (Math.random() * 2 - 1) * Math.sin((i / bufferSize) * Math.PI);
                }
                const noise = this.ctx.createBufferSource();
                noise.buffer = buffer;

                const filter = this.ctx.createBiquadFilter();
                filter.type = 'bandpass';
                filter.frequency.setValueAtTime(850, now);

                const gain = this.ctx.createGain();
                gain.gain.setValueAtTime(0.16, now);
                gain.gain.exponentialRampToValueAtTime(0.005, now + 0.64);
                noise.connect(filter);
                filter.connect(gain);
                gain.connect(this.ctx.destination);
                noise.start(now);

                // Uplifting chord
                const chord = isWin ? [523.25, 659.25, 783.99, 1046.5] : [440, 523.25, 659.25, 587.33];
                chord.forEach((f, idx) => {
                    const o = this.ctx.createOscillator();
                    const g = this.ctx.createGain();
                    o.type = 'triangle';
                    o.frequency.setValueAtTime(f, now + idx * 0.06);
                    g.gain.setValueAtTime(0.1, now + idx * 0.06);
                    g.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.06 + 0.35);
                    o.connect(g);
                    g.connect(this.ctx.destination);
                    o.start(now + idx * 0.06);
                    o.stop(now + idx * 0.06 + 0.36);
                });
            }

            announce(text) {
                if (!state.lyriaEnabled || !('speechSynthesis' in window)) return;
                try {
                    window.speechSynthesis.cancel();
                    const u = new SpeechSynthesisUtterance(text);
                    u.rate = 1.05;
                    u.pitch = 1.0;
                    u.volume = 0.6;
                    window.speechSynthesis.speak(u);
                } catch (e) {}
            }

            startAmbientSoundtrack() {
                if (this.timer) clearInterval(this.timer);
                // Bright sunny lakeside resort progression ("Center Court Flyover")
                const chords = [
                    [261.63, 329.63, 392.00, 493.88], // Cmaj7
                    [293.66, 369.99, 440.00, 523.25], // D7sus
                    [220.00, 261.63, 329.63, 392.00], // Am7
                    [196.00, 246.94, 293.66, 392.00]  // G
                ];
                this.timer = setInterval(() => {
                    if (!state.lyriaEnabled || !this.ctx || this.ctx.state !== 'running') return;
                    const now = this.ctx.currentTime;
                    const chord = chords[Math.floor(this.step / 4) % chords.length];
                    const note = chord[this.step % chord.length];

                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(note * (state.phase === 'RALLY' ? 2 : 1), now);
                    gain.gain.setValueAtTime(0.025, now);
                    gain.gain.exponentialRampToValueAtTime(0.0008, now + 0.28);

                    osc.connect(gain);
                    gain.connect(this.ctx.destination);
                    osc.start(now);
                    osc.stop(now + 0.3);
                    this.step++;
                }, 260);
            }
        }

