            if (state.autoSwitchRed) {
                state.autoSwitchRed = false;
                state.controlledRedIdx = 2; // Lock onto Net Partner
                document.getElementById('control-label').textContent = 'Net Partner';
                spawnWorldCallout('CONTROLLING NET PARTNER!', athletes[2].group.position, '#38bdf8');
            } else if (state.controlledRedIdx === 2) {
