            div.style.left = `${THREE.MathUtils.clamp(x, 70, window.innerWidth - 70)}px`;
            div.style.top = `${THREE.MathUtils.clamp(y, 70, window.innerHeight - 70)}px`;

            container.appendChild(div);
            setTimeout(() => div.remove(), 1050);
        }

