        function createKitBumpTexture() {
            const c = document.createElement('canvas');
            c.width = 128;
            c.height = 128;
            const ctx = c.getContext('2d');
            ctx.fillStyle = '#808080';
            ctx.fillRect(0, 0, 128, 128);
            ctx.fillStyle = '#9c9c9c';
            for (let y = 0; y < 128; y += 4) {
                for (let x = (y % 8 === 0 ? 0 : 2); x < 128; x += 4) {
                    ctx.fillRect(x, y, 2, 2);
                }
            }
            const tex = new THREE.CanvasTexture(c);
            tex.wrapS = tex.wrapT = THREE.RepeatWrapping;
            tex.repeat.set(8, 8);
            return tex;
        }
        const kitBumpTex = createKitBumpTexture();

        function createJerseyNumberTexture(numberStr, bgColorHex, textColor = '#ffffff') {
            const c = document.createElement('canvas');
            c.width = 128;
            c.height = 128;
            const ctx = c.getContext('2d');
            ctx.clearRect(0, 0, 128, 128);
            ctx.font = '900 76px "Outfit", sans-serif';
            ctx.fillStyle = textColor;
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.shadowColor = 'rgba(0,0,0,0.45)';
            ctx.shadowBlur = 4;
            ctx.fillText(numberStr, 64, 68);
            const tex = new THREE.CanvasTexture(c);
            tex.anisotropy = maxAnisotropy;
            return tex;
        }

        class ArticulatedFootballer {
            constructor(config) {
                this.id = config.id;
                this.name = config.name;
                this.number = config.number;
                this.team = config.team;           // 'red' (Era FC, attacks -Z) or 'blue' (Rival FC, attacks +Z)
                this.role = config.role;           // 'gk', 'def', 'fwd'
                this.zSide = this.team === 'red' ? 1 : -1;
                this.isCaptain = !!config.isCaptain;

                // Distinct Kit Colors for Outfield vs Goalkeepers
                if (this.role === 'gk') {
                    this.shirtColor = this.team === 'red' ? 0x10b981 : 0xf59e0b;
                    this.shortsColor = 0x1e293b;
                } else {
                    this.shirtColor = this.team === 'red' ? 0xd92626 : 0x2563eb;
                    this.shortsColor = 0xf8fafc;
                }

                this.hairColor = config.hairColor;
                this.skinColor = config.skinColor;
                this.hairStyle = config.hairStyle; // 'round', 'spiky', 'ponytail'

                this.homeX = config.homeX;
                this.homeZ = config.homeZ;
                this.targetX = config.homeX;
                this.targetZ = config.homeZ;

                this.group = new THREE.Group();
                this.group.position.set(this.homeX, 0, this.homeZ);

                // Kinematics & Action Timers
                this.vel = new THREE.Vector3();
                this.facingAngle = this.team === 'red' ? Math.PI : 0;
                this.stamina = 100;
                this.kickTimer = 0;
                this.slideTimer = 0;
                this.slideDir = new THREE.Vector3();
                this.headerTimer = 0;
                this.diveTimer = 0;
                this.diveDir = 0; // -1 left, +1 right
                this.emoteState = 'none'; // 'none', 'kneeslide', 'slump'
                this.emoteTimer = 0;
                this.blinkTimer = Math.random() * 3;

                this.buildCharacterMesh();
                scene.add(this.group);
