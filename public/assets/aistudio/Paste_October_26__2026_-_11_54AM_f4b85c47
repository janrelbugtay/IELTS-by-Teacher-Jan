    <script>
        /***********************************************************************
         * ERA FOOTBALL CLUB — ULTRA-SHARP LAKESIDE STADIUM & 5v5 3D ENGINE
         ***********************************************************************/

        // --- PITCH & GOAL DIMENSIONS (Arcade Proportions for Crisp 5v5 Flow) ---
        const PITCH = {
            width: 28.0,           // X: -14.0 to +14.0
            length: 44.0,          // Z: -22.0 (North / Rival FC Goal) to +22.0 (South / Era FC Goal)
            halfW: 14.0,
            halfL: 22.0,
            goalWidth: 6.4,        // Goalposts at X = -3.2 and +3.2
            goalHeight: 2.45,
            goalDepth: 2.1,
            penBoxW: 13.6,
            penBoxL: 6.8,
            goalAreaW: 8.2,
            goalAreaL: 2.6,
            gravity: 21.0
        };

        // --- MATCH & GAMEPLAY STATE ---
        const state = {
            phase: 'PLAYING',          // 'PLAYING', 'GOAL_CELEBRATION', 'REPLAY'
            redScore: 0,
            blueScore: 0,
            matchSeconds: 0,           // Accelerated 90-minute match clock
            controlledIdx: 4,          // Default controlled Era FC striker (#10 Leo)
            possessionTeam: 'red',     // 'red' or 'blue'
            holder: null,              // Athlete currently dribbling the ball
            lastTouchTeam: 'red',
            tactic: 'Tiki-Taka',       // 'Balanced', 'Tiki-Taka', 'High Press'
            eraCharge: 40,             // 0..100% Super Strike Bar
            cameraMode: 'Broadcast TV',// 'Broadcast TV', 'End-to-End Pro', 'Sideline Drone'
            audioEnabled: true,
            webcamEnabled: false,
            slowMoFactor: 1.0,
            keys: {},
            pointerWorld: new THREE.Vector3(0, 0, 0),
            pointerActive: false,
            timingOsc: 0.5,
            replayFrames: [],
            replayIdx: 0
        };

        /***********************************************************************
         * 1. PROCEDURAL STADIUM AUDIO, REFEREE WHISTLE & COMMENTATOR ENGINE
         ***********************************************************************/
        class EraFootballAudio {
            constructor() {
                this.ctx = null;
                this. timer = null;
                this.step = 0;
            }

            init() {
                if (!this.ctx) {
                    const AudioCtx = window.AudioContext || window.webkitAudioContext;
                    this.ctx = new AudioCtx();
                }
                if (this.ctx && this.ctx.state === 'suspended') {
                    this.ctx.resume();
                }
                if (state.audioEnabled && !this.timer) {
                    this.startStadiumAnthemLoop();
                }
            }

            playKick(power = 'normal', isSuper = false) {
                if (!state.audioEnabled) return;
                this.init();
                const now = this.ctx.currentTime;

                // Deep leather match-ball thud
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = isSuper ? 'sawtooth' : 'sine';
                const startFreq = isSuper ? 220 : (power === 'hard' ? 155 : 120);
                osc.frequency.setValueAtTime(startFreq, now);
                osc.frequency.exponentialRampToValueAtTime(34, now + 0.14);

                gain.gain.setValueAtTime(isSuper ? 0.55 : 0.42, now);
                gain.gain.exponentialRampToValueAtTime(0.001, now + 0.15);
                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start(now);
                osc.stop(now + 0.16);

                if (isSuper) {
                    // Golden harmonic whoosh
                    const chime = this.ctx.createOscillator();
                    const cGain = this.ctx.createGain();
                    chime.type = 'triangle';
                    chime.frequency.setValueAtTime(587.33, now);
                    chime.frequency.exponentialRampToValueAtTime(1174.66, now + 0.28);
                    cGain.gain.setValueAtTime(0.18, now);
                    cGain.gain.exponentialRampToValueAtTime(0.001, now + 0.29);
                    chime.connect(cGain);
                    cGain.connect(this.ctx.destination);
                    chime.start(now);
                    chime.stop(now + 0.3);
                }
            }

            playWhistle(longWhistle = false) {
                if (!state.audioEnabled) return;
                this.init();
                const now = this.ctx.currentTime;
                const dur = longWhistle ? 0.48 : 0.22;

                const osc = this.ctx.createOscillator();
                const lfo = this.ctx.createOscillator();
                const lfoGain = this.ctx.createGain();
                const gain = this.ctx.createGain();

                // Pea-whistle trill modulation
                osc.type = 'sine';
                osc.frequency.setValueAtTime(2820, now);
                lfo.frequency.setValueAtTime(48, now);
                lfoGain.gain.setValueAtTime(110, now);
                lfo.connect(lfoGain);
                lfoGain.connect(osc.frequency);

                gain.gain.setValueAtTime(0.16, now);
                gain.gain.exponentialRampToValueAtTime(0.002, now + dur);

                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start(now);
                lfo.start(now);
                osc.stop(now + dur + 0.02);
                lfo.stop(now + dur + 0.02);
            }

            playPostClang() {
                if (!state.audioEnabled) return;
                this.init();
                const now = this.ctx.currentTime;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(480, now);
                osc.frequency.exponentialRampToValueAtTime(290, now + 0.35);
                gain.gain.setValueAtTime(0.35, now);
                gain.gain.exponentialRampToValueAtTime(0.001, now + 0.36);
                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start(now);
                osc.stop(now + 0.38);
            }

            playGoalCrowdRoar() {
                if (!state.audioEnabled) return;
                this.init();
                const now = this.ctx.currentTime;

                const bufferSize = this.ctx.sampleRate * 1.4;
                const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
                const data = buffer.getChannelData(0);
                for (let i = 0; i < bufferSize; i++) {
                    data[i] = (Math.random() * 2 - 1) * Math.sin((i / bufferSize) * Math.PI);
                }
                const noise = this.ctx.createBufferSource();
                noise.buffer = buffer;

                const filter = this.ctx.createBiquadFilter();
                filter.type = 'bandpass';
                filter.frequency.setValueAtTime(920, now);

                const gain = this.ctx.createGain();
                gain.gain.setValueAtTime(0.24, now);
                gain.gain.exponentialRampToValueAtTime(0.004, now + 1.38);

                noise.connect(filter);
                filter.connect(gain);
                gain.connect(this.ctx.destination);
                noise.start(now);

                // Stadium celebratory brass triad
                [523.25, 659.25, 783.99, 1046.5].forEach((freq, idx) => {
                    const o = this.ctx.createOscillator();
                    const g = this.ctx.createGain();
                    o.type = 'triangle';
                    o.frequency.setValueAtTime(freq, now + idx * 0.08);
                    g.gain.setValueAtTime(0.11, now + idx * 0.08);
                    g.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.08 + 0.55);
                    o.connect(g);
                    g.connect(this.ctx.destination);
                    o.start(now + idx * 0.08);
                    o.stop(now + idx * 0.08 + 0.56);
                });
            }

            commentate(text) {
                if (!state.audioEnabled || !('speechSynthesis' in window)) return;
                try {
                    window.speechSynthesis.cancel();
                    const u = new SpeechSynthesisUtterance(text);
                    u.rate = 1.08;
                    u.pitch = 1.02;
                    u.volume = 0.65;
