        /***********************************************************************
         * 5. PHYSICS-DRIVEN 3D CLASSIC PANEL FOOTBALL & MAGNUS SWERVE TRAIL
         ***********************************************************************/
        function createSoccerBallTexture() {
            const c = document.createElement('canvas');
            c.width = 512;
            c.height = 256;
            const ctx = c.getContext('2d');
            ctx.fillStyle = '#f8fafc';
            ctx.fillRect(0, 0, 512, 256);

            // Classic Pentagon / Hexagon Panel Pattern
            ctx.fillStyle = '#111827';
            ctx.strokeStyle = '#334155';
            ctx.lineWidth = 4;

            const spots = [
                [64, 64], [192, 64], [320, 64], [448, 64],
                [128, 160], [256, 160], [384, 160], [500, 160]
            ];
            spots.forEach(([cx, cy]) => {
                ctx.beginPath();
                for (let i = 0; i < 5; i++) {
                    const ang = (i / 5) * Math.PI * 2 - Math.PI / 2;
                    const px = cx + Math.cos(ang) * 28;
                    const py = cy + Math.sin(ang) * 28;
                    if (i === 0) ctx.moveTo(px, py);
                    else ctx.lineTo(px, py);
                }
                ctx.closePath();
                ctx.fill();
                ctx.stroke();
            });

            const tex = new THREE.CanvasTexture(c);
            tex.anisotropy = maxAnisotropy;
            return tex;
        }

        class MatchFootball {
            constructor() {
                this.radius = 0.28;
                const geo = new THREE.SphereGeometry(this.radius, 28, 28);
                const mat = new THREE.MeshStandardMaterial({
                    map: createSoccerBallTexture(),
                    roughness: 0.32,
                    metalness: 0.08
                });
                this.mesh = new THREE.Mesh(geo, mat);
                this.mesh.castShadow = true;
                scene.add(this.mesh);

                // Ground Target Shadow
                const shadowGeo = new THREE.CircleGeometry(0.32, 20);
                const shadowMat = new THREE.MeshBasicMaterial({ color: 0x102808, transparent: true, opacity: 0.55 });
                this.shadowMesh = new THREE.Mesh(shadowGeo, shadowMat);
                this.shadowMesh.rotation.x = -Math.PI / 2;
                this.shadowMesh.position.y = 0.025;
                scene.add(this.shadowMesh);

                // Aerodynamic Swerve Ribbon Trail
                this.trailCount = 22;
                this.trailPts = Array.from({ length: this.trailCount }, () => new THREE.Vector3(0, 0.3, 0));
                const trailGeo = new THREE.BufferGeometry().setFromPoints(this.trailPts);
                const trailMat = new THREE.LineBasicMaterial({ color: 0x38bdf8, transparent: true, opacity: 0.78 });
                this.trailLine = new THREE.Line(trailGeo, trailMat);
                scene.add(this.trailLine);

                this.pos = this.mesh.position;
                this.vel = new THREE.Vector3();
                this.spinCurlX = 0;
                this.pickupCooldown = 0;
                this.resetToCenter();
            }

            resetToCenter() {
                this.pos.set(0, this.radius, 0);
                this.vel.set(0, 0, 0);
                this.spinCurlX = 0;
                for (let i = 0; i < this.trailCount; i++) this.trailPts[i].copy(this.pos);
                this.trailLine.geometry.setFromPoints(this.trailPts);
            }

            launch(velVec, curlX = 0, trailColorHex = 0x38bdf8) {
                state.holder = null;
                this.pickupCooldown = 0.22;
                this.vel.copy(velVec);
                this.spinCurlX = curlX;
                this.trailLine.material.color.setHex(trailColorHex);
            }

            update(dt) {
                if (state.phase === 'REPLAY') return;
                if (this.pickupCooldown > 0) this.pickupCooldown -= dt;

                // If an athlete is dribbling the ball, keep it smoothly ahead of their feet
                if (state.holder) {
                    const h = state.holder;
                    const forwardX = Math.sin(h.facingAngle);
                    const forwardZ = Math.cos(h.facingAngle);
                    const dribbleBounce = Math.abs(Math.sin(performance.now() * 0.012)) * 0.04;
                    this.pos.set(
                        h.group.position.x + forwardX * 0.62,
                        this.radius + dribbleBounce,
                        h.group.position.z + forwardZ * 0.62
                    );
                    this.vel.copy(h.vel);
                    this.mesh.rotation.x += h.vel.z * dt * 2.5;
                    this.mesh.rotation.z -= h.vel.x * dt * 2.5;
                } else {
                    // Free flight & grass rolling physics with Magnus swerve
                    this.vel.y -= PITCH.gravity * dt;
                    if (this.pos.y > this.radius + 0.05) {
                        this.vel.x += this.spinCurlX * dt;
                    } else {
                        this.spinCurlX *= 0.92;
                    }

                    this.pos.addScaledVector(this.vel, dt);
                    this.mesh.rotation.x += this.vel.z * dt * 2.6;
                    this.mesh.rotation.z -= this.vel.x * dt * 2.6;

                    // Grass Bounce & Turf Friction
                    if (this.pos.y <= this.radius) {
                        this.pos.y = this.radius;
                        if (this.vel.y < -2.2) {
                            this.vel.y = -this.vel.y * 0.58;
                            spawnTurfBurst(this.pos.x, this.pos.z, 6, 0xd9f99d);
                        } else {
                            this.vel.y = 0;
                        }
                        // Rolling grass resistance
                        this.vel.x *= Math.pow(0.28, dt);
                        this.vel.z *= Math.pow(0.28, dt);
                    }

                    // Goal Detection & Post / Crossbar Collisions
                    checkGoalAndPostPhysics(this);

                    // Keep within Stadium Perimeter
                    if (Math.abs(this.pos.x) > PITCH.halfW + 0.3) {
                        this.pos.x = Math.sign(this.pos.x) * (PITCH.halfW + 0.25);
                        this.vel.x *= -0.6;
                    }
                    if (Math.abs(this.pos.z) > PITCH.halfL + 0.3 && Math.abs(this.pos.x) > PITCH.goalWidth / 2) {
                        this.pos.z = Math.sign(this.pos.z) * (PITCH.halfL + 0.25);
                        this.vel.z *= -0.6;
                    }
                }

                this.shadowMesh.position.set(this.pos.x, 0.025, this.pos.z);
                this.trailPts.pop();
                this.trailPts.unshift(this.pos.clone());
                this.trailLine.geometry.setFromPoints(this.trailPts);
            }
        }

