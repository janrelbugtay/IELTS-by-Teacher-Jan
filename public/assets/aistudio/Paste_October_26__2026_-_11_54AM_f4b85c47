            setExpression(expr) {
                if (expr === 'effort') {
                    this.mouthMesh.scale.set(0.75, 2.6, 1.2);
                    this.leftEyeRig.brow.rotation.z = -0.22;
                    this.rightEyeRig.brow.rotation.z = 0.22;
                } else if (expr === 'happy') {
                    this.mouthMesh.scale.set(1.5, 1.6, 1.0);
                    this.leftEyeRig.brow.rotation.z = 0.14;
                    this.rightEyeRig.brow.rotation.z = -0.14;
                } else {
                    this.mouthMesh.scale.set(1.0, 1.0, 1.0);
                    this.leftEyeRig.brow.rotation.z = 0;
                    this.rightEyeRig.brow.rotation.z = 0;
                }
            }

            triggerKick() {
                this.kickTimer = 0.34;
                this.setExpression('effort');
            }

            triggerSlideTackle(dirVec) {
                if (this.slideTimer > 0) return;
                this.slideTimer = 0.52;
                this.slideDir.copy(dirVec).normalize();
                this.facingAngle = Math.atan2(this.slideDir.x, this.slideDir.z);
                this.setExpression('effort');
                spawnTurfBurst(this.group.position.x, this.group.position.z, 12, 0xf8fafc);
            }

            triggerGoalkeeperDive(dirSign) {
                if (this.diveTimer > 0) return;
                this.diveTimer = 0.62;
                this.diveDir = dirSign;
                this.setExpression('effort');
            }

            triggerGoalEmote(isWinner) {
                this.emoteState = isWinner ? 'kneeslide' : 'slump';
                this.emoteTimer = 2.4;
                this.setExpression(isWinner ? 'happy' : 'effort');
            }

            update(dt, ballPos, elapsed) {
                // Controlled Ring Pulse
                const isControlled = (this.team === 'red' && state.controlledIdx === this.id);
                this.activeRing.material.opacity = isControlled ? (0.55 + Math.sin(elapsed * 7) * 0.22) : 0.0;

                // Blinking Eyelids
                this.blinkTimer -= dt;
                if (this.blinkTimer <= 0) {
                    const blinking = this.blinkTimer > -0.12;
                    this.leftEyeRig.eyelid.visible = blinking;
                    this.rightEyeRig.eyelid.visible = blinking;
                    if (!blinking) this.blinkTimer = 2.2 + Math.random() * 3.0;
                }

                // Goal Celebration Knee-Slide / Slump Emotes
                if (this.emoteTimer > 0) {
                    this.emoteTimer -= dt;
                    if (this.emoteState === 'kneeslide') {
                        this.bodyRoot.position.y = 0.16;
                        this.spineGroup.rotation.x = -0.32;
                        this.leftLegRig.hipGroup.rotation.x = 0.5;
                        this.leftLegRig.kneeGroup.rotation.x = 1.65;
                        this.rightLegRig.hipGroup.rotation.x = 0.5;
                        this.rightLegRig.kneeGroup.rotation.x = 1.65;
                        this.leftArmRig.shoulder.rotation.x = -2.4;
                        this.rightArmRig.shoulder.rotation.x = -2.4;
                    } else {
                        this.spineGroup.rotation.x = 0.35;
                        this.headGroup.rotation.x = 0.3;
                    }
                    if (this.emoteTimer <= 0) {
                        this.emoteState = 'none';
                        this.bodyRoot.position.y = 0;
                        this.spineGroup.rotation.x = 0;
                        this.headGroup.rotation.x = 0;
                        this.setExpression('neutral');
                    }
                    return;
                }

                // Goalkeeper Acrobatic Lateral Dive Kinematics
                if (this.diveTimer > 0) {
                    this.diveTimer -= dt;
                    const p = 1 - (this.diveTimer / 0.62);
                    const arc = Math.sin(p * Math.PI);
                    this.group.position.x = THREE.MathUtils.clamp(
                        this.group.position.x + this.diveDir * dt * 8.5,
                        -PITCH.goalWidth * 0.55,
                        PITCH.goalWidth * 0.55
                    );
                    this.bodyRoot.rotation.z = -this.diveDir * arc * 1.32;
                    this.bodyRoot.position.y = arc * 0.65;
                    this.leftArmRig.shoulder.rotation.x = -2.6;
                    this.rightArmRig.shoulder.rotation.x = -2.6;
                    if (this.diveTimer <= 0) {
                        this.bodyRoot.rotation.z = 0;
                        this.bodyRoot.position.y = 0;
                        this.setExpression('neutral');
                    }
                    return;
                }

                // Sliding Tackle Kinematics
                if (this.slideTimer > 0) {
                    this.slideTimer -= dt;
                    this.group.position.addScaledVector(this.slideDir, dt * 11.2);
                    this.group.position.x = THREE.MathUtils.clamp(this.group.position.x, -PITCH.halfW + 0.5, PITCH.halfW - 0.5);
                    this.group.position.z = THREE.MathUtils.clamp(this.group.position.z, -PITCH.halfL + 0.5, PITCH.halfL - 0.5);

                    this.bodyRoot.position.y = 0.18;
                    this.spineGroup.rotation.x = -0.65;
                    this.rightLegRig.hipGroup.rotation.x = -1.15;
                    this.rightLegRig.kneeGroup.rotation.x = 0.1;
                    this.leftLegRig.hipGroup.rotation.x = 0.35;
                    this.leftLegRig.kneeGroup.rotation.x = 1.45;
                    if (this.slideTimer <= 0) {
                        this.bodyRoot.position.y = 0;
                        this.spineGroup.rotation.x = 0;
                        this.setExpression('neutral');
                    }
                    return;
                }

                // Smooth Movement Toward Target
                const prevX = this.group.position.x;
                const prevZ = this.group.position.z;

                const dx = this.targetX - prevX;
                const dz = this.targetZ - prevZ;
                const dist = Math.hypot(dx, dz);

                const isSprinting = isControlled && (state.keys['ShiftLeft'] || state.keys['ShiftRight']) && this.stamina > 5;
                if (isSprinting && dist > 0.1) {
                    this.stamina = Math.max(0, this.stamina - dt * 24);
                } else {
                    this.stamina = Math.min(100, this.stamina + dt * 14);
                }

                const maxSpeed = (this.role === 'gk' ? 7.2 : 8.6) * (isSprinting ? 1.32 : 1.0);
                if (dist > 0.04) {
                    const step = Math.min(dist, maxSpeed * dt);
                    this.group.position.x += (dx / dist) * step;
                    this.group.position.z += (dz / dist) * step;
                }

                this.vel.set(
                    (this.group.position.x - prevX) / Math.max(dt, 0.001),
                    0,
                    (this.group.position.z - prevZ) / Math.max(dt, 0.001)
                );
                const speed = Math.hypot(this.vel.x, this.vel.z);

                // Smooth Facing Rotation
                if (speed > 0.45) {
                    const desiredAngle = Math.atan2(this.vel.x, this.vel.z);
                    let diff = desiredAngle - this.facingAngle;
                    while (diff > Math.PI) diff -= Math.PI * 2;
                    while (diff < -Math.PI) diff += Math.PI * 2;
                    this.facingAngle += diff * Math.min(1, dt * 12);
                } else {
                    const toBallAngle = Math.atan2(ballPos.x - this.group.position.x, ballPos.z - this.group.position.z);
                    let diff = toBallAngle - this.facingAngle;
                    while (diff > Math.PI) diff -= Math.PI * 2;
                    while (diff < -Math.PI) diff += Math.PI * 2;
                    this.facingAngle += diff * Math.min(1, dt * 8);
                }
                this.bodyRoot.rotation.y = this.facingAngle;

                // Running Stride & Arm Swing vs Idle Ready Pose
                if (speed > 0.35) {
                    const phase = elapsed * (isSprinting ? 21 : 16);
                    const stride = Math.sin(phase) * Math.min(speed * 0.09, 0.65);
                    this.leftLegRig.hipGroup.rotation.x = stride;
                    this.rightLegRig.hipGroup.rotation.x = -stride;
                    this.leftLegRig.kneeGroup.rotation.x = Math.max(0, -stride * 1.15);
                    this.rightLegRig.kneeGroup.rotation.x = Math.max(0, stride * 1.15);

                    this.leftArmRig.shoulder.rotation.x = -stride * 0.75;
                    this.rightArmRig.shoulder.rotation.x = stride * 0.75;
                    this.leftArmRig.elbow.rotation.x = -0.55;
                    this.rightArmRig.elbow.rotation.x = -0.55;

                    this.bodyRoot.position.y = Math.abs(Math.cos(phase)) * 0.09;
                    this.spineGroup.rotation.x = Math.min(speed * 0.022, 0.18);
                } else {
                    this.leftLegRig.hipGroup.rotation.x = THREE.MathUtils.lerp(this.leftLegRig.hipGroup.rotation.x, -0.08, dt * 10);
                    this.rightLegRig.hipGroup.rotation.x = THREE.MathUtils.lerp(this.rightLegRig.hipGroup.rotation.x, -0.08, dt * 10);
                    this.leftLegRig.kneeGroup.rotation.x = THREE.MathUtils.lerp(this.leftLegRig.kneeGroup.rotation.x, 0.16, dt * 10);
                    this.rightLegRig.kneeGroup.rotation.x = THREE.MathUtils.lerp(this.rightLegRig.kneeGroup.rotation.x, 0.16, dt * 10);

                    this.leftArmRig.shoulder.rotation.x = THREE.MathUtils.lerp(this.leftArmRig.shoulder.rotation.x, 0.08, dt * 10);
                    this.rightArmRig.shoulder.rotation.x = THREE.MathUtils.lerp(this.rightArmRig.shoulder.rotation.x, 0.08, dt * 10);
                    this.bodyRoot.position.y = Math.abs(Math.sin(elapsed * 3.5 + this.id)) * 0.03;
                    this.spineGroup.rotation.x = THREE.MathUtils.lerp(this.spineGroup.rotation.x, 0, dt * 10);
                }

                // Shooting / Passing Leg Wind-up & Follow-Through
                if (this.kickTimer > 0) {
                    this.kickTimer -= dt;
                    const p = 1 - (this.kickTimer / 0.34);
                    const swing = Math.sin(p * Math.PI * 1.25);
                    this.rightLegRig.hipGroup.rotation.x = -swing * 1.25;
                    this.rightLegRig.kneeGroup.rotation.x = Math.max(0, (0.4 - p) * 1.1);
                    this.leftArmRig.shoulder.rotation.z = 0.55 * swing;
                    if (this.kickTimer <= 0) {
                        this.leftArmRig.shoulder.rotation.z = 0;
                        this.setExpression('neutral');
                    }
                }
            }
        }

