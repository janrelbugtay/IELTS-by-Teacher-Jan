        // --- HIGH-DEFINITION 2048x2048 PROCEDURAL PBR FOOTBALL TURF & CHALK MARKINGS ---
        function generateHighResFootballPitchTextures() {
            const size = 2048;
            const colorCanvas = document.createElement('canvas');
            colorCanvas.width = size;
            colorCanvas.height = size;
            const ctx = colorCanvas.getContext('2d');

            const bumpCanvas = document.createElement('canvas');
            bumpCanvas.width = 1024;
            bumpCanvas.height = 1024;
            const bCtx = bumpCanvas.getContext('2d');

            // Base lush championship lawn green
            ctx.fillStyle = '#68b03b';
            ctx.fillRect(0, 0, size, size);

            // Dual-directional mowed lawn checkerboard stripes (14 cols x 24 rows)
            const numCols = 14;
            const numRows = 24;
            const colW = size / numCols;
            const rowH = size / numRows;

            for (let r = 0; r < numRows; r++) {
                for (let c = 0; c < numCols; c++) {
                    const isLightCol = c % 2 === 0;
                    const isLightRow = r % 2 === 0;
                    let luma = 0;
                    if (isLightCol && isLightRow) luma = 14;
                    else if (!isLightCol && !isLightRow) luma = -12;
                    else if (isLightCol && !isLightRow) luma = 5;
                    else luma = -4;

                    const R = Math.min(255, Math.max(0, 104 + luma));
                    const G = Math.min(255, Math.max(0, 175 + luma));
                    const B = Math.min(255, Math.max(0, 56 + Math.round(luma * 0.6)));
                    ctx.fillStyle = `rgb(${R},${G},${B})`;
                    ctx.fillRect(c * colW, r * rowH, colW + 1, rowH + 1);
                }
            }

            // Organic micro-blade grass noise across all 2048x2048 pixels
            const imgData = ctx.getImageData(0, 0, size, size);
            const data = imgData.data;
            for (let i = 0; i < data.length; i += 4) {
                const grain = (Math.random() - 0.5) * 18;
                data[i]     = Math.min(255, Math.max(0, data[i] + grain * 0.8));
                data[i + 1] = Math.min(255, Math.max(0, data[i + 1] + grain));
                data[i + 2] = Math.min(255, Math.max(0, data[i + 2] + grain * 0.5));
            }
            ctx.putImageData(imgData, 0, 0);

            // Subtle Goalmouth & Penalty Spot turf wear patches
            const wearSpots = [
                [0.5, 0.14, 150],
                [0.5, 0.86, 150],
                [0.5, 0.50, 120]
            ];
            wearSpots.forEach(([wx, wy, rad]) => {
                const grad = ctx.createRadialGradient(size * wx, size * wy, 8, size * wx, size * wy, rad);
                grad.addColorStop(0, 'rgba(132, 118, 65, 0.24)');
                grad.addColorStop(1, 'rgba(132, 118, 65, 0)');
                ctx.fillStyle = grad;
                ctx.fillRect(0, 0, size, size);
            });

            // --- CRISP WHITE CHALK PITCH LINES ---
            const planeW = 36.0;
            const planeL = 52.0;
            const toX = (m) => (0.5 + m / planeW) * size;
            const toY = (m) => (0.5 + m / planeL) * size;
            const scaleX = (m) => (m / planeW) * size;
            const scaleY = (m) => (m / planeL) * size;

            ctx.strokeStyle = '#fafdff';
            ctx.fillStyle = '#fafdff';
            ctx.lineWidth = (0.14 / planeW) * size;
            ctx.lineCap = 'square';

            const hw = PITCH.halfW;
            const hl = PITCH.halfL;

            // 1. Outer Touchlines & Goal Lines
            ctx.strokeRect(toX(-hw), toY(-hl), scaleX(PITCH.width), scaleY(PITCH.length));

            // 2. Halfway Line
            ctx.beginPath();
            ctx.moveTo(toX(-hw), toY(0));
            ctx.lineTo(toX(hw), toY(0));
            ctx.stroke();

            // 3. Center Circle & Center Kickoff Spot
            ctx.beginPath();
            ctx.ellipse(toX(0), toY(0), scaleX(4.4), scaleY(4.4), 0, 0, Math.PI * 2);
            ctx.stroke();

            ctx.beginPath();
            ctx.arc(toX(0), toY(0), scaleX(0.24), 0, Math.PI * 2);
            ctx.fill();

            // 4. North (-hl) & South (+hl) Penalty Areas, 6-Yard Goal Areas, Penalty Spots & D-Arcs
            [-1, 1].forEach(dir => {
                const goalZ = dir * hl;
                const penZ = dir * (hl - PITCH.penBoxL);
                const sixZ = dir * (hl - PITCH.goalAreaL);
                const spotZ = dir * (hl - 4.8);

                // 18-Yard Penalty Box
                ctx.strokeRect(
                    toX(-PITCH.penBoxW / 2),
                    Math.min(toY(goalZ), toY(penZ)),
                    scaleX(PITCH.penBoxW),
                    scaleY(PITCH.penBoxL)
                );

                // 6-Yard Goal Box
                ctx.strokeRect(
                    toX(-PITCH.goalAreaW / 2),
                    Math.min(toY(goalZ), toY(sixZ)),
                    scaleX(PITCH.goalAreaW),
                    scaleY(PITCH.goalAreaL)
                );

                // Penalty Spot
                ctx.beginPath();
                ctx.arc(toX(0), toY(spotZ), scaleX(0.2), 0, Math.PI * 2);
                ctx.fill();

                // Penalty Box D-Arc
                ctx.beginPath();
                const startAng = dir === -1 ? Math.PI * 0.22 : Math.PI * 1.22;
                const endAng = dir === -1 ? Math.PI * 0.78 : Math.PI * 1.78;
                ctx.ellipse(toX(0), toY(spotZ), scaleX(3.4), scaleY(3.4), 0, startAng, endAng);
                ctx.stroke();
            });

            // 5. Four Corner Arcs
            const cRadX = scaleX(0.9);
            const cRadY = scaleY(0.9);
            [
                [-hw, -hl, 0, Math.PI * 0.5],
                [hw, -hl, Math.PI * 0.5, Math.PI],
                [hw, hl, Math.PI, Math.PI * 1.5],
                [-hw, hl, Math.PI * 1.5, Math.PI * 2]
            ].forEach(([cx, cz, a1, a2]) => {
                ctx.beginPath();
                ctx.ellipse(toX(cx), toY(cz), cRadX, cRadY, 0, a1, a2);
                ctx.stroke();
            });

            // High-Frequency Grass Blade Bump Map
            const bImg = bCtx.createImageData(1024, 1024);
            for (let i = 0; i < bImg.data.length; i += 4) {
                const v = Math.floor(110 + Math.random() * 145);
                bImg.data[i] = v;
                bImg.data[i + 1] = v;
                bImg.data[i + 2] = v;
                bImg.data[i + 3] = 255;
            }
            bCtx.putImageData(bImg, 0, 0);

            const colorTex = new THREE.CanvasTexture(colorCanvas);
            colorTex.anisotropy = maxAnisotropy;
            colorTex.encoding = THREE.sRGBEncoding;
            colorTex.needsUpdate = true;

            const bumpTex = new THREE.CanvasTexture(bumpCanvas);
            bumpTex.anisotropy = maxAnisotropy;
            bumpTex.wrapS = bumpTex.wrapT = THREE.RepeatWrapping;
            bumpTex.repeat.set(8, 10);

            return { colorTex, bumpTex, planeW, planeL };
        }

        // Helper for "Era Football Club" Perimeter LED / Hoarding Banner Texture
        function createClubBrandTexture() {
            const c = document.createElement('canvas');
            c.width = 512;
            c.height = 128;
