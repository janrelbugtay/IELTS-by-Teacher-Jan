        <button onclick="toggleWebcam()" class="era-pill-btn px-3.5 py-1.5 rounded-full text-xs font-semibold text-white flex items-center gap-2">
            <span id="webcam-dot" class="w-2 h-2 rounded-full bg-slate-400"></span>
            <span>Webcam Motion</span>
        </button>
