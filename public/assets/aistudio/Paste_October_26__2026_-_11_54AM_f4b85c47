                this.spineGroup.add(numPlane);

                // --- EXPRESSIVE HEAD (Blinking Eyelids, Ball-Tracking Pupils, Brows, Mouth & Hair) ---
                this.headGroup = new THREE.Group();
                this.headGroup.position.set(0, 0.85, 0);
