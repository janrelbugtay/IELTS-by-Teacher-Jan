                });

                // 3 Tiered Concrete Steps + 3D Chibi Football Fans
                const headGeo = new THREE.SphereGeometry(0.35, 14, 14);
                const bodyGeo = new THREE.CylinderGeometry(0.25, 0.32, 0.64, 12);
                const eyeGeo = new THREE.SphereGeometry(0.045, 8, 8);
                const eyeMat = new THREE.MeshBasicMaterial({ color: 0x111827 });

                for (let row = 0; row < 3; row++) {
                    const stepX = baseX + sideSign * (1.3 + row * 1.3);
                    const stepY = 1.65 + row * 0.88;

                    const stepMesh = new THREE.Mesh(new THREE.BoxGeometry(1.35, stepY, standLen - 0.8), concreteMat);
                    stepMesh.position.set(stepX, stepY / 2, 0);
                    stepMesh.receiveShadow = true;
                    standGroup.add(stepMesh);

                    for (let z = -22.0; z <= 22.0; z += 1.65) {
                        const spec = new THREE.Group();
                        const skinColor = skinPalette[(Math.abs(Math.round(z * 7)) + row) % skinPalette.length];
                        const shirtColor = shirtPalette[(Math.abs(Math.round(z * 11)) + row * 3) % shirtPalette.length];

                        const torso = new THREE.Mesh(bodyGeo, new THREE.MeshStandardMaterial({ color: shirtColor, roughness: 0.42 }));
                        torso.position.y = 0.32;
                        torso.castShadow = true;
                        spec.add(torso);

                        const headPivot = new THREE.Group();
                        headPivot.position.y = 0.84;

                        const head = new THREE.Mesh(headGeo, new THREE.MeshStandardMaterial({ color: skinColor, roughness: 0.45 }));
                        head.castShadow = true;
                        headPivot.add(head);

                        const e1 = new THREE.Mesh(eyeGeo, eyeMat);
                        e1.position.set(-sideSign * 0.31, 0.04, -0.11);
                        headPivot.add(e1);
                        const e2 = new THREE.Mesh(eyeGeo, eyeMat);
                        e2.position.set(-sideSign * 0.31, 0.04, 0.11);
                        headPivot.add(e2);

                        spec.add(headPivot);
                        spec.position.set(stepX - sideSign * 0.15, stepY, z + (Math.random() - 0.5) * 0.18);
                        spec.userData = {
                            baseY: stepY,
                            phase: Math.random() * Math.PI * 2,
                            headPivot,
                            sideSign
                        };
                        standGroup.add(spec);
                        spectators.push(spec);
                    }
                }

                // Back Grandstand Wall & VIP Skybox Windows
                const backStandX = baseX + sideSign * 5.0;
                const backStandWall = new THREE.Mesh(new THREE.BoxGeometry(0.85, 6.8, standLen), greenWallMat);
