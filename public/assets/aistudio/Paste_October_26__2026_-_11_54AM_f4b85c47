        // Turf & Dust Particle Bursts
        const particles = [];
        const partGeo = new THREE.SphereGeometry(0.06, 6, 6);

        function spawnTurfBurst(x, z, count = 10, colorHex = 0xf8fafc) {
            for (let i = 0; i < count; i++) {
                const mat = new THREE.MeshBasicMaterial({ color: colorHex, transparent: true, opacity: 0.85 });
                const m = new THREE.Mesh(partGeo, mat);
                m.position.set(x, 0.08, z);
                const ang = (i / count) * Math.PI * 2 + Math.random() * 0.5;
                const spd = 1.2 + Math.random() * 2.8;
                scene.add(m);
                particles.push({
                    mesh: m,
                    vel: new THREE.Vector3(Math.cos(ang) * spd, 1.4 + Math.random() * 2.2, Math.sin(ang) * spd),
                    life: 1.0
                });
            }
        }

        function updateParticles(dt) {
            for (let i = particles.length - 1; i >= 0; i--) {
                const p = particles[i];
                p.life -= dt * 2.4;
                if (p.life <= 0) {
                    scene.remove(p.mesh);
                    p.mesh.material.dispose();
                    particles.splice(i, 1);
                } else {
                    p.vel.y -= 9.8 * dt;
                    p.mesh.position.addScaledVector(p.vel, dt);
                    p.mesh.material.opacity = p.life * 0.85;
                    p.mesh.scale.setScalar(p.life);
                }
            }
        }

        /***********************************************************************
         * 6. GOAL DETECTION, DYNAMIC NET RIPPLE & GOALKEEPING SAVES
         ***********************************************************************/
        function checkGoalAndPostPhysics(b) {
            if (state.phase !== 'PLAYING') return;

            const halfGW = PITCH.goalWidth / 2;
            const gh = PITCH.goalHeight;

            // Check Post & Crossbar Collisions at both ends
            [-PITCH.halfL, PITCH.halfL].forEach(gz => {
                if (Math.abs(b.pos.z - gz) < 0.38) {
                    // Left or Right Goalpost
                    if ((Math.abs(b.pos.x - halfGW) < 0.28 || Math.abs(b.pos.x + halfGW) < 0.28) && b.pos.y <= gh + 0.2) {
                        b.vel.z *= -0.75;
                        b.vel.x *= -0.75;
                        sound.playPostClang();
                        spawnWorldCallout('OFF THE POST!', b.pos, '#facc15');
                    }
                    // Crossbar
                    if (Math.abs(b.pos.x) <= halfGW && Math.abs(b.pos.y - gh) < 0.25) {
                        b.vel.y = Math.abs(b.vel.y) * 0.7 + 2.0;
                        b.vel.z *= -0.65;
                        sound.playPostClang();
                        spawnWorldCallout('CROSSBAR!', b.pos, '#facc15');
                    }
                }
            });

            // Check North Goal (-Z: Era FC Scores!)
            if (b.pos.z < -PITCH.halfL - 0.15 && Math.abs(b.pos.x) < halfGW && b.pos.y < gh) {
                triggerGoalNetRipple(0, b.pos);
                b.vel.multiplyScalar(0.25);
                handleGoalScored('red');
            }
            // Check South Goal (+Z: Rival FC Scores!)
            else if (b.pos.z > PITCH.halfL + 0.15 && Math.abs(b.pos.x) < halfGW && b.pos.y < gh) {
                triggerGoalNetRipple(1, b.pos);
                b.vel.multiplyScalar(0.25);
                handleGoalScored('blue');
            }
        }

        function triggerGoalNetRipple(netIdx, impactPos) {
            const net = goalNets[netIdx];
            if (!net) return;
            net.userData.rippleIntensity = 1.0;
            net.userData.rippleCenter.copy(impactPos);
        }

        function updateGoalNetRipples(dt, elapsed) {
            goalNets.forEach(net => {
                const ud = net.userData;
                if (ud.rippleIntensity <= 0.01) return;
                ud.rippleIntensity = Math.max(0, ud.rippleIntensity - dt * 1.1);

                const posAttr = net.geometry.attributes.position;
                const baseAttr = ud.basePos;

                for (let i = 0; i < posAttr.count; i++) {
                    const bx = baseAttr.getX(i);
                    const by = baseAttr.getY(i);
                    // Pin outer edges of the net to the goalposts & crossbar
                    const isEdge = Math.abs(bx) > (PITCH.goalWidth / 2 - 0.1) || Math.abs(by) > (PITCH.goalHeight / 2 - 0.1);
                    if (isEdge) {
                        posAttr.setZ(i, 0);
                    } else {
                        const wave = Math.sin(elapsed * 24 - Math.hypot(bx, by) * 3.0) * 0.45 * ud.rippleIntensity;
                        const bulge = ud.zSign * 0.65 * ud.rippleIntensity;
                        posAttr.setZ(i, bulge + wave);
                    }
                }
                posAttr.needsUpdate = true;
            });
        }

        function handleGoalScored(scoringTeam) {
