            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.shadowColor = 'rgba(0,0,0,0.5)';
            ctx.shadowBlur = 6;
            ctx.fillText('Era Football Club', 256, 64);
            const tex = new THREE.CanvasTexture(c);
            tex.anisotropy = maxAnisotropy;
            return tex;
        }

        // Helper for Corrugated Roof Texture
        function createCorrugatedRoofTexture() {
            const c = document.createElement('canvas');
            c.width = 256;
            c.height = 256;
            const ctx = c.getContext('2d');
            for (let x = 0; x < 256; x += 8) {
                ctx.fillStyle = x % 16 === 0 ? '#38762b' : '#2c5e21';
                ctx.fillRect(x, 0, 8, 256);
            }
            const tex = new THREE.CanvasTexture(c);
            tex.wrapS = tex.wrapT = THREE.RepeatWrapping;
            tex.repeat.set(16, 4);
            tex.anisotropy = maxAnisotropy;
            return tex;
        }

        /***********************************************************************
         * 3. BUILD LAKESIDE FOOTBALL STADIUM, DYNAMIC GOALS, CORNER FLAGS & CROWD
         ***********************************************************************/
        const spectators = [];
        const goalNets = []; // Stores North & South deformable goal net meshes
        const cornerFlags = [];

        function buildLakesideFootballStadium() {
            const worldGroup = new THREE.Group();

            // 1. PBR Football Pitch Plane
            const { colorTex, bumpTex, planeW, planeL } = generateHighResFootballPitchTextures();
            const pitchGeo = new THREE.PlaneGeometry(planeW, planeL);
            const pitchMat = new THREE.MeshStandardMaterial({
                map: colorTex,
                bumpMap: bumpTex,
                bumpScale: 0.024,
                roughness: 0.78,
                metalness: 0.02
            });
            const pitchMesh = new THREE.Mesh(pitchGeo, pitchMat);
            pitchMesh.rotation.x = -Math.PI / 2;
            pitchMesh.receiveShadow = true;
            worldGroup.add(pitchMesh);

            // 2. Detailed 3D Football Goals with Dynamic Deformable Hexagonal Nets
            const netCanvas = document.createElement('canvas');
            netCanvas.width = 128;
            netCanvas.height = 128;
            const nCtx = netCanvas.getContext('2d');
            nCtx.strokeStyle = '#f8fafc';
            nCtx.lineWidth = 10;
            nCtx.beginPath();
            nCtx.moveTo(0, 64); nCtx.lineTo(64, 0); nCtx.lineTo(128, 64); nCtx.lineTo(64, 128); nCtx.closePath();
            nCtx.stroke();
            const netTex = new THREE.CanvasTexture(netCanvas);
            netTex.wrapS = netTex.wrapT = THREE.RepeatWrapping;
            netTex.repeat.set(22, 10);
            netTex.anisotropy = maxAnisotropy;

            const netMat = new THREE.MeshStandardMaterial({
                map: netTex,
                transparent: true,
                opacity: 0.86,
                side: THREE.DoubleSide,
                roughness: 0.5
            });

            const postMat = new THREE.MeshStandardMaterial({ color: 0xffffff, roughness: 0.25, metalness: 0.35 });
            const stanchionMat = new THREE.MeshStandardMaterial({ color: 0x1e4620, roughness: 0.4, metalness: 0.5 });

            function createFootballGoal(zSign) {
                // zSign: -1 = North Goal (Rival FC), +1 = South Goal (Era FC)
                const goalGroup = new THREE.Group();
                const goalZ = zSign * PITCH.halfL;
                const gw = PITCH.goalWidth;
                const gh = PITCH.goalHeight;
                const gd = PITCH.goalDepth;

                // Left & Right Posts + Crossbar
                const postGeo = new THREE.CylinderGeometry(0.085, 0.085, gh, 16);
                const leftPost = new THREE.Mesh(postGeo, postMat);
                leftPost.position.set(-gw / 2, gh / 2, goalZ);
                leftPost.castShadow = true;
                goalGroup.add(leftPost);

                const rightPost = new THREE.Mesh(postGeo, postMat);
                rightPost.position.set(gw / 2, gh / 2, goalZ);
                rightPost.castShadow = true;
                goalGroup.add(rightPost);

                const crossbar = new THREE.Mesh(new THREE.CylinderGeometry(0.085, 0.085, gw + 0.16, 16), postMat);
                crossbar.rotation.z = Math.PI / 2;
                crossbar.position.set(0, gh, goalZ);
                crossbar.castShadow = true;
                goalGroup.add(crossbar);

                // Green Rear Stanchion Supports
                [-gw / 2, gw / 2].forEach(px => {
                    const backBar = new THREE.Mesh(new THREE.CylinderGeometry(0.05, 0.05, gh, 10), stanchionMat);
                    backBar.position.set(px, gh / 2, goalZ + zSign * gd);
                    goalGroup.add(backBar);

                    const topStrut = new THREE.Mesh(new THREE.CylinderGeometry(0.045, 0.045, gd, 10), stanchionMat);
                    topStrut.rotation.x = Math.PI / 2;
                    topStrut.position.set(px, gh - 0.05, goalZ + zSign * (gd / 2));
                    goalGroup.add(topStrut);
                });

                // Deformable Back Net Plane
                const backNetGeo = new THREE.PlaneGeometry(gw, gh, 16, 8);
                const backNet = new THREE.Mesh(backNetGeo, netMat);
                backNet.position.set(0, gh / 2, goalZ + zSign * gd);
                backNet.userData = {
                    basePos: backNetGeo.attributes.position.clone(),
                    rippleIntensity: 0,
                    rippleCenter: new THREE.Vector3(),
                    zSign
                };
                goalGroup.add(backNet);
                goalNets.push(backNet);

                // Top Roof Net & Side Nets
                const roofNet = new THREE.Mesh(new THREE.PlaneGeometry(gw, gd), netMat);
                roofNet.rotation.x = Math.PI / 2;
                roofNet.position.set(0, gh, goalZ + zSign * (gd / 2));
                goalGroup.add(roofNet);

                [-gw / 2, gw / 2].forEach(px => {
                    const sideNet = new THREE.Mesh(new THREE.PlaneGeometry(gd, gh), netMat);
                    sideNet.rotation.y = Math.PI / 2;
                    sideNet.position.set(px, gh / 2, goalZ + zSign * (gd / 2));
                    goalGroup.add(sideNet);
                });

                worldGroup.add(goalGroup);
            }

            createFootballGoal(-1); // North Goal
            createFootballGoal(1);  // South Goal

            // 3. Animated Corner Flags
            const poleMat = new THREE.MeshStandardMaterial({ color: 0xfef08a, roughness: 0.3 });
            const flagMat = new THREE.MeshStandardMaterial({ color: 0xef4444, side: THREE.DoubleSide, roughness: 0.4 });
            [
                [-PITCH.halfW, -PITCH.halfL],
                [PITCH.halfW, -PITCH.halfL],
                [-PITCH.halfW, PITCH.halfL],
                [PITCH.halfW, PITCH.halfL]
            ].forEach(([cx, cz]) => {
                const fg = new THREE.Group();
                const pole = new THREE.Mesh(new THREE.CylinderGeometry(0.03, 0.03, 1.35, 8), poleMat);
                pole.position.y = 0.675;
                pole.castShadow = true;
                fg.add(pole);

                const clothGeo = new THREE.PlaneGeometry(0.45, 0.32, 6, 2);
                const cloth = new THREE.Mesh(clothGeo, flagMat);
                cloth.position.set(0.22, 1.16, 0);
                fg.add(cloth);
                fg.position.set(cx, 0, cz);
                worldGroup.add(fg);
                cornerFlags.push(cloth);
            });

            // 4. Perimeter Stadium Walls, Team Dugouts & "Era Football Club" Branding
            const greenWallMat = new THREE.MeshStandardMaterial({ color: 0x26631f, roughness: 0.65 });
            const darkPanelMat = new THREE.MeshStandardMaterial({ color: 0x184715, roughness: 0.75 });
            const whiteCopingMat = new THREE.MeshStandardMaterial({ color: 0xe2e8f0, roughness: 0.4 });
            const brandTex = createClubBrandTexture();
            const brandMat = new THREE.MeshBasicMaterial({ map: brandTex, transparent: true });

            // North Perimeter Wall behind North Goal
            const northWallGroup = new THREE.Group();
            const northWall = new THREE.Mesh(new THREE.BoxGeometry(36.8, 2.5, 0.6), greenWallMat);
            northWall.position.set(0, 1.25, -26.2);
            northWall.castShadow = true;
            northWall.receiveShadow = true;
            northWallGroup.add(northWall);

            for (let px = -14; px <= 14; px += 5.6) {
                if (Math.abs(px) < 4) continue;
                const panel = new THREE.Mesh(new THREE.BoxGeometry(4.4, 1.4, 0.08), darkPanelMat);
                panel.position.set(px, 1.35, -25.86);
                northWallGroup.add(panel);
            }

            [-9.5, 0, 9.5].forEach(bx => {
                const northBrand = new THREE.Mesh(new THREE.PlaneGeometry(4.5, 1.1), brandMat);
                northBrand.position.set(bx, 1.45, -25.84);
                northWallGroup.add(northBrand);
            });
            worldGroup.add(northWallGroup);

            // Team Technical Area Dugout Benches on Touchlines
            function createTeamDugout(x, z, rotY) {
                const bGroup = new THREE.Group();
                const benchMat = new THREE.MeshStandardMaterial({ color: 0x245e1e, roughness: 0.5 });
                const seat = new THREE.Mesh(new THREE.BoxGeometry(3.6, 0.12, 0.68), benchMat);
                seat.position.y = 0.5;
                seat.castShadow = true;
                bGroup.add(seat);
                const back = new THREE.Mesh(new THREE.BoxGeometry(3.6, 0.6, 0.12), benchMat);
                back.position.set(0, 0.82, -0.28);
                back.castShadow = true;
                bGroup.add(back);
                bGroup.position.set(x, 0, z);
                bGroup.rotation.y = rotY;
                worldGroup.add(bGroup);
            }

            createTeamDugout(-16.2, -6.5, Math.PI / 2);
            createTeamDugout(-16.2, 6.5, Math.PI / 2);
            createTeamDugout(16.2, -6.5, -Math.PI / 2);
            createTeamDugout(16.2, 6.5, -Math.PI / 2);

            // 5. Covered Left & Right Grandstands + 160+ Animated 3D Spectators
            const roofTex = createCorrugatedRoofTexture();
            const roofMat = new THREE.MeshStandardMaterial({ map: roofTex, roughness: 0.55 });
            const concreteMat = new THREE.MeshStandardMaterial({ color: 0xdbe2ea, roughness: 0.7 });
            const glassMat = new THREE.MeshStandardMaterial({ color: 0x3b6998, roughness: 0.15, metalness: 0.8 });

            const skinPalette = [0xf5cba7, 0xe0ac69, 0xc68642, 0x8d5524, 0x5c3818, 0xfadbd8];
            const shirtPalette = [
                0xef4444, 0xdc2626, 0x3b82f6, 0x2563eb, 0xfacc15,
                0x10b981, 0xffffff, 0xf97316, 0xa855f7, 0x06b6d4
            ];

            function buildGrandstandSide(sideSign) {
                const standGroup = new THREE.Group();
                const baseX = sideSign * 17.6;
                const standLen = 49.0;

                // Touchline Barrier Wall with White Coping
                const barrier = new THREE.Mesh(new THREE.BoxGeometry(0.7, 2.0, standLen), greenWallMat);
                barrier.position.set(baseX, 1.0, 0);
                barrier.castShadow = true;
                barrier.receiveShadow = true;
                standGroup.add(barrier);

                const coping = new THREE.Mesh(new THREE.BoxGeometry(0.84, 0.14, standLen + 0.1), whiteCopingMat);
                coping.position.set(baseX, 2.05, 0);
                standGroup.add(coping);

                // "Era Football Club" Signage along Touchline Walls
                [-14.0, 0, 14.0].forEach(zPos => {
                    const sign = new THREE.Mesh(new THREE.PlaneGeometry(4.4, 1.05), brandMat);
                    sign.position.set(baseX - sideSign * 0.37, 1.15, zPos);
                    sign.rotation.y = -sideSign * Math.PI / 2;
