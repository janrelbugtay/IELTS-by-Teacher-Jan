            spawnWorldCallout(`#${athletes[bestIdx].number} ${athletes[bestIdx].name.toUpperCase()}`, athletes[bestIdx].group.position, '#facc15');
        }

        // Action 1: Crisp Ground Pass (On Offense) OR Switch Player (On Defense)
        function executeGroundPassOrSwitch() {
            if (state.phase !== 'PLAYING') return;
            sound.init();

            const active = athletes[state.controlledIdx];
            const hasBall = state.holder && state.holder.team === 'red';

            if (!hasBall) {
                switchControlledPlayer();
                return;
            }

            const passer = state.holder;
            passer.triggerKick();

            // Find best positioned Red teammate ahead or open
            let bestMate = null;
            let bestScore = -Infinity;
            for (let i = 1; i <= 4; i++) {
                const mate = athletes[i];
                if (mate.id === passer.id) continue;
                const d = passer.group.position.distanceTo(mate.group.position);
                // Prefer forward passes toward North Goal (-Z)
                const forwardBonus = (passer.group.position.z - mate.group.position.z) * 1.4;
                const score = forwardBonus - d * 0.35;
                if (score > bestScore) {
                    bestScore = score;
                    bestMate = mate;
                }
            }

            if (bestMate) {
                const toMate = new THREE.Vector3().subVectors(bestMate.group.position, ball.pos);
                const dist = toMate.length();
                toMate.normalize();
                const passSpeed = THREE.MathUtils.clamp(13.5 + dist * 0.45, 14, 23);
                ball.launch(new THREE.Vector3(toMate.x * passSpeed, 1.4, toMate.z * passSpeed), 0, 0x38bdf8);
                state.controlledIdx = bestMate.id;
                sound.playKick('normal', false);
                updateSuperMeter(10);
                spawnWorldCallout('TIKI-TAKA PASS!', passer.group.position, '#38bdf8');
            }
        }

        // Action 2: Lofted Lob / Through-Cross (On Offense) OR Sliding Tackle (On Defense)
        function executeLobOrSlideTackle() {
            if (state.phase !== 'PLAYING') return;
            sound.init();

            const active = athletes[state.controlledIdx];
            const hasBall = state.holder && state.holder.team === 'red';

            if (hasBall) {
                const kicker = state.holder;
                kicker.triggerKick();
                const dirX = Math.sin(kicker.facingAngle);
                const dirZ = Math.cos(kicker.facingAngle);
                ball.launch(new THREE.Vector3(dirX * 14.5, 9.2, dirZ * 15.5), 0, 0xc084fc);
                sound.playKick('hard', false);
                updateSuperMeter(12);
                spawnWorldCallout('LOFTED CROSS!', kicker.group.position, '#c084fc');
            } else {
                // Sliding Tackle toward the ball
                const dirToBall = new THREE.Vector3().subVectors(ball.pos, active.group.position);
                dirToBall.y = 0;
                if (dirToBall.lengthSq() < 0.01) dirToBall.set(0, 0, -1);
                active.triggerSlideTackle(dirToBall);
                sound.playKick('normal', false);
                spawnWorldCallout('SLIDE TACKLE!', active.group.position, '#fbbf24');
            }
        }

        // Action 3: Timed Power Curl Shot (Uses Timing Needle: Early = Left Curl, Sweet = Top Corner, Late = Right Curl)
        function executeTimedCurlShot(isSuperStrike = false) {
            if (state.phase !== 'PLAYING') return;
            sound.init();

            let shooter = state.holder && state.holder.team === 'red' ? state.holder : athletes[state.controlledIdx];
            const distToBall = shooter.group.position.distanceTo(ball.pos);
            if (state.holder !== shooter && distToBall > 2.4) {
                // Attempt diving lunge/header if close enough, otherwise switch
                switchControlledPlayer();
                return;
            }

            shooter.triggerKick();

            const tVal = state.timingOsc; // 0..1
            const isSweetSpot = tVal >= 0.35 && tVal <= 0.65;

            let targetX = 0;
            let curlX = 0;
            let shotSpeed = 24.5;
            let loftY = 6.2;
            let trailHex = 0x4ade80;
            let label = 'TOP CORNER!';
            let labelColor = '#4ade80';

            if (isSuperStrike && state.eraCharge >= 100) {
                updateSuperMeter(-100);
                targetX = ( shooter.group.position.x > 0 ? -1 : 1 ) * (PITCH.goalWidth * 0.38);
                curlX = (shooter.group.position.x > 0 ? 11.5 : -11.5);
                shotSpeed = 32.0;
                loftY = 6.8;
                trailHex = 0xfacc15;
                label = '⚡ ERA SUPER STRIKE!';
                labelColor = '#facc15';
                state.slowMoFactor = 0.45;
                setTimeout(() => { state.slowMoFactor = 1.0; }, 650);
                sound.commentate('Era Super Strike unleashed!');
                spawnTurfBurst(shooter.group.position.x, shooter.group.position.z, 20, 0xfacc15);
            } else if (tVal < 0.35) {
                // EARLY -> Left Curl Swerve
                targetX = -PITCH.goalWidth * 0.36;
                curlX = -8.5;
                trailHex = 0x60a5fa;
                label = 'EARLY (LEFT CURL)';
                labelColor = '#60a5fa';
                updateSuperMeter(14);
            } else if (tVal > 0.65) {
                // LATE -> Right Curl Swerve
                targetX = PITCH.goalWidth * 0.36;
                curlX = 8.5;
                trailHex = 0xfb923c;
                label = 'LATE (RIGHT CURL)';
                labelColor = '#fb923c';
                updateSuperMeter(14);
            } else {
                // SWEET SPOT -> Top-Corner Finesse Rocket away from Blue GK
                const gkX = athletes[5].group.position.x;
                targetX = (gkX >= 0 ? -1 : 1) * (PITCH.goalWidth * 0.40);
                curlX = (targetX > 0 ? -5.5 : 5.5);
                shotSpeed = 27.5;
                loftY = 6.6;
                trailHex = 0x4ade80;
                label = 'SWEET SPOT CURVE!';
                labelColor = '#4ade80';
                updateSuperMeter(22);
            }

            const goalTarget = new THREE.Vector3(targetX, 1.5, -PITCH.halfL);
            const dir = new THREE.Vector3().subVectors(goalTarget, ball.pos).normalize();

            ball.launch(
                new THREE.Vector3(dir.x * shotSpeed - curlX * 0.22, loftY, dir.z * shotSpeed),
                curlX,
                trailHex
            );

            sound.playKick('hard', isSuperStrike);
            spawnWorldCallout(label, shooter.group.position, labelColor);

            // Trigger Blue Goalkeeper Reaction Dive
            const gk = athletes[5];
            if (Math.abs(targetX - gk.group.position.x) > 0.9) {
                gk.triggerGoalkeeperDive(Math.sign(targetX - gk.group.position.x));
            }
        }

        /***********************************************************************
         * 8. 5v5 TEAM AI, BALL INTERCEPTION, DRIBBLING & GOALKEEPER SAVES
         ***********************************************************************/
        function update5v5MatchAI(dt, elapsed) {
            if (state.phase !== 'PLAYING') return;

            // Oscillate Shot Timing Needle smoothly
            state.timingOsc = 0.5 + Math.sin(elapsed * 4.8) * 0.46;
            const needle = document.getElementById('timing-needle');
            if (needle) needle.style.left = `${(state.timingOsc * 100).toFixed(1)}%`;

            // 1. Check Ball Pickup, Tackles & Goalkeeper Saves
            if (ball.pickupCooldown <= 0) {
                for (let i = 0; i < athletes.length; i++) {
                    const a = athletes[i];
                    const dist = a.group.position.distanceTo(ball.pos);

                    // Goalkeeper Save & Distribution
                    if (a.role === 'gk' && dist < 1.35 && ball.pos.y < 2.35) {
                        if (state.holder !== a) {
                            sound.playKick('hard', false);
                            const clearDirZ = a.team === 'red' ? -1 : 1;
                            const clearX = (Math.random() - 0.5) * 12;
                            ball.launch(new THREE.Vector3(clearX, 7.5, clearDirZ * 17.5), 0, a.team === 'red' ? 0x34d399 : 0xf59e0b);
                            a.triggerGoalkeeperDive(Math.sign(ball.pos.x - a.group.position.x) || 1);
                            spawnWorldCallout('KEEPER SAVE!', a.group.position, '#34d399');
                            sound.commentate('Incredible save by the goalkeeper!');
                            break;
                        }
                    }

                    // Outfield Dribble Pickup or Slide Interception
                    const reachRadius = a.slideTimer > 0 ? 1.45 : 0.95;
                    if (a.role !== 'gk' && dist < reachRadius && ball.pos.y < 1.55) {
                        if (state.holder !== a) {
                            if (state.holder && state.holder.team !== a.team) {
                                spawnTurfBurst(ball.pos.x, ball.pos.z, 10, 0xfacc15);
                                spawnWorldCallout('DISPOSSESSED!', a.group.position, '#fbbf24');
                            }
                            state.holder = a;
                            ball.pickupCooldown = 0.28;
                            updatePossessionHUD(a.team);
                            if (a.team === 'red') {
                                state.controlledIdx = a.id;
                            }
                            break;
                        }
                    }
                }
            }

            // 2. Controlled Red Player Input Movement
            const ctrl = athletes[state.controlledIdx];
            let moveX = 0;
            let moveZ = 0;
            if (state.keys['KeyA'] || state.keys['ArrowLeft']) moveX -= 1;
            if (state.keys['KeyD'] || state.keys['ArrowRight']) moveX += 1;
            if (state.keys['KeyW'] || state.keys['ArrowUp']) moveZ -= 1;
            if (state.keys['KeyS'] || state.keys['ArrowDown']) moveZ += 1;

            if (moveX !== 0 || moveZ !== 0) {
                const len = Math.hypot(moveX, moveZ);
                ctrl.targetX = THREE.MathUtils.clamp(ctrl.group.position.x + (moveX / len) * 3.5, -PITCH.halfW + 0.6, PITCH.halfW - 0.6);
                ctrl.targetZ = THREE.MathUtils.clamp(ctrl.group.position.z + (moveZ / len) * 3.5, -PITCH.halfL + 0.6, PITCH.halfL - 0.6);
            } else if (state.pointerActive) {
                ctrl.targetX = THREE.MathUtils.clamp(state.pointerWorld.x, -PITCH.halfW + 0.6, PITCH.halfW - 0.6);
                ctrl.targetZ = THREE.MathUtils.clamp(state.pointerWorld.z, -PITCH.halfL + 0.6, PITCH.halfL - 0.6);
            } else if (state.holder !== ctrl) {
                // Gently gravitate controlled player toward ball if no keys pressed
                ctrl.targetX = THREE.MathUtils.lerp(ctrl.group.position.x, ball.pos.x, 0.35);
                ctrl.targetZ = THREE.MathUtils.lerp(ctrl.group.position.z, ball.pos.z, 0.35);
            }

            // 3. Tactical Mentality Offset for Era FC Teammates
            const tacticPush = state.tactic === 'High Press' ? -5.5 : (state.tactic === 'Tiki-Taka' ? -2.2 : 0);

            athletes.forEach(a => {
                if (a.id === state.controlledIdx) return;

                // Goalkeeper Positioning
                if (a.role === 'gk') {
                    const goalZ = a.team === 'red' ? (PITCH.halfL - 1.3) : (-PITCH.halfL + 1.3);
                    a.targetX = THREE.MathUtils.clamp(ball.pos.x * 0.45, -PITCH.goalWidth * 0.42, PITCH.goalWidth * 0.42);
                    a.targetZ = goalZ;
                    return;
                }

                // Red AI Teammates (Support runs & defensive cover)
                if (a.team === 'red') {
                    if (state.possessionTeam === 'red') {
                        const attackZ = a.role === 'fwd' ? (ball.pos.z - 5.5 + tacticPush) : (ball.pos.z * 0.5 + 8.5 + tacticPush);
                        a.targetX = THREE.MathUtils.clamp(a.homeX + Math.sin(elapsed * 2 + a.id) * 2.4, -12, 12);
                        a.targetZ = THREE.MathUtils.clamp(attackZ, -19.0, 18.0);
                    } else {
                        // Track back and press ball carrier
                        const isClosestDef = (a.id === 1 && ball.pos.x <= 0) || (a.id === 2 && ball.pos.x > 0);
                        if (isClosestDef && ball.pos.z > -4) {
                            a.targetX = ball.pos.x;
                            a.targetZ = ball.pos.z + 0.8;
                        } else {
                            a.targetX = THREE.MathUtils.lerp(a.homeX, ball.pos.x * 0.5, 0.4);
                            a.targetZ = THREE.MathUtils.clamp(a.homeZ + tacticPush * 0.5, -10, 18);
                        }
                    }
                    return;
                }

                // Blue AI Team (Rival FC) Behavior
                if (a.team === 'blue') {
                    if (state.holder === a) {
                        // Blue Ball Carrier dribbles toward South Goal (+Z)
                        a.targetX = THREE.MathUtils.lerp(a.group.position.x, 0, dt * 1.5);
                        a.targetZ = PITCH.halfL - 2.0;

                        // Shoot if within striking range of South Goal
                        if (a.group.position.z > PITCH.halfL - 12.5) {
                            a.triggerKick();
                            const aimX = (Math.random() - 0.5) * (PITCH.goalWidth * 0.78);
                            const shotDir = new THREE.Vector3(aimX - ball.pos.x, 1.3, PITCH.halfL - ball.pos.z).normalize();
                            ball.launch(new THREE.Vector3(shotDir.x * 23.5, 5.6, shotDir.z * 23.5), (Math.random() - 0.5) * 6, 0x60a5fa);
                            sound.playKick('hard', false);
                            spawnWorldCallout('RIVAL SHOT!', a.group.position, '#60a5fa');
                            if (Math.abs(aimX - athletes[0].group.position.x) > 0.8) {
                                athletes[0].triggerGoalkeeperDive(Math.sign(aimX - athletes[0].group.position.x));
                            }
                        }
                        // Or pass to a Blue forward if pressured by Red player
                        else {
                            const redDist = athletes[state.controlledIdx].group.position.distanceTo(a.group.position);
                            if (redDist < 2.6 && Math.random() < 0.08) {
                                const mate = a.id === 9 ? athletes[8] : athletes[9];
                                a.triggerKick();
                                const toMate = new THREE.Vector3().subVectors(mate.group.position, ball.pos).normalize();
                                ball.launch(new THREE.Vector3(toMate.x * 16.5, 1.5, toMate.z * 16.5), 0, 0x60a5fa);
                                sound.playKick('normal', false);
                            }
                        }
                    } else {
                        // Blue off-ball movement: closest Blue player chases loose/Red ball
                        let closestBlue = athletes[8];
                        let minD = Infinity;
                        for (let bi = 6; bi <= 9; bi++) {
                            const d = athletes[bi].group.position.distanceTo(ball.pos);
                            if (d < minD) {
                                minD = d;
                                closestBlue = athletes[bi];
                            }
                        }

                        if (a === closestBlue) {
                            a.targetX = ball.pos.x;
                            a.targetZ = ball.pos.z;
                        } else {
                            const formZ = state.possessionTeam === 'blue' ? a.homeZ + 7.5 : a.homeZ;
                            a.targetX = a.homeX + Math.cos(elapsed * 1.8 + a.id) * 2.0;
                            a.targetZ = THREE.MathUtils.clamp(formZ, -18.5, 15.5);
                        }
                    }
                }
            });
        }

        /***********************************************************************
         * 9. INSTANT REPLAY, CAMERA ANGLES, WEBCAM MOTION & INPUT CONTROLS
         ***********************************************************************/
        function recordReplayFrame() {
            if (state.phase === 'REPLAY') return;
            state.replayFrames.push({
                ballPos: ball.pos.clone(),
                athletesPos: athletes.map(a => ({
                    x: a.group.position.x,
                    y: a.bodyRoot.position.y,
                    z: a.group.position.z,
                    rotY: a.bodyRoot.rotation.y
                }))
            });
            if (state.replayFrames.length > 260) state.replayFrames.shift();
        }

        function triggerInstantReplay() {
            if (state.replayFrames.length < 20) return;
            state.phase = 'REPLAY';
            state.replayIdx = 0;
            document.getElementById('match-status-text').textContent = '🎥 INSTANT SLOW-MOTION GOAL REPLAY';
        }

        function updateReplayPlayback() {
            const idx = Math.floor(state.replayIdx);
            if (idx >= state.replayFrames.length) {
                state.phase = 'PLAYING';
                document.getElementById('match-status-text').textContent = 'WASD/ARROWS: MOVE • SPACE/J: PASS & SWITCH • K: LOB/SLIDE • L/CLICK: CURL SHOT • Q: SUPER STRIKE';
                return;
            }
            const f = state.replayFrames[idx];
            ball.pos.copy(f.ballPos);
            ball.shadowMesh.position.set(ball.pos.x, 0.025, ball.pos.z);
            f.athletesPos.forEach((ap, i) => {
                athletes[i].group.position.set(ap.x, 0, ap.z);
                athletes[i].bodyRoot.position.y = ap.y;
                athletes[i].bodyRoot.rotation.y = ap.rotY;
            });
            state.replayIdx += 0.55;
        }

        function cycleCameraMode() {
            const modes = ['Broadcast TV', 'End-to-End Pro', 'Sideline Drone'];
            const next = (modes.indexOf(state.cameraMode) + 1) % modes.length;
            state.cameraMode = modes[next];
            document.getElementById('cam-label').textContent = state.cameraMode;
        }

        function cycleTeamTactic() {
            const tactics = ['Tiki-Taka', 'High Press', 'Balanced'];
            const next = (tactics.indexOf(state.tactic) + 1) % tactics.length;
            state.tactic = tactics[next];
            document.getElementById('tactic-label').textContent = state.tactic;
            spawnWorldCallout(`MENTALITY: ${state.tactic.toUpperCase()}`, athletes[state.controlledIdx].group.position, '#fbbf24');
        }

        function toggleStadiumAudio() {
            state.audioEnabled = !state.audioEnabled;
            const dot = document.getElementById('audio-dot');
            if (state.audioEnabled) {
                dot.className = 'w-2.5 h-2.5 rounded-full bg-emerald-400 shadow-[0_0_8px_#34d399]';
                sound.init();
            } else {
                dot.className = 'w-2.5 h-2.5 rounded-full bg-slate-500';
            }
        }

        // Webcam Motion Kick Detector
        let camStream = null;
        let prevCamFrame = null;
        let lastCamKick = 0;

        async function toggleWebcam() {
            const pip = document.getElementById('webcam-pip');
            const dot = document.getElementById('webcam-dot');
            const video = document.getElementById('webcam-video');

            if (state.webcamEnabled) {
                state.webcamEnabled = false;
                pip.classList.add('hidden');
                dot.className = 'w-2 h-2 rounded-full bg-slate-400';
                if (camStream) {
                    camStream.getTracks().forEach(t => t.stop());
                    camStream = null;
                }
                return;
            }
            try {
                camStream = await navigator.mediaDevices.getUserMedia({
                    video: { width: 160, height: 120, facingMode: 'user' },
                    audio: false
                });
                video.srcObject = camStream;
                state.webcamEnabled = true;
                pip.classList.remove('hidden');
                dot.className = 'w-2 h-2 rounded-full bg-emerald-400 animate-ping';
            } catch (e) {
                spawnWorldCallout('WEBCAM UNAVAILABLE', athletes[state.controlledIdx].group.position, '#f87171');
            }
        }

        function processWebcamMotion() {
            if (!state.webcamEnabled) return;
            const video = document.getElementById('webcam-video');
            const cCanvas = document.getElementById('webcam-canvas');
            if (video.readyState < 2) return;

            const ctx = cCanvas.getContext('2d', { willReadFrequently: true });
            const w = cCanvas.width;
            const h = cCanvas.height;

            ctx.save();
            ctx.scale(-1, 1);
            ctx.drawImage(video, -w, 0, w, h);
            ctx.restore();

            const frame = ctx.getImageData(0, 0, w, h);
            const data = frame.data;

            if (prevCamFrame) {
                let sx = 0, sy = 0, count = 0;
                for (let y = 0; y < h; y += 2) {
                    for (let x = 0; x < w; x += 2) {
                        const i = (y * w + x) * 4;
                        const diff = Math.abs(data[i] - prevCamFrame[i]) +
                                     Math.abs(data[i + 1] - prevCamFrame[i + 1]) +
                                     Math.abs(data[i + 2] - prevCamFrame[i + 2]);
                        if (diff > 75) {
                            sx += x; sy += y; count++;
                            data[i] = 52; data[i + 1] = 211; data[i + 2] = 153;
                        }
                    }
                }
                ctx.putImageData(frame, 0, 0);

                if (count > 25) {
                    const cx = (sx / count) / w;
                    const cy = (sy / count) / h;
                    const marker = document.getElementById('webcam-marker');
                    marker.style.left = `${cx * 100}%`;
                    marker.style.top = `${cy * 100}%`;

                    const now = performance.now();
                    if (count > 170 && now - lastCamKick > 420) {
                        lastCamKick = now;
                        document.getElementById('webcam-state-text').textContent = 'STRIKE!';
                        executeTimedCurlShot(state.eraCharge >= 100);
                    } else {
                        document.getElementById('webcam-state-text').textContent = 'TRACKING';
                    }
                }
            }
            prevCamFrame = new Uint8ClampedArray(data);
        }

        // Mouse & Touch Raycasting onto Pitch + Swipe/Click Gestures
        const raycaster = new THREE.Raycaster();
        const groundPlane = new THREE.Plane(new THREE.Vector3(0, 1, 0), 0);
        let pointerDownInfo = null;

        canvas.addEventListener('pointermove', (e) => {
            const ndcX = (e.clientX / window.innerWidth) * 2 - 1;
            const ndcY = -(e.clientY / window.innerHeight) * 2 + 1;
            raycaster.setFromCamera({ x: ndcX, y: ndcY }, camera);
            raycaster.ray.intersectPlane(groundPlane, state.pointerWorld);
        });

        canvas.addEventListener('pointerdown', (e) => {
            sound.init();
            state.pointerActive = true;
            pointerDownInfo = { x: e.clientX, y: e.clientY, t: performance.now(), button: e.button };
        });

        window.addEventListener('pointerup', (e) => {
            state.pointerActive = false;
            if (!pointerDownInfo) return;
            const dx = e.clientX - pointerDownInfo.x;
            const dy = e.clientY - pointerDownInfo.y;
            const dist = Math.hypot(dx, dy);
            const btn = pointerDownInfo.button;
            pointerDownInfo = null;

            if (btn === 2) {
                executeLobOrSlideTackle();
            } else if (dy < -45) {
                // Upward swipe -> Power Curl Shot (or Super Strike)
                executeTimedCurlShot(state.eraCharge >= 100 && dy < -95);
            } else if (dist < 25) {
                // Quick Left Click -> Ground Pass if in possession, or Curl Shot if near opponent box
                if (state.holder && state.holder.team === 'red' && state.holder.group.position.z < -8.5) {
                    executeTimedCurlShot(false);
                } else {
                    executeGroundPassOrSwitch();
                }
            }
        });

        canvas.addEventListener('contextmenu', (e) => e.preventDefault());

        window.addEventListener('keydown', (e) => {
            state.keys[e.code] = true;
            if (e.code === 'Space' || e.code === 'KeyJ') {
                e.preventDefault();
                executeGroundPassOrSwitch();
            } else if (e.code === 'KeyK') {
                executeLobOrSlideTackle();
            } else if (e.code === 'KeyL' || e.code === 'Enter') {
                executeTimedCurlShot(false);
            } else if (e.code === 'KeyQ') {
                executeTimedCurlShot(true);
            } else if (e.code === 'Tab') {
                e.preventDefault();
                switchControlledPlayer();
            } else if (e.code === 'KeyT') {
                cycleTeamTactic();
            } else if (e.code === 'KeyC') {
                cycleCameraMode();
            } else if (e.code === 'KeyR') {
                triggerInstantReplay();
            }
        });

        window.addEventListener('keyup', (e) => {
            state.keys[e.code] = false;
        });

        /***********************************************************************
         * 10. MAIN RENDER LOOP, CAMERA FRAMING & WORLD UI PROJECTION
         ***********************************************************************/
        function updateWorldPlayerBadge(elapsed) {
            const badge = document.getElementById('controlled-badge');
            const ctrl = athletes[state.controlledIdx];
            if (!badge || !ctrl) return;

            document.getElementById('badge-name').textContent = `#${ctrl.number} ${ctrl.name.toUpperCase()}`;
            document.getElementById('badge-stamina').style.width = `${ctrl.stamina}%`;

            const wPos = ctrl.group.position.clone();
            wPos.y += 2.38 + Math.sin(elapsed * 5) * 0.06;
            const proj = wPos.project(camera);
            const x = (proj.x * 0.5 + 0.5) * window.innerWidth;
            const y = (-proj.y * 0.5 + 0.5) * window.innerHeight;
            badge.style.left = `${x}px`;
            badge.style.top = `${y}px`;
        }

        function updateMatchClock(dt) {
            if (state.phase !== 'PLAYING') return;
            state.matchSeconds = (state.matchSeconds + dt * 45) % 5400; // 90:00 arcade cycle
            const mins = Math.floor(state.matchSeconds / 60);
            const secs = Math.floor(state.matchSeconds % 60);
            document.getElementById('hud-clock').textContent =
                `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
        }

        function updateCameraFraming(dt, elapsed) {
            const targetPos = new THREE.Vector3();
            const lookTarget = new THREE.Vector3();

            if (state.phase === 'REPLAY') {
                targetPos.set(Math.sin(elapsed * 0.7) * 18, 9.5, ball.pos.z + Math.cos(elapsed * 0.7) * 18);
                lookTarget.copy(ball.pos);
            } else if (state.cameraMode === 'Broadcast TV') {
                // Classic Lakeside Elevated End-to-End Stadium View matching reference screenshot
                targetPos.set(ball.pos.x * 0.32, 17.5, ball.pos.z * 0.45 + 24.5);
                lookTarget.set(ball.pos.x * 0.25, 0.5, ball.pos.z * 0.45 - 2.5);
            } else if (state.cameraMode === 'End-to-End Pro') {
                const ctrl = athletes[state.controlledIdx];
                targetPos.set(ctrl.group.position.x * 0.65, 9.2, ctrl.group.position.z + 14.5);
                lookTarget.set(ball.pos.x * 0.4, 0.8, ball.pos.z - 4.0);
            } else {
                // Sideline Drone Orbit
                targetPos.set(Math.sin(elapsed * 0.32) * 28, 16.5, Math.cos(elapsed * 0.32) * 32);
                lookTarget.set(0, 0.8, 0);
            }

            camera.position.lerp(targetPos, Math.min(1, dt * 5.2));
            camera.lookAt(lookTarget);
        }

        let prevTime = performance.now();

        function animate(now) {
            requestAnimationFrame(animate);
            const rawDt = Math.min((now - prevTime) / 1000, 0.05);
            prevTime = now;
            const dt = rawDt * state.slowMoFactor;
            const elapsed = now * 0.001;

            processWebcamMotion();

            if (state.phase === 'REPLAY') {
                updateReplayPlayback();
            } else {
                update5v5MatchAI(dt, elapsed);
                ball.update(dt);
                recordReplayFrame();
                updateMatchClock(rawDt);
            }

            athletes.forEach(a => a.update(dt, ball.pos, elapsed));
            updateParticles(dt);
            updateGoalNetRipples(rawDt, elapsed);

            // Animate Corner Flags fluttering in the lakeside breeze
            cornerFlags.forEach((cloth, idx) => {
                cloth.rotation.y = Math.sin(elapsed * 6 + idx) * 0.28;
            });

            // Animate 160+ Spectators cheering & tracking the football
            const isGoal = state.phase === 'GOAL_CELEBRATION';
            for (let i = 0; i < spectators.length; i++) {
                const s = spectators[i];
                if (isGoal) {
                    s.position.y = s.userData.baseY + Math.abs(Math.sin(elapsed * 14 + s.userData.phase)) * 0.26;
                } else {
                    s.position.y = s.userData.baseY;
                }
                const lookZ = (ball.pos.z - s.position.z) * 0.022 * s.userData.sideSign;
                s.userData.headPivot.rotation.y = THREE.MathUtils.clamp(lookZ, -0.45, 0.45);
            }

            updateCameraFraming(rawDt, elapsed);
            updateWorldPlayerBadge(elapsed);

            renderer.render(scene, camera);
        }

        window.addEventListener('resize', () => {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        });

        window.onload = function () {
            resetKickoffPositions();
            requestAnimationFrame(animate);
        };
    </script>
</body>
</html>