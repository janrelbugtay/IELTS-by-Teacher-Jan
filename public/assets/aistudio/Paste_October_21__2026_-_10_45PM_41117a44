        function createSignboardTexture(title, subtitle, accentHex) {
            const canvas = document.createElement('canvas');
            canvas.width = 1024;
            canvas.height = 256;
            const ctx = canvas.getContext('2d');

            // Dark architectural sign background
            ctx.fillStyle = '#0f172a';
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            // Glowing border frame attached to building
            const hexStr = '#' + accentHex.toString(16).padStart(6, '0');
            ctx.strokeStyle = hexStr;
            ctx.lineWidth = 18;
            ctx.strokeRect(9, 9, canvas.width - 18, canvas.height - 18);

            // Building Name
            ctx.fillStyle = '#ffffff';
            ctx.font = 'bold 74px Fredoka, Inter, sans-serif';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText(title, canvas.width / 2, 102);

            // Subtitle
            ctx.fillStyle = '#fde047';
            ctx.font = 'bold 42px Inter, sans-serif';
            ctx.fillText(subtitle, canvas.width / 2, 182);

            const texture = new THREE.CanvasTexture(canvas);
            texture.needsUpdate = true;
            return texture;
        }

        function createWallPosterTexture(item, badgeText, accentHex) {
            const canvas = document.createElement('canvas');
            canvas.width = 768;
            canvas.height = 512;
            const ctx = canvas.getContext('2d');

            // Chalkboard / Smartboard background
            const grad = ctx.createLinearGradient(0, 0, 0, canvas.height);
            grad.addColorStop(0, '#0f172a');
            grad.addColorStop(1, '#1e293b');
            ctx.fillStyle = grad;
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            const hexStr = '#' + accentHex.toString(16).padStart(6, '0');
            ctx.strokeStyle = hexStr;
            ctx.lineWidth = 16;
            ctx.strokeRect(8, 8, canvas.width - 16, canvas.height - 16);

            // Top header bar
            ctx.fillStyle = hexStr;
            ctx.fillRect(16, 16, canvas.width - 32, 78);

            ctx.fillStyle = '#ffffff';
            ctx.font = 'bold 34px Inter, sans-serif';
            ctx.textAlign = 'center';
            ctx.fillText(`${badgeText.toUpperCase()}  •  ${item.level.toUpperCase()}`, canvas.width / 2, 66);

            // Wrapped Course / Activity Title on Wall
            ctx.fillStyle = '#ffffff';
            ctx.font = 'bold 48px Fredoka, Inter, sans-serif';
            const words = item.title.split(' ');
            let line = '';
            const lines = [];
            for (let i = 0; i < words.length; i++) {
                const testLine = line + words[i] + ' ';
                if (ctx.measureText(testLine).width > 660 && i > 0) {
                    lines.push(line.trim());
                    line = words[i] + ' ';
                } else {
                    line = testLine;
                }
            }
            lines.push(line.trim());

            const startY = lines.length === 1 ? 215 : 185;
            lines.forEach((l, idx) => {
                ctx.fillText(l, canvas.width / 2, startY + idx * 62);
            });

            // Reward pill
            ctx.fillStyle = '#facc15';
            ctx.font = 'bold 38px Fredoka, Inter, sans-serif';
            ctx.fillText(`Reward: ${item.xp}`, canvas.width / 2, 345);

            // Bottom CTA Button drawn on board
            ctx.fillStyle = '#10b981';
            ctx.fillRect(154, 392, 460, 76);
            ctx.fillStyle = '#052e16';
            ctx.font = 'bold 34px Inter, sans-serif';
            ctx.fillText('PRESS [E] OR CLICK BOARD', canvas.width / 2, 441);

            const tex = new THREE.CanvasTexture(canvas);
            tex.needsUpdate = true;
            return tex;
        }

