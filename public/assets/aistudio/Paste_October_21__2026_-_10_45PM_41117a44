<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>EraEnglish Town - 3D Interactive Learning World</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tone/14.8.49/Tone.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    
    <style>
        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            font-family: 'Inter', sans-serif;
            background-color: #111827;
            user-select: none;
            -webkit-user-select: none;
            touch-action: none;
        }
        .font-game {
            font-family: 'Fredoka', sans-serif;
        }
        #game-canvas {
            display: block;
            width: 100%;
            height: 100%;
            touch-action: none;
            cursor: grab;
        }
        #game-canvas:active {
            cursor: grabbing;
        }
        /* Roblox-style glossy buttons */
        .rbx-btn {
            transition: all 0.15s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 4px 0 rgba(0,0,0,0.3);
        }
        .rbx-btn:active {
            transform: translateY(4px);
            box-shadow: 0 0px 0 rgba(0,0,0,0.3);
        }
        /* Floating 3D labels */
        .world-label {
            position: absolute;
            transform: translate(-50%, -100%);
            pointer-events: none;
            transition: opacity 0.2s;
            z-index: 10;
        }
        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #1f2937;
            border-radius: 8px;
        }
        ::-webkit-scrollbar-thumb {
            background: #4b5563;
            border-radius: 8px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #6b7280;
        }
        @keyframes pulse-ring {
            0% { transform: scale(0.95); opacity: 0.8; }
            50% { transform: scale(1.05); opacity: 1; }
            100% { transform: scale(0.95); opacity: 0.8; }
        }
        .animate-pulse-slow {
            animation: pulse-ring 2.5s infinite ease-in-out;
        }
    </style>
</head>
<body class="relative">

    <canvas id="game-canvas"></canvas>
    <div id="labels-container" class="absolute inset-0 pointer-events-none overflow-hidden z-10"></div>

    <header class="absolute top-0 left-0 right-0 p-3 sm:p-4 flex flex-wrap justify-between items-center gap-2 z-20 pointer-events-none">
        <!-- Brand & Player Info -->
        <div class="flex items-center gap-3 bg-gray-900/85 backdrop-blur-md border-2 border-white/15 px-3.5 py-2 rounded-2xl pointer-events-auto shadow-xl">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center text-white font-game text-xl font-bold shadow-inner">
                E
            </div>
            <div>
                <div class="flex items-center gap-2">
                    <h1 class="font-game text-white font-bold text-base sm:text-lg tracking-wide leading-none">EraEnglish Town</h1>
                    <span class="bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 text-[10px] font-bold px-2 py-0.5 rounded-full uppercase">Online</span>
                </div>
                <p id="hud-student-name" class="text-xs text-gray-300 font-medium mt-0.5">Student: Explorer_01</p>
            </div>
        </div>

        <!-- Stats & Quick Portal Bar -->
        <div class="flex items-center gap-2 sm:gap-3 pointer-events-auto">
            <!-- XP & Coins -->
            <div class="hidden sm:flex items-center gap-3 bg-gray-900/85 backdrop-blur-md border-2 border-white/15 px-4 py-2 rounded-2xl text-white shadow-xl">
                <div class="flex items-center gap-1.5">
                    <i class="fa-solid fa-star text-amber-400"></i>
                    <span id="hud-xp" class="font-game font-bold text-sm">150 XP</span>
                </div>
                <div class="w-px h-4 bg-white/20"></div>
                <div class="flex items-center gap-1.5">
                    <i class="fa-solid fa-coins text-yellow-400"></i>
                    <span id="hud-coins" class="font-game font-bold text-sm">50</span>
                </div>
            </div>

            <!-- Day / Sunset Theme Toggle -->
            <button onclick="toggleSkyTheme()" class="rbx-btn bg-indigo-600 hover:bg-indigo-500 text-white font-game font-semibold px-3 py-2 rounded-xl border border-indigo-400/40 flex items-center gap-1.5 text-sm" title="Switch Day / Sunset">
                <i id="sky-icon" class="fa-solid fa-sun text-amber-300"></i>
            </button>

            <!-- Customize Avatar Button -->
            <button onclick="openAvatarModal()" class="rbx-btn bg-purple-600 hover:bg-purple-500 text-white font-game font-semibold px-3.5 py-2 rounded-xl border border-purple-400/40 flex items-center gap-2 text-sm">
                <i class="fa-solid fa-shirt"></i>
                <span class="hidden md:inline">Avatar</span>
            </button>

            <!-- Map Teleport Menu -->
            <button onclick="openMapModal()" class="rbx-btn bg-sky-600 hover:bg-sky-500 text-white font-game font-semibold px-3.5 py-2 rounded-xl border border-sky-400/40 flex items-center gap-2 text-sm">
                <i class="fa-solid fa-map-location-dot"></i>
                <span class="hidden md:inline">Town Map</span>
            </button>

            <!-- Exit Building Button (Shown Only When Inside a Building) -->
            <button id="hud-exit-building-btn" onclick="exitBuildingInterior()" class="hidden rbx-btn bg-rose-600 hover:bg-rose-500 text-white font-game font-bold px-3.5 py-2 rounded-xl border border-rose-300/40 flex items-center gap-2 text-sm shadow-lg">
                <i class="fa-solid fa-door-open"></i>
                <span>Exit Building</span>
            </button>

            <!-- Direct Website Link -->
            <a href="https://www.eraenglish.online" target="_blank" rel="noopener noreferrer" class="rbx-btn bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-400 hover:to-teal-500 text-white font-game font-bold px-4 py-2 rounded-xl border border-emerald-300/40 flex items-center gap-2 text-sm shadow-lg">
                <i class="fa-solid fa-globe"></i>
                <span>eraenglish.online</span>
                <i class="fa-solid fa-arrow-up-right-from-square text-xs opacity-80"></i>
            </a>
        </div>
    </header>

    <!-- Interior Room Banner (Visible when inside a building) -->
    <div id="interior-room-banner" class="hidden absolute top-20 left-4 z-20 pointer-events-none">
        <div class="bg-gray-900/90 backdrop-blur-md border-2 border-sky-400/50 px-4 py-2.5 rounded-2xl text-white shadow-xl flex items-center gap-3">
            <div id="interior-banner-icon" class="w-9 h-9 rounded-xl bg-sky-500/20 border border-sky-400/40 flex items-center justify-center text-sky-300 text-lg">
                <i class="fa-solid fa-building-columns"></i>
            </div>
            <div>
                <div class="text-[10px] font-bold uppercase tracking-wider text-sky-300">Inside 3D Classroom</div>
                <div id="interior-banner-title" class="font-game font-bold text-sm sm:text-base leading-tight">Courses Academy Interior</div>
                <div class="text-[11px] text-gray-300">Walk to any <span class="text-amber-300 font-semibold">Wall Board</span> or click it to open!</div>
            </div>
        </div>
    </div>

    <!-- Center Proximity Interaction Banner -->
    <div id="interaction-prompt" class="hidden absolute top-24 left-1/2 -translate-x-1/2 z-20 pointer-events-auto">
        <button id="interaction-btn" onclick="triggerCurrentZone()" class="animate-pulse-slow rbx-btn bg-gray-900/95 hover:bg-black text-white border-2 border-amber-400 px-6 py-3 rounded-2xl shadow-2xl flex items-center gap-3">
            <span class="w-8 h-8 rounded-lg bg-amber-400 text-gray-900 font-game font-bold flex items-center justify-center text-base shadow">E</span>
            <div class="text-left">
                <div id="prompt-title" class="font-game font-bold text-base text-amber-300 leading-tight">Enter Courses Academy</div>
                <div class="text-[11px] text-gray-300">Tap or Press [E] to interact</div>
            </div>
        </button>
    </div>

    <!-- Left Roblox-Style Chat & Quest Feed -->
    <div class="absolute bottom-32 sm:bottom-5 left-3 sm:left-4 w-64 sm:w-80 z-20 pointer-events-none flex flex-col gap-2">
        <!-- Daily Quest Card -->
        <div class="bg-gray-900/80 backdrop-blur-md border border-white/15 rounded-2xl p-3 text-white pointer-events-auto shadow-lg">
            <div class="flex items-center justify-between mb-1.5">
                <span class="text-xs font-game font-bold uppercase tracking-wider text-amber-400 flex items-center gap-1.5">
                    <i class="fa-solid fa-scroll"></i> Campus Quest
                </span>
                <span id="quest-progress" class="text-xs bg-white/10 px-2 py-0.5 rounded-full font-semibold">0/6 Visited</span>
            </div>
            <p class="text-xs text-gray-200 leading-relaxed">Explore all 6 EraEnglish buildings across the expanded campus & climb the Obby Word Tower!</p>
        </div>

        <!-- Chat Box -->
        <div class="hidden sm:flex flex-col bg-gray-900/80 backdrop-blur-md border border-white/15 rounded-2xl p-3 text-white pointer-events-auto shadow-lg h-40">
            <div id="chat-messages" class="flex-1 overflow-y-auto space-y-1.5 text-xs pr-1">
                <div><span class="font-bold text-emerald-400">[System]:</span> Swipe or drag anywhere on the screen to pan 360° around your character!</div>
                <div><span class="font-bold text-sky-400">[Coach Alex]:</span> Check out the new Grammar Library and Student Lounge!</div>
                <div><span class="font-bold text-amber-400">[Mia_Student]:</span> Just reached the top of the Obby Parkour Tower! 🏆</div>
            </div>
            <form onsubmit="sendChatMessage(event)" class="mt-2 flex gap-1.5">
                <input id="chat-input" type="text" placeholder="Say something in English..." class="flex-1 bg-gray-800/90 border border-white/15 rounded-xl px-3 py-1.5 text-xs text-white focus:outline-none focus:border-sky-400">
                <button type="submit" class="bg-sky-600 hover:bg-sky-500 px-3 py-1.5 rounded-xl text-xs font-bold"><i class="fa-solid fa-paper-plane"></i></button>
            </form>
        </div>
    </div>

    <!-- Bottom Controls: Virtual Analog Thumbstick + Sprint + Jump + Camera Reset -->
    <div class="absolute bottom-4 right-4 z-20 flex items-end gap-3 sm:gap-4 pointer-events-none">
        <!-- Controls Hint (Desktop) -->
        <div class="hidden xl:flex flex-col bg-gray-900/80 backdrop-blur-md border border-white/15 rounded-2xl p-3 text-xs text-gray-300 pointer-events-auto shadow-lg">
            <div class="font-game font-bold text-white mb-1 flex items-center gap-1.5">
                <i class="fa-solid fa-gamepad text-sky-400"></i> Controls & 360° Camera
            </div>
            <div><span class="text-white font-semibold">Touch / Mouse Drag:</span> Pan 360° Camera</div>
            <div><span class="text-white font-semibold">W, A, S, D / Joystick:</span> Move Student</div>
            <div><span class="text-white font-semibold">Shift / Sprint:</span> Fast Run</div>
            <div><span class="text-white font-semibold">Scroll Wheel:</span> Zoom In/Out</div>
        </div>

        <!-- Interactive Analog Joystick + Action Buttons -->
        <div class="flex items-center gap-3 pointer-events-auto">
            <!-- Smooth 360° Touch/Mouse Virtual Joystick -->
            <div id="joystick-zone" class="relative w-28 h-28 rounded-full bg-gray-900/75 backdrop-blur-md border-2 border-white/20 shadow-2xl flex items-center justify-center touch-none">
                <div class="absolute inset-2 rounded-full border border-white/10 pointer-events-none"></div>
                <i class="fa-solid fa-caret-up absolute top-2 text-white/30 text-xs pointer-events-none"></i>
                <i class="fa-solid fa-caret-down absolute bottom-2 text-white/30 text-xs pointer-events-none"></i>
                <i class="fa-solid fa-caret-left absolute left-2 text-white/30 text-xs pointer-events-none"></i>
                <i class="fa-solid fa-caret-right absolute right-2 text-white/30 text-xs pointer-events-none"></i>
                <div id="joystick-knob" class="w-12 h-12 rounded-full bg-gradient-to-br from-sky-400 to-blue-600 border-2 border-white shadow-lg flex items-center justify-center text-white pointer-events-none transition-transform duration-75">
                    <i class="fa-solid fa-arrows-up-down-left-right text-xs"></i>
                </div>
            </div>

            <!-- Action Buttons Column -->
            <div class="flex flex-col gap-2">
                <div class="flex gap-2">
                    <button id="sprint-btn" onclick="toggleSprint()" class="rbx-btn w-12 h-11 rounded-xl bg-gray-800/90 hover:bg-gray-700 text-white font-game font-bold flex flex-col items-center justify-center border border-white/15 shadow-lg" title="Toggle Sprint">
                        <i class="fa-solid fa-bolt text-amber-400 text-sm"></i>
                        <span class="text-[9px] uppercase">Run</span>
                    </button>
                    <button onclick="resetCameraBehindPlayer()" class="rbx-btn w-12 h-11 rounded-xl bg-gray-800/90 hover:bg-gray-700 text-white font-game font-bold flex flex-col items-center justify-center border border-white/15 shadow-lg" title="Center Camera Behind Student">
                        <i class="fa-solid fa-video text-sky-400 text-sm"></i>
                        <span class="text-[9px] uppercase">View</span>
                    </button>
                </div>
                <button onclick="playerJump()" class="rbx-btn w-full h-14 rounded-2xl bg-gradient-to-b from-amber-400 to-amber-500 text-gray-900 font-game font-bold flex flex-col items-center justify-center shadow-xl border-2 border-amber-200">
                    <i class="fa-solid fa-arrow-up text-base"></i>
                    <span class="text-[11px] uppercase">Jump</span>
                </button>
            </div>
        </div>
    </div>

    <div id="building-modal" class="hidden fixed inset-0 bg-black/75 backdrop-blur-sm z-40 flex items-center justify-center p-4">
        <div class="bg-gray-900 border-2 border-white/20 rounded-3xl max-w-2xl w-full overflow-hidden shadow-2xl animate-fadeIn">
            <!-- Modal Header -->
            <div id="modal-header" class="bg-gradient-to-r from-blue-600 to-indigo-700 p-5 flex items-center justify-between text-white">
                <div class="flex items-center gap-3">
                    <div id="modal-icon" class="w-12 h-12 rounded-2xl bg-white/20 flex items-center justify-center text-2xl shadow-inner">
                        <i class="fa-solid fa-graduation-cap"></i>
                    </div>
                    <div>
                        <span id="modal-badge" class="text-[11px] uppercase tracking-wider font-bold bg-black/30 px-2.5 py-0.5 rounded-full">Official Portal</span>
                        <h2 id="modal-title" class="font-game text-2xl font-bold mt-0.5">Courses Academy</h2>
                    </div>
                </div>
                <button onclick="closeBuildingModal()" class="w-10 h-10 rounded-xl bg-black/25 hover:bg-black/40 flex items-center justify-center text-white text-lg">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <!-- Modal Body -->
            <div class="p-6 text-white space-y-5 max-h-[75vh] overflow-y-auto">
                <p id="modal-desc" class="text-gray-300 text-sm leading-relaxed"></p>

                <!-- Dynamic Feature Cards or Mini-Quiz Container -->
                <div id="modal-content-area" class="space-y-3"></div>

                <!-- Primary Call-to-Action Link to www.eraenglish.online -->
                <div class="bg-gradient-to-r from-emerald-900/60 to-teal-900/60 border border-emerald-500/40 rounded-2xl p-4 flex flex-col sm:flex-row items-center justify-between gap-4">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-emerald-500/20 border border-emerald-400/40 flex items-center justify-center text-emerald-300 text-lg shrink-0">
                            <i class="fa-solid fa-up-right-from-square"></i>
                        </div>
                        <div>
                            <div class="font-game font-bold text-white text-base">Sync with EraEnglish Online Portal</div>
                            <div class="text-xs text-emerald-200">Launch full dashboard at <span class="underline font-semibold">www.eraenglish.online</span></div>
                        </div>
                    </div>
                    <a id="modal-external-link" href="https://www.eraenglish.online" target="_blank" rel="noopener noreferrer" class="rbx-btn w-full sm:w-auto text-center bg-emerald-500 hover:bg-emerald-400 text-gray-950 font-game font-bold px-5 py-2.5 rounded-xl text-sm shrink-0">
                        Open on EraEnglish.online <i class="fa-solid fa-arrow-right ml-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Avatar Customizer Modal -->
    <div id="avatar-modal" class="hidden fixed inset-0 bg-black/75 backdrop-blur-sm z-40 flex items-center justify-center p-4">
        <div class="bg-gray-900 border-2 border-white/20 rounded-3xl max-w-md w-full p-6 text-white shadow-2xl space-y-5">
            <div class="flex items-center justify-between border-b border-white/10 pb-3">
                <h3 class="font-game text-xl font-bold flex items-center gap-2">
                    <i class="fa-solid fa-user-astronaut text-purple-400"></i> Customize Student Character
                </h3>
                <button onclick="closeAvatarModal()" class="w-8 h-8 rounded-lg bg-white/10 hover:bg-white/20 flex items-center justify-center">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="space-y-4">
                <div>
                    <label class="text-xs font-bold uppercase text-gray-400 block mb-1.5">Student Display Name</label>
                    <input id="avatar-name-input" type="text" maxlength="16" value="Explorer_01" class="w-full bg-gray-800 border border-white/15 rounded-xl px-3.5 py-2 text-sm text-white focus:outline-none focus:border-purple-400">
                </div>

                <div>
                    <label class="text-xs font-bold uppercase text-gray-400 block mb-1.5">Uniform Shirt Color</label>
                    <div class="flex gap-2.5">
                        <button onclick="setAvatarColor('shirt', 0x3b82f6)" class="w-9 h-9 rounded-xl bg-blue-500 border-2 border-white shadow"></button>
                        <button onclick="setAvatarColor('shirt', 0xef4444)" class="w-9 h-9 rounded-xl bg-red-500 border-2 border-white shadow"></button>
                        <button onclick="setAvatarColor('shirt', 0x10b981)" class="w-9 h-9 rounded-xl bg-emerald-500 border-2 border-white shadow"></button>
                        <button onclick="setAvatarColor('shirt', 0xf59e0b)" class="w-9 h-9 rounded-xl bg-amber-500 border-2 border-white shadow"></button>
                        <button onclick="setAvatarColor('shirt', 0x8b5cf6)" class="w-9 h-9 rounded-xl bg-purple-500 border-2 border-white shadow"></button>
                        <button onclick="setAvatarColor('shirt', 0xec4899)" class="w-9 h-9 rounded-xl bg-pink-500 border-2 border-white shadow"></button>
                    </div>
                </div>

                <div>
                    <label class="text-xs font-bold uppercase text-gray-400 block mb-1.5">Pants Color</label>
                    <div class="flex gap-2.5">
                        <button onclick="setAvatarColor('pants', 0x1e293b)" class="w-9 h-9 rounded-xl bg-slate-800 border-2 border-white shadow"></button>
                        <button onclick="setAvatarColor('pants', 0x1d4ed8)" class="w-9 h-9 rounded-xl bg-blue-700 border-2 border-white shadow"></button>
                        <button onclick="setAvatarColor('pants', 0x047857)" class="w-9 h-9 rounded-xl bg-emerald-700 border-2 border-white shadow"></button>
                        <button onclick="setAvatarColor('pants', 0x7c2d12)" class="w-9 h-9 rounded-xl bg-amber-900 border-2 border-white shadow"></button>
                    </div>
                </div>
            </div>

            <button onclick="saveAvatarChanges()" class="rbx-btn w-full bg-purple-600 hover:bg-purple-500 text-white font-game font-bold py-3 rounded-xl">
                Save Student Style
            </button>
        </div>
    </div>

    <!-- Fast Travel Town Map Modal -->
    <div id="map-modal" class="hidden fixed inset-0 bg-black/75 backdrop-blur-sm z-40 flex items-center justify-center p-4">
        <div class="bg-gray-900 border-2 border-white/20 rounded-3xl max-w-xl w-full p-6 text-white shadow-2xl space-y-4">
            <div class="flex items-center justify-between border-b border-white/10 pb-3">
                <h3 class="font-game text-xl font-bold flex items-center gap-2">
                    <i class="fa-solid fa-map-location-dot text-sky-400"></i> Expanded EraEnglish Town Map
                </h3>
                <button onclick="closeMapModal()" class="w-8 h-8 rounded-lg bg-white/10 hover:bg-white/20 flex items-center justify-center">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <p class="text-xs text-gray-300">Click any campus landmark to teleport your student character immediately:</p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 max-h-[60vh] overflow-y-auto pr-1">
                <button onclick="teleportTo(0, -34)" class="rbx-btn bg-blue-600/30 hover:bg-blue-600/50 border border-blue-400/40 p-3 rounded-2xl text-left flex items-center gap-3">
                    <i class="fa-solid fa-graduation-cap text-2xl text-blue-400 w-8 text-center"></i>
                    <div>
                        <div class="font-game font-bold text-sm">Courses Academy (North)</div>
                        <div class="text-[11px] text-gray-300">Live Lessons & Core Modules</div>
                    </div>
                </button>
                <button onclick="teleportTo(38, 0)" class="rbx-btn bg-amber-600/30 hover:bg-amber-600/50 border border-amber-400/40 p-3 rounded-2xl text-left flex items-center gap-3">
                    <i class="fa-solid fa-book-open-reader text-2xl text-amber-400 w-8 text-center"></i>
                    <div>
                        <div class="font-game font-bold text-sm">Homework Hub (East)</div>
                        <div class="text-[11px] text-gray-300">Daily Assignments & Tasks</div>
                    </div>
                </button>
                <button onclick="teleportTo(-38, 0)" class="rbx-btn bg-rose-600/30 hover:bg-rose-600/50 border border-rose-400/40 p-3 rounded-2xl text-left flex items-center gap-3">
                    <i class="fa-solid fa-trophy text-2xl text-rose-400 w-8 text-center"></i>
                    <div>
                        <div class="font-game font-bold text-sm">Practice Test Arena (West)</div>
                        <div class="text-[11px] text-gray-300">Mock Exams & Live Quizzes</div>
                    </div>
                </button>
                <button onclick="teleportTo(0, 34)" class="rbx-btn bg-emerald-600/30 hover:bg-emerald-600/50 border border-emerald-400/40 p-3 rounded-2xl text-left flex items-center gap-3">
                    <i class="fa-solid fa-comments text-2xl text-emerald-400 w-8 text-center"></i>
                    <div>
                        <div class="font-game font-bold text-sm">Speaking & Word Park (South)</div>
                        <div class="text-[11px] text-gray-300">Flashcards & Speaking Club</div>
                    </div>
                </button>
                <button onclick="teleportTo(-34, -34)" class="rbx-btn bg-purple-600/30 hover:bg-purple-600/50 border border-purple-400/40 p-3 rounded-2xl text-left flex items-center gap-3">
                    <i class="fa-solid fa-book-atlas text-2xl text-purple-400 w-8 text-center"></i>
                    <div>
                        <div class="font-game font-bold text-sm">Grammar & Reading Library (NW)</div>
                        <div class="text-[11px] text-gray-300">E-Books & Grammar Guides</div>
                    </div>
                </button>
                <button onclick="teleportTo(34, -34)" class="rbx-btn bg-cyan-600/30 hover:bg-cyan-600/50 border border-cyan-400/40 p-3 rounded-2xl text-left flex items-center gap-3">
                    <i class="fa-solid fa-mug-hot text-2xl text-cyan-400 w-8 text-center"></i>
                    <div>
                        <div class="font-game font-bold text-sm">Video & Student Lounge (NE)</div>
                        <div class="text-[11px] text-gray-300">Community & Study Videos</div>
                    </div>
