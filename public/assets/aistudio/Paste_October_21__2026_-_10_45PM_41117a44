        function setupInputListeners() {
            window.addEventListener('keydown', (e) => {
                if (document.activeElement.tagName === 'INPUT') return;
                const k = e.key.toLowerCase();
                if (k === 'w' || e.key === 'ArrowUp') keys.up = true;
                if (k === 's' || e.key === 'ArrowDown') keys.down = true;
                if (k === 'a' || e.key === 'ArrowLeft') keys.left = true;
                if (k === 'd' || e.key === 'ArrowRight') keys.right = true;
                if (e.key === 'Shift') toggleSprint(true);
                if (e.code === 'Space') playerJump();
                if (k === 'e' && gameState.activeZone) triggerCurrentZone();
            });

            window.addEventListener('keyup', (e) => {
                const k = e.key.toLowerCase();
                if (k === 'w' || e.key === 'ArrowUp') keys.up = false;
                if (k === 's' || e.key === 'ArrowDown') keys.down = false;
                if (k === 'a' || e.key === 'ArrowLeft') keys.left = false;
                if (k === 'd' || e.key === 'ArrowRight') keys.right = false;
                if (e.key === 'Shift') toggleSprint(false);
            });

            // 1. Virtual Analog Joystick (Multi-touch & Mouse Compatible)
            const joyZone = document.getElementById('joystick-zone');
            const joyKnob = document.getElementById('joystick-knob');
            let joyPointerId = null;
            const maxRadius = 36;

            const updateJoystick = (clientX, clientY) => {
                const rect = joyZone.getBoundingClientRect();
                const centerX = rect.left + rect.width / 2;
                const centerY = rect.top + rect.height / 2;
                let dx = clientX - centerX;
                let dy = clientY - centerY;
                const dist = Math.hypot(dx, dy);
                if (dist > maxRadius) {
                    dx = (dx / dist) * maxRadius;
                    dy = (dy / dist) * maxRadius;
                }
                joyKnob.style.transform = `translate(${dx}px, ${dy}px)`;
                joyVector.x = dx / maxRadius;
                joyVector.y = dy / maxRadius;
            };

            const resetJoystick = () => {
                joyPointerId = null;
                joyKnob.style.transform = 'translate(0px, 0px)';
                joyVector.x = 0;
                joyVector.y = 0;
            };

            joyZone.addEventListener('pointerdown', (e) => {
                e.stopPropagation();
                joyPointerId = e.pointerId;
                joyZone.setPointerCapture(e.pointerId);
                updateJoystick(e.clientX, e.clientY);
            });

            joyZone.addEventListener('pointermove', (e) => {
                if (e.pointerId === joyPointerId) {
                    e.stopPropagation();
                    updateJoystick(e.clientX, e.clientY);
                }
            });

            const endJoy = (e) => {
                if (e.pointerId === joyPointerId) {
                    e.stopPropagation();
                    resetJoystick();
                }
            };
            joyZone.addEventListener('pointerup', endJoy);
            joyZone.addEventListener('pointercancel', endJoy);

            // 2. Full 360° Touch & Mouse Camera Panning on Canvas + Clicking 3D Wall Boards
            const canvas = document.getElementById('game-canvas');
            let pointerDownPos = { x: 0, y: 0 };

            canvas.addEventListener('pointerdown', (e) => {
                isDraggingCamera = true;
                activeCameraPointerId = e.pointerId;
                prevPointer = { x: e.clientX, y: e.clientY };
                pointerDownPos = { x: e.clientX, y: e.clientY };
                canvas.setPointerCapture(e.pointerId);
            });

            canvas.addEventListener('pointermove', (e) => {
                if (!isDraggingCamera || e.pointerId !== activeCameraPointerId) return;
                const dx = e.clientX - prevPointer.x;
                const dy = e.clientY - prevPointer.y;
                // Smooth 360 horizontal pan & vertical tilt
                targetCameraAngle -= dx * 0.0085;
                targetCameraPitch = Math.max(0.08, Math.min(1.25, targetCameraPitch + dy * 0.0065));
                prevPointer = { x: e.clientX, y: e.clientY };
            });

            const endCameraPan = (e) => {
                if (e.pointerId === activeCameraPointerId) {
                    const moveDist = Math.hypot(e.clientX - pointerDownPos.x, e.clientY - pointerDownPos.y);
                    // If user tapped/clicked without dragging, check if they clicked an interior 3D Wall Board
                    if (moveDist < 8 && gameState.insideZone && clickableWallMeshes.length > 0) {
                        const rect = canvas.getBoundingClientRect();
                        pointerNDC.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
                        pointerNDC.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;
                        raycaster.setFromCamera(pointerNDC, camera);
                        const hits = raycaster.intersectObjects(clickableWallMeshes, false);
                        if (hits.length > 0 && hits[0].object.userData.item) {
                            const { zone, item } = hits[0].object.userData;
                            openWallItemModal(zone, item);
                        }
                    }
                    isDraggingCamera = false;
                    activeCameraPointerId = null;
                }
            };
            canvas.addEventListener('pointerup', endCameraPan);
            canvas.addEventListener('pointercancel', endCameraPan);

            // 3. Mouse Wheel Zoom In/Out
            canvas.addEventListener('wheel', (e) => {
                e.preventDefault();
                cameraDistance = Math.max(8, Math.min(34, cameraDistance + e.deltaY * 0.015));
            }, { passive: false });
        }

        function toggleSprint(forceState) {
            isSprinting = typeof forceState === 'boolean' ? forceState : !isSprinting;
            const btn = document.getElementById('sprint-btn');
            if (isSprinting) {
                btn.classList.add('ring-2', 'ring-amber-400', 'bg-amber-500/30');
            } else {
                btn.classList.remove('ring-2', 'ring-amber-400', 'bg-amber-500/30');
            }
        }

        function resetCameraBehindPlayer() {
            // Align camera directly behind the direction the student character is facing
            targetCameraAngle = playerGroup.rotation.y + Math.PI;
            targetCameraPitch = 0.42;
            showToast('Camera centered behind your student!');
        }

        function toggleSkyTheme() {
            isSunset = !isSunset;
            const icon = document.getElementById('sky-icon');
            if (isSunset) {
                scene.background.setHex(0xf97316);
                scene.fog.color.setHex(0xf97316);
                ambientLight.color.setHex(0xfed7aa);
                dirLight.color.setHex(0xfb923c);
                icon.className = 'fa-solid fa-moon text-indigo-200';
                showToast('Switched to Golden Sunset Campus!');
            } else {
                scene.background.setHex(0x7dd3fc);
                scene.fog.color.setHex(0x7dd3fc);
                ambientLight.color.setHex(0xffffff);
                dirLight.color.setHex(0xfffbeb);
                icon.className = 'fa-solid fa-sun text-amber-300';
                showToast('Switched to Sunny Day Campus!');
            }
        }

        function playerJump() {
            if (isGrounded) {
                playerVelocityY = 0.31;
                isGrounded = false;
                playSound('jump');
            }
        }

        function teleportTo(x, z) {
            if (gameState.insideZone) {
                exitBuildingInterior();
            }
            playerGroup.position.set(x, 0, z);
            playerVelocityY = 0;
            closeMapModal();
            showToast('Teleported across EraEnglish Town!');
        }

        function triggerCurrentZone() {
            // 1. If inside a building and standing at the Exit Door
            if (gameState.insideZone && gameState.activeExitDoor) {
                exitBuildingInterior();
                return;
            }
            // 2. If inside a building and standing in front of a Wall Board
            if (gameState.insideZone && gameState.activeWallItem) {
                openWallItemModal(gameState.activeWallItem.zone, gameState.activeWallItem.item);
                return;
            }
            // 3. If outdoors in front of a building entrance, step inside its 3D Room!
            if (gameState.activeZone) {
                enterBuildingInterior(gameState.activeZone);
            }
        }

        function openWallItemModal(zone, selectedItem) {
            playSound('portal');

            document.getElementById('modal-header').className = `bg-gradient-to-r ${zone.headerClass} p-5 flex items-center justify-between text-white`;
            document.getElementById('modal-icon').innerHTML = `<i class="fa-solid ${zone.icon}"></i>`;
            document.getElementById('modal-badge').textContent = `${zone.name} • ${selectedItem.level}`;
            document.getElementById('modal-title').textContent = selectedItem.title;
            document.getElementById('modal-desc').textContent = zone.description;
            document.getElementById('modal-external-link').href = selectedItem.link || zone.url;

            const contentArea = document.getElementById('modal-content-area');
            contentArea.innerHTML = '';

            if (zone.isQuiz || selectedItem.isQuizBoard) {
                renderQuizQuestion(contentArea);
            } else {
                const card = document.createElement('div');
                card.className = 'bg-gray-800/95 border-2 border-sky-400/40 rounded-2xl p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-xl';
                card.innerHTML = `
                    <div class="space-y-1">
                        <div class="flex items-center gap-2">
                            <span class="font-game font-bold text-white text-lg">${selectedItem.title}</span>
                            <span class="text-xs bg-sky-500/20 text-sky-300 border border-sky-400/30 px-2.5 py-0.5 rounded-full font-semibold">${selectedItem.level}</span>
                        </div>
                        <p class="text-xs text-gray-300">Ready to start this module on <span class="text-emerald-300 font-semibold">www.eraenglish.online</span> and earn ${selectedItem.xp}!</p>
                    </div>
                    <div class="flex items-center gap-3 shrink-0">
                        <span class="text-sm font-game font-bold text-amber-400 bg-amber-400/10 border border-amber-400/30 px-3 py-1.5 rounded-xl">${selectedItem.xp}</span>
                        <a href="${selectedItem.link}" target="_blank" rel="noopener noreferrer" onclick="addReward(30, 10, 'Launched ${selectedItem.title.replace(/'/g, '')}!')" class="rbx-btn bg-blue-600 hover:bg-blue-500 text-white text-sm font-game font-bold px-5 py-2.5 rounded-xl">
                            Enter Module <i class="fa-solid fa-arrow-up-right-from-square ml-1"></i>
                        </a>
                    </div>
                `;
                contentArea.appendChild(card);
            }

            document.getElementById('building-modal').classList.remove('hidden');
        }

        function renderQuizQuestion(container) {
            const qObj = practiceQuestions[gameState.quizIndex % practiceQuestions.length];
            container.innerHTML = `
                <div class="bg-gray-800 border border-rose-500/30 rounded-2xl p-5 space-y-4">
                    <div class="flex justify-between items-center">
                        <span class="text-xs font-bold uppercase text-rose-400">Live Practice Test Challenge</span>
                        <span class="text-xs text-gray-400">Question ${(gameState.quizIndex % practiceQuestions.length) + 1} of ${practiceQuestions.length}</span>
                    </div>
                    <p class="font-game text-lg text-white">${qObj.q}</p>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                        ${qObj.options.map((opt, idx) => `
                            <button onclick="submitQuizAnswer(${idx}, ${qObj.answer})" class="rbx-btn bg-gray-700 hover:bg-rose-600 text-left px-4 py-3 rounded-xl text-sm font-semibold text-white border border-white/10">
                                ${String.fromCharCode(65 + idx)}. ${opt}
                            </button>
                        `).join('')}
                    </div>
                </div>
            `;
        }

        function submitQuizAnswer(selected, correct) {
            if (selected === correct) {
                gameState.quizIndex++;
                addReward(40, 15, 'Correct Answer! +40 XP & +15 Coins');
                renderQuizQuestion(document.getElementById('modal-content-area'));
            } else {
                showToast('Almost! Try another option.');
            }
        }

        function closeBuildingModal() {
            document.getElementById('building-modal').classList.add('hidden');
        }

        function openAvatarModal() {
            document.getElementById('avatar-modal').classList.remove('hidden');
        }
        function closeAvatarModal() {
            document.getElementById('avatar-modal').classList.add('hidden');
        }
        function setAvatarColor(part, hex) {
            if (part === 'shirt') shirtMesh.material.color.setHex(hex);
            if (part === 'pants') {
                pantsLeftMesh.material.color.setHex(hex);
                pantsRightMesh.material.color.setHex(hex);
            }
        }
        function saveAvatarChanges() {
            const val = document.getElementById('avatar-name-input').value.trim() || 'Explorer_01';
            gameState.studentName = val;
            document.getElementById('hud-student-name').textContent = `Student: ${val}`;
            closeAvatarModal();
            showToast('Avatar Updated!');
        }

        function openMapModal() {
            document.getElementById('map-modal').classList.remove('hidden');
        }
        function closeMapModal() {
            document.getElementById('map-modal').classList.add('hidden');
        }

        function addReward(xp, coins, msg) {
            gameState.xp += xp;
            gameState.coins += coins;
            document.getElementById('hud-xp').textContent = `${gameState.xp} XP`;
            document.getElementById('hud-coins').textContent = `${gameState.coins}`;
            playSound('reward');
            showToast(msg);
        }

        function showToast(message) {
            const toast = document.getElementById('toast');
            document.getElementById('toast-text').textContent = message;
            toast.classList.remove('hidden');
            clearTimeout(window.toastTimer);
            window.toastTimer = setTimeout(() => toast.classList.add('hidden'), 3000);
        }

        function sendChatMessage(e) {
            e.preventDefault();
            const input = document.getElementById('chat-input');
            const text = input.value.trim();
            if (!text) return;
            const box = document.getElementById('chat-messages');
            const line = document.createElement('div');
            line.innerHTML = `<span class="font-bold text-purple-400">[${gameState.studentName}]:</span> ${text.replace(/</g, '&lt;')}`;
            box.appendChild(line);
            box.scrollTop = box.scrollHeight;
            input.value = '';
        }

        function onWindowResize() {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        }

        const clock = new THREE.Clock();

        function animate() {
            requestAnimationFrame(animate);
            const elapsedTime = clock.getElapsedTime();

            // Smoothly interpolate camera pan angles
            cameraAngle += (targetCameraAngle - cameraAngle) * 0.18;
            cameraPitch += (targetCameraPitch - cameraPitch) * 0.18;

            // 1. Player Movement (Keyboard + Smooth Analog Joystick)
            const baseSpeed = isSprinting ? 0.36 : 0.24;
            let moveX = joyVector.x;
            let moveZ = joyVector.y;

            if (keys.up) moveZ -= 1;
            if (keys.down) moveZ += 1;
            if (keys.left) moveX -= 1;
            if (keys.right) moveX += 1;

            const moveMag = Math.hypot(moveX, moveZ);
            const isMoving = moveMag > 0.05;

            if (isMoving) {
                const clampedMag = Math.min(1, moveMag);
                const normX = moveX / moveMag;
                const normZ = moveZ / moveMag;

                // Move relative to current 360° camera viewing angle
                const sin = Math.sin(cameraAngle);
                const cos = Math.cos(cameraAngle);
                const worldDX = normX * cos + normZ * sin;
                const worldDZ = -normX * sin + normZ * cos;

                const stepSpeed = baseSpeed * clampedMag;
                let nextX = playerGroup.position.x + worldDX * stepSpeed;
                let nextZ = playerGroup.position.z + worldDZ * stepSpeed;

                if (gameState.insideZone) {
                    // Clamp player smoothly inside the 3D classroom walls
                    nextX = Math.max(INTERIOR_ORIGIN.x - 16.2, Math.min(INTERIOR_ORIGIN.x + 16.2, nextX));
                    nextZ = Math.max(INTERIOR_ORIGIN.z - 13.0, Math.min(INTERIOR_ORIGIN.z + 13.2, nextZ));
                    playerGroup.position.x = nextX;
                    playerGroup.position.z = nextZ;
                } else {
                    nextX = Math.max(-108, Math.min(108, nextX));
                    nextZ = Math.max(-108, Math.min(108, nextZ));

                    // Circle collision check with outdoor buildings & trees
                    let blocked = false;
                    for (const col of colliders) {
                        if (Math.hypot(nextX - col.x, nextZ - col.z) < col.radius) {
                            blocked = true;
                            break;
                        }
                    }
                    if (!blocked) {
                        playerGroup.position.x = nextX;
                        playerGroup.position.z = nextZ;
                    }
                }

                // Smoothly rotate student character towards movement direction
                const targetRot = Math.atan2(worldDX, worldDZ);
                let diff = targetRot - playerGroup.rotation.y;
                while (diff < -Math.PI) diff += Math.PI * 2;
                while (diff > Math.PI) diff -= Math.PI * 2;
                playerGroup.rotation.y += diff * 0.22;

                // Roblox-style limb swing animation
                const swingSpeed = isSprinting ? 16 : 12;
                const swing = Math.sin(elapsedTime * swingSpeed) * 0.7;
                leftLeg.rotation.x = swing;
                rightLeg.rotation.x = -swing;
                leftArm.rotation.x = -swing;
                rightArm.rotation.x = swing;
            } else {
                leftLeg.rotation.x = 0;
                rightLeg.rotation.x = 0;
                leftArm.rotation.x = 0;
                rightArm.rotation.x = 0;
            }

            // 2. Jump, Gravity & Obby Platform Landing Physics
            let groundHeight = 0;
            for (const plat of platforms) {
                if (
                    playerGroup.position.x >= plat.minX &&
                    playerGroup.position.x <= plat.maxX &&
                    playerGroup.position.z >= plat.minZ &&
                    playerGroup.position.z <= plat.maxZ &&
                    playerGroup.position.y >= plat.topY - 0.55
                ) {
                    groundHeight = Math.max(groundHeight, plat.topY);
                }
            }

            playerGroup.position.y += playerVelocityY;
            if (playerGroup.position.y > groundHeight) {
                playerVelocityY -= 0.015;
                isGrounded = false;
            } else {
                playerGroup.position.y = groundHeight;
                playerVelocityY = 0;
                isGrounded = true;
            }

            // 3. Animate Floating Word Crystals & Check Collection
            floatingCrystals.forEach((crystal) => {
                crystal.rotation.y += 0.03;
                crystal.rotation.x += 0.01;
                if (crystal.userData && crystal.userData.word && !crystal.userData.collected) {
                    const dist = playerGroup.position.distanceTo(crystal.position);
                    if (dist < 2.5) {
                        crystal.userData.collected = true;
                        crystal.visible = false;
                        const xpGain = crystal.userData.xp || 25;
                        addReward(xpGain, 10, `Collected Word Crystal: "${crystal.userData.word}" (+${xpGain} XP)`);
                    }
                }
            });

            // 4. Animate Sky Clouds & Autonomous Classmates
            clouds.forEach((c) => {
                c.mesh.position.x += c.speed;
                if (c.mesh.position.x > 110) c.mesh.position.x = -110;
            });

            npcs.forEach((npc) => {
                const t = elapsedTime * 0.7 + npc.phase;
                const nextX = npc.baseX + Math.sin(t) * 5.5;
                const nextZ = npc.baseZ + Math.cos(t) * 5.5;
                const dx = nextX - npc.group.position.x;
                const dz = nextZ - npc.group.position.z;
                npc.group.position.set(nextX, 0, nextZ);
                npc.group.rotation.y = Math.atan2(dx, dz);
                const legSwing = Math.sin(elapsedTime * 7 + npc.phase) * 0.5;
                npc.lLeg.rotation.x = legSwing;
                npc.rLeg.rotation.x = -legSwing;
            });

            // 5. Check Proximity to Outdoor Building Portals OR Interior Wall Boards
            const promptBanner = document.getElementById('interaction-prompt');

            if (gameState.insideZone) {
                gameState.activeZone = null;
                gameState.activeWallItem = null;
                gameState.activeExitDoor = false;

                // Check if near the interior Exit Door
                const exitDist = Math.hypot(
                    playerGroup.position.x - INTERIOR_ORIGIN.x,
                    playerGroup.position.z - (INTERIOR_ORIGIN.z + 11.5)
                );

                if (exitDist < 3.4) {
                    gameState.activeExitDoor = true;
                    document.getElementById('prompt-title').textContent = 'Exit Back to Campus Plaza';
                    promptBanner.classList.remove('hidden');
                } else {
                    // Check if standing in front of any of the 3 Wall Boards
                    for (const wb of interiorWallBoards) {
                        const dist = Math.hypot(
                            playerGroup.position.x - wb.worldX,
                            playerGroup.position.z - wb.worldZ
                        );
                        if (dist < 3.6) {
                            gameState.activeWallItem = wb;
                            break;
                        }
                    }

                    if (gameState.activeWallItem) {
                        document.getElementById('prompt-title').textContent = `Open: ${gameState.activeWallItem.item.title}`;
                        promptBanner.classList.remove('hidden');
                    } else {
                        promptBanner.classList.add('hidden');
                    }
                }
            } else {
                gameState.activeWallItem = null;
                gameState.activeExitDoor = false;
                let foundZone = null;
                for (const zone of townZones) {
                    const dist = Math.hypot(
                        playerGroup.position.x - zone.portalX,
                        playerGroup.position.z - zone.portalZ
                    );
                    if (dist < 4.6) {
                        foundZone = zone;
                        break;
                    }
                }

                if (foundZone) {
                    gameState.activeZone = foundZone;
                    document.getElementById('prompt-title').textContent = `Go Inside ${foundZone.name}`;
                    promptBanner.classList.remove('hidden');
                } else {
                    gameState.activeZone = null;
                    promptBanner.classList.add('hidden');
                }
            }

            // 6. Smooth 360° Orbit Camera around Student Character
            const targetCamX = playerGroup.position.x + Math.sin(cameraAngle) * cameraDistance * Math.cos(cameraPitch);
            const targetCamZ = playerGroup.position.z + Math.cos(cameraAngle) * cameraDistance * Math.cos(cameraPitch);
            const targetCamY = playerGroup.position.y + Math.sin(cameraPitch) * cameraDistance + 2.2;

            camera.position.lerp(new THREE.Vector3(targetCamX, targetCamY, targetCamZ), 0.2);
            camera.lookAt(playerGroup.position.x, playerGroup.position.y + 2.6, playerGroup.position.z);

            // 7. Update 3D Floating Labels
            labelElements.forEach((item) => {
                const worldPos = item.followObject
                    ? new THREE.Vector3(item.followObject.position.x, 4.6, item.followObject.position.z)
                    : item.pos.clone();
                worldPos.project(camera);

                if (worldPos.z < 1) {
                    const x = (worldPos.x * 0.5 + 0.5) * window.innerWidth;
                    const y = (-(worldPos.y * 0.5) + 0.5) * window.innerHeight;
                    item.el.style.left = `${x}px`;
                    item.el.style.top = `${y}px`;
                    item.el.style.opacity = '1';
                } else {
                    item.el.style.opacity = '0';
                }
            });

            renderer.render(scene, camera);
        }

        window.onload = function () {
            initThreeWorld();
            animate();
        };
    </script>
