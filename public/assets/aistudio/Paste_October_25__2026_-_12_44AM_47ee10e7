          </div>
        `;
        container.innerHTML = `
          ${subTabsHtml}
          <div>
            <label class="text-xs font-bold uppercase tracking-wider text-slate-400 block mb-2.5">T-Shirts & Uniforms</label>
            <div class="grid grid-cols-2 gap-2.5">
              ${TOP_STYLES.map(top => {
                const itemKey = `top:${top.id}`;
                const unlocked = isItemUnlocked(s, itemKey);
                const isEquipped = s.topStyle === top.id;
                const safeName = top.name.replace(/'/g, "\\'");
                return `
                  <div class="item-card p-2.5 rounded-2xl border border-slate-700/80 bg-slate-900/70 flex flex-col justify-between gap-2 text-left ${isEquipped ? 'active' : ''}">
                    <div onclick="handleShopItemClick('top', '${top.id}', ${top.cost}, '${safeName}', {primary:'${top.primary}', secondary:'${top.secondary}'})" class="cursor-pointer">
                      <div class="w-full flex items-center justify-between">
                        <i class="fa-solid ${top.icon} text-orange-400 text-sm"></i>
                        ${renderPriceOrOwnedBadge(s, itemKey, top.cost)}
                      </div>
                      <p class="text-xs font-bold text-white leading-tight mt-1.5">${top.name}</p>
                    </div>
                  </div>
                `;
              }).join('')}
            </div>
          </div>
        `;
      }
      else if (activeCustomTab === 'headgear') {
        container.innerHTML = `
          <div>
            <label class="text-xs font-bold uppercase tracking-wider text-slate-400 block mb-2">Headgear & Hair Clips (50💎–250💎)</label>
            <div class="grid grid-cols-2 gap-2.5">
              ${HEADGEAR_ITEMS.map(hg => {
                const itemKey = `headgear:${hg.id}`;
                const unlocked = isItemUnlocked(s, itemKey);
                const isEquipped = s.headgear === hg.id;
                const safeName = hg.name.replace(/'/g, "\\'");
                return `
                  <div class="item-card p-3 rounded-2xl border border-slate-700/80 bg-slate-900/70 flex flex-col justify-between gap-2 text-left ${isEquipped ? 'active' : ''}">
                    <div onclick="handleShopItemClick('headgear', '${hg.id}', ${hg.cost}, '${safeName}')" class="cursor-pointer">
                      <div class="w-full flex items-center justify-between">
                        <i class="fa-solid ${hg.icon} text-amber-400 text-base"></i>
                        ${renderPriceOrOwnedBadge(s, itemKey, hg.cost)}
                      </div>
                      <p class="text-xs font-bold text-slate-100 mt-2">${hg.name}</p>
                    </div>
                  </div>
                `;
              }).join('')}
            </div>
          </div>
        `;
      }
      else if (activeCustomTab === 'accessories') {
        container.innerHTML = `
          <div>
            <label class="text-xs font-bold uppercase tracking-wider text-slate-400 block mb-2">Wearable Accessories (50💎–150💎)</label>
            <div class="grid grid-cols-2 gap-2.5">
              ${ACCESSORY_ITEMS.map(item => {
                const itemKey = `acc:${item.id}`;
                const unlocked = isItemUnlocked(s, itemKey);
                const safeName = item.name.replace(/'/g, "\\'");
                return `
                  <div class="item-card p-3 rounded-2xl border border-slate-700/80 bg-slate-900/70 flex flex-col justify-between gap-2 text-left">
                    <div onclick="handleShopItemClick('acc', '${item.id}', ${item.cost}, '${safeName}')" class="cursor-pointer">
                      <div class="w-full flex items-center justify-between">
                        <i class="fa-solid ${item.icon} text-amber-400 text-base"></i>
                        ${renderPriceOrOwnedBadge(s, itemKey, item.cost)}
                      </div>
                      <p class="text-xs font-bold text-slate-100 mt-2">${item.name}</p>
                    </div>
                  </div>
                `;
              }).join('')}
            </div>
          </div>
        `;
      }
      else if (activeCustomTab === 'bikes') {
        container.innerHTML = `
          <div>
            <label class="text-xs font-bold uppercase tracking-wider text-slate-400 block mb-2.5">3D Bicycles & Rides (120💎–500💎)</label>
            <div class="space-y-2.5">
              ${VEHICLE_ITEMS.map(v => {
                const itemKey = `vehicle:${v.id}`;
                const unlocked = isItemUnlocked(s, itemKey);
                const isEquipped = s.vehicle === v.id;
                const safeName = v.name.replace(/'/g, "\\'");
                return `
                  <div class="item-card p-3 rounded-2xl border border-slate-700/80 bg-slate-900/70 flex items-center justify-between gap-3 ${isEquipped ? 'active' : ''}">
                    <div onclick="handleShopItemClick('vehicle', '${v.id}', ${v.cost}, '${safeName}')" class="flex items-center gap-3 flex-1 cursor-pointer">
                      <div class="w-10 h-10 rounded-xl bg-slate-800 flex items-center justify-center text-purple-400 text-lg shrink-0">
                        <i class="fa-solid ${v.icon}"></i>
                      </div>
                      <div>
                        <div class="flex items-center gap-2">
                          <p class="text-xs font-bold text-white">${v.name}</p>
                          ${renderPriceOrOwnedBadge(s, itemKey, v.cost)}
                        </div>
                        <p class="text-[10px] text-slate-400 mt-0.5">${v.desc}</p>
                      </div>
                    </div>
                  </div>
                `;
              }).join('')}
            </div>
          </div>
        `;
      }
    }

    function openEraGemsModal() {
      const s = getActiveStudent();
      document.getElementById('gem-modal-student-name').textContent = `${s.name} (${s.classLevel})`;
      document.getElementById('gem-modal-balance').textContent = (s.gems || 0).toLocaleString();
      loadNextQuizQuestion();
      const modal = document.getElementById('eragems-modal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeEraGemsModal() {
      const modal = document.getElementById('eragems-modal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    function loadNextQuizQuestion() {
      currentQuizIndex = (currentQuizIndex + 1) % QUIZ_QUESTIONS.length;
      const item = QUIZ_QUESTIONS[currentQuizIndex];
      document.getElementById('quiz-question-text').textContent = item.q;
      const grid = document.getElementById('quiz-options-grid');
      grid.innerHTML = item.options.map((opt, idx) => `
        <button onclick="submitQuizAnswer(${idx})" class="p-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-700 text-xs font-semibold text-left text-slate-200 transition">
          ${opt}
        </button>
      `).join('');
    }

    function submitQuizAnswer(selectedIndex) {
      const item = QUIZ_QUESTIONS[currentQuizIndex];
      if (selectedIndex === item.answer) {
        awardGems(80, 'Correct IELTS Answer!');
        loadNextQuizQuestion();
      } else {
        showToast('Not quite right — try another option!', true);
      }
    }

    let currentQuizIndex = 0;
    function awardGems(amount, reason) {
      const s = getActiveStudent();
      s.gems = (s.gems || 0) + amount;
      s.xp = (s.xp || 0) + amount * 2;
      persistStudents();
      updateHeaderCardUI(s);
      renderRosterList();
      const balEl = document.getElementById('gem-modal-balance');
      if (balEl) balEl.textContent = s.gems.toLocaleString();
      showToast(`+${amount} 💎 EraGems (${reason})!`);
    }

    function toggleDirectoryModal() {
      const modal = document.getElementById('directory-modal');
      if (modal.classList.contains('hidden')) {
        renderDirectoryGrid();
        modal.classList.remove('hidden');
        modal.classList.add('flex');
      } else {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }
    }

    function renderDirectoryGrid() {
      const grid = document.getElementById('directory-grid');
      grid.innerHTML = studentsData.map(s => {
        const idStr = String(s.id).padStart(3, '0');
        return `
          <div onclick="selectStudentById(${s.id}); toggleDirectoryModal();"
               class="cursor-pointer p-3 rounded-2xl border ${s.id === activeStudentId ? 'border-orange-400 bg-orange-500/15' : 'border-slate-800 bg-slate-900/70 hover:border-slate-600'} transition flex flex-col justify-between gap-2">
            <div class="flex items-center justify-between">
              <span class="px-2 py-0.5 rounded-md text-[10px] font-bold text-white" style="background:${s.topPrimary}">#${idStr}</span>
              <span class="text-[10px] font-bold text-cyan-300">💎 ${s.gems}</span>
            </div>
            <div>
              <p class="text-xs font-bold text-white truncate">Character #${idStr}</p>
              <p class="text-[10px] text-slate-400">${s.classLevel} • ${s.unlockedItems ? s.unlockedItems.length : 0} Unlocks</p>
            </div>
          </div>
        `;
      }).join('');
    }

    function openStudentCardModal() {
      const s = getActiveStudent();
      if (renderer && scene && camera) {
        renderer.render(scene, camera);
        document.getElementById('idcard-snapshot').src = renderer.domElement.toDataURL('image/png');
      }
      document.getElementById('idcard-class').textContent = s.classLevel;
      document.getElementById('idcard-name').textContent = s.name;
      document.getElementById('idcard-bio').textContent = s.bio;
      document.getElementById('idcard-gems').innerHTML = `<i class="fa-solid fa-gem mr-1"></i>${s.gems} EraGems • ${s.xp} XP`;

      const hairObj = HAIRSTYLES.find(h => h.id === s.hairStyle) || HAIRSTYLES[0];
      const topObj = TOP_STYLES.find(t => t.id === s.topStyle) || TOP_STYLES[0];
      const vehObj = VEHICLE_ITEMS.find(v => v.id === s.vehicle) || VEHICLE_ITEMS[0];

      document.getElementById('idcard-loadout').innerHTML = `
        <div><span class="text-slate-400">Hair:</span> <span class="text-white font-semibold">${hairObj.name}</span></div>
        <div><span class="text-slate-400">Top:</span> <span class="text-white font-semibold">${topObj.name}</span></div>
        <div><span class="text-slate-400">Ride:</span> <span class="text-white font-semibold">${vehObj.name}</span></div>
      `;

      const modal = document.getElementById('idcard-modal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeStudentCardModal() {
      const modal = document.getElementById('idcard-modal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    function downloadSnapshot() {
      const s = getActiveStudent();
      const link = document.createElement('a');
      link.download = `character-${String(s.id).padStart(3, '0')}-3d.png`;
      link.href = document.getElementById('idcard-snapshot').src;
      link.click();
      showToast('Downloaded 3D Student Portrait PNG!');
    }

    function openEditProfileModal() {
      const s = getActiveStudent();
      document.getElementById('edit-name-input').value = formatCharNumber(s.id);
      document.getElementById('edit-class-input').value = s.classLevel;
      document.getElementById('edit-gems-input').value = s.gems || 0;
      document.getElementById('edit-bio-input').value = s.bio;
      const modal = document.getElementById('edit-profile-modal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeEditProfileModal() {
      const modal = document.getElementById('edit-profile-modal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    function saveStudentMetadata() {
      const s = getActiveStudent();
      s.name = formatCharNumber(s.id);
      s.classLevel = document.getElementById('edit-class-input').value === 'IELTS 2' ? 'IELTS 2' : 'IELTS 1';
      s.gems = parseInt(document.getElementById('edit-gems-input').value, 10) || 0;
      s.bio = document.getElementById('edit-bio-input').value.trim() || s.bio;
      persistStudents();
      updateHeaderCardUI(s);
      renderRosterList();
      closeEditProfileModal();
      showToast('Character profile & EraGems saved!');
    }

    let toastTimeout = null;
    function showToast(msg, isWarning = false) {
      const toast = document.getElementById('toast');
      const icon = document.getElementById('toast-icon');
      document.getElementById('toast-text').textContent = msg;
      icon.className = isWarning
        ? 'fa-solid fa-triangle-exclamation text-amber-400'
        : 'fa-solid fa-circle-check text-emerald-400';
      toast.classList.remove('translate-y-16', 'opacity-0');
      if (toastTimeout) clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => {
        toast.classList.add('translate-y-16', 'opacity-0');
      }, 2600);
    }

    window.onload = function () {
      buildInitial100Students();
      updateHeaderCardUI(getActiveStudent());
      renderRosterList();
      renderCustomizerPanel();
      initThreeJS();
    };
  </script>
</body>
</html>