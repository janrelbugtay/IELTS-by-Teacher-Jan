      return studentsData.find(s => s.id === activeStudentId) || studentsData[0];
    }

    function isItemUnlocked(student, itemKey) {
      if (ALWAYS_FREE_IDS.has(itemKey)) return true;
      return Array.isArray(student.unlockedItems) && student.unlockedItems.includes(itemKey);
    }

    function getEffectiveStudentState(student) {
      const copy = JSON.parse(JSON.stringify(student));
      if (!previewState) return copy;

      const { category, itemId, extraProps } = previewState;
      if (category === 'hair') copy.hairStyle = itemId;
      else if (category === 'top') {
        copy.topStyle = itemId;
        if (extraProps && extraProps.primary) copy.topPrimary = extraProps.primary;
        if (extraProps && extraProps.secondary) copy.topSecondary = extraProps.secondary;
      }
      else if (category === 'jacket') {
        copy.jacketStyle = itemId;
        if (extraProps && extraProps.primary) copy.jacketPrimary = extraProps.primary;
        if (extraProps && extraProps.secondary) copy.jacketSecondary = extraProps.secondary;
      }
      else if (category === 'bottom') {
        copy.bottomStyle = itemId;
        if (extraProps && extraProps.color) copy.bottomColor = extraProps.color;
      }
      else if (category === 'shoe') {
        copy.shoeStyle = itemId;
        if (extraProps && extraProps.color) copy.shoeColor = extraProps.color;
      }
      else if (category === 'headgear') copy.headgear = itemId;
      else if (category === 'acc') {
        if (!copy.accessories.includes(itemId)) copy.accessories.push(itemId);
      }
      else if (category === 'vehicle') copy.vehicle = itemId;
      return copy;
    }

