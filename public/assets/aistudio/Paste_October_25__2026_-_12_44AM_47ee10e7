    function updateHeaderCardUI(student) {
      const idStr = String(student.id).padStart(3, '0');
      document.getElementById('profile-badge-avatar').textContent = `#${idStr}`;
      document.getElementById('profile-badge-avatar').style.background = `linear-gradient(135deg, ${student.topPrimary}, ${student.bikeColor || '#6366f1'})`;
      document.getElementById('profile-name').textContent = `Character #${idStr}`;
      document.getElementById('profile-class-badge').textContent = student.classLevel;
      document.getElementById('profile-bio').textContent = student.bio;
      document.getElementById('profile-stars').textContent = student.xp.toLocaleString();
      document.getElementById('profile-gems').textContent = (student.gems || 0).toLocaleString();
