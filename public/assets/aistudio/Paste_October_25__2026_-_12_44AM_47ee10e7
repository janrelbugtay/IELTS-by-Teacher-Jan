    function rebuild3DSceneForStudent(student) {
      if (!scene) return;
      disposeGroup(characterRoot);
      disposeGroup(vehicleGroup);

      characterRig = {};

      const skinObj = SKIN_TONES.find(s => s.id === student.skinTone) || SKIN_TONES[3];
      const eyeObj = EYE_COLORS.find(e => e.id === student.eyeColor) || EYE_COLORS[0];
      const skinMat = createSkinMaterial(skinObj);
      const hairMat = createHairMaterial(student.hairColor);

      const scale = student.bodyScale || 1.0;
      const chub = student.chubbiness || 1.0;
      const headScale = student.headScale || 1.0;
      const jawDefine = typeof student.jawDefine === 'number' ? student.jawDefine : 1.0;
      const isGirl = student.gender === 'girl';
      characterRoot.scale.set(scale, scale, scale);

      const hipsGroup = new THREE.Group();
      hipsGroup.position.y = 1.06;
      characterRoot.add(hipsGroup);
      characterRig.hips = hipsGroup;

      const torsoGroup = new THREE.Group();
      hipsGroup.add(torsoGroup);
      characterRig.torso = torsoGroup;

      const neckMesh = new THREE.Mesh(new THREE.CylinderGeometry(0.088, 0.104, 0.22, 32), skinMat);
      neckMesh.position.set(0, 0.72, -0.01);
      neckMesh.castShadow = true;
      torsoGroup.add(neckMesh);

      const headGroup = new THREE.Group();
      headGroup.position.set(0, 1.06, 0.01);
      headGroup.scale.set(headScale, headScale, headScale);
      torsoGroup.add(headGroup);
      characterRig.head = headGroup;

      const headGeo = createSculptedRealisticHeadGeometry(chub, isGirl, student.faceShape || 'oval', jawDefine);
      const headMesh = new THREE.Mesh(headGeo, skinMat);
      headMesh.castShadow = true;
      headMesh.receiveShadow = true;
      headGroup.add(headMesh);

      // Nose
      const noseCfg = NOSE_SHAPES.find(n => n.id === (student.noseShape || 'button')) || NOSE_SHAPES[0];
      const noseGroup = new THREE.Group();
      noseGroup.position.set(0, -0.024 + noseCfg.tipLift, 0.284);
      headGroup.add(noseGroup);

      const noseTip = new THREE.Mesh(new THREE.SphereGeometry(0.027, 28, 28), skinMat);
      noseTip.scale.set(1.06 * noseCfg.w, 0.86 * noseCfg.h, 0.92 * noseCfg.proj);
      noseGroup.add(noseTip);

      // Blush
