    function createSkinMaterial(skinObj) {
      return new THREE.MeshPhysicalMaterial({
        color: new THREE.Color(skinObj.hex),
        roughness: 0.42,
        metalness: 0.0,
        clearcoat: 0.35,
        clearcoatRoughness: 0.15
      });
    }

    function createHairMaterial(hexColor) {
      return new THREE.MeshStandardMaterial({
        color: new THREE.Color(hexColor),
        roughness: 0.55,
        metalness: 0.05
      });
    }

    function createFabricMaterial(hexColor, roughness = 0.65) {
      return new THREE.MeshStandardMaterial({
        color: new THREE.Color(hexColor),
        roughness: roughness,
        metalness: 0.0
      });
    }

    function createGlossyMaterial(hexColor, roughness = 0.2, metalness = 0.1) {
      return new THREE.MeshPhysicalMaterial({
        color: new THREE.Color(hexColor),
        roughness: roughness,
        metalness: metalness,
        clearcoat: 0.8,
        clearcoatRoughness: 0.1
      });
    }

    function getRealisticIrisTexture(eyeObj) {
      const canvas = document.createElement('canvas');
      canvas.width = 128;
      canvas.height = 128;
      const ctx = canvas.getContext('2d');
      ctx.fillStyle = eyeObj.rim;
      ctx.fillRect(0, 0, 128, 128);

      const grad = ctx.createRadialGradient(64, 64, 10, 64, 64, 60);
      grad.addColorStop(0, eyeObj.rim);
      grad.addColorStop(0.3, eyeObj.hex);
      grad.addColorStop(0.85, eyeObj.inner);
      grad.addColorStop(1, eyeObj.rim);
      ctx.fillStyle = grad;
      ctx.beginPath();
      ctx.arc(64, 64, 58, 0, Math.PI * 2);
      ctx.fill();

      // Radial iris fibers
      ctx.strokeStyle = 'rgba(255,255,255,0.22)';
      ctx.lineWidth = 1.5;
      for (let i = 0; i < 48; i++) {
        const angle = (i / 48) * Math.PI * 2;
        ctx.beginPath();
        ctx.moveTo(64 + Math.cos(angle) * 12, 64 + Math.sin(angle) * 12);
        ctx.lineTo(64 + Math.cos(angle) * 54, 64 + Math.sin(angle) * 54);
        ctx.stroke();
      }

      // Pupil
      ctx.fillStyle = '#090b10';
      ctx.beginPath();
      ctx.arc(64, 64, 13, 0, Math.PI * 2);
      ctx.fill();

      const texture = new THREE.CanvasTexture(canvas);
      texture.needsUpdate = true;
      return texture;
    }

