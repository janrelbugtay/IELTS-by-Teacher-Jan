        const blushMat = new THREE.MeshBasicMaterial({
          color: new THREE.Color(skinObj.blush),
          transparent: true,
          opacity: Math.min(0.42, student.blush * 0.36),
          depthWrite: false
        });
        const blushGeo = new THREE.SphereGeometry(0.056, 24, 24);
        blushGeo.scale(1.28, 0.74, 0.22);
        [-1, 1].forEach(dir => {
          const blushMesh = new THREE.Mesh(blushGeo, blushMat);
          blushMesh.position.set(dir * 0.146 * Math.pow(chub, 0.35), -0.046, 0.248);
          headGroup.add(blushMesh);
        });
      }

      // Ears
      [-1, 1].forEach(dir => {
        const pinna = new THREE.Mesh(new THREE.SphereGeometry(0.068, 28, 28), skinMat);
        pinna.scale.set(0.38, 1.05, 0.70);
        pinna.position.set(dir * 0.284, -0.010, -0.015);
        headGroup.add(pinna);
      });

      // Eyes
      const eyesGroup = new THREE.Group();
      headGroup.add(eyesGroup);
      const irisTex = getRealisticIrisTexture(eyeObj);
      const eyeShapeCfg = EYE_SHAPES.find(es => es.id === (student.eyeShape || 'almond')) || EYE_SHAPES[0];
      const eyeRadius = (isGirl ? 0.055 : 0.051) * (student.eyeScale || 1.0);

      [-1, 1].forEach(dir => {
        const singleEye = new THREE.Group();
        singleEye.position.set(dir * 0.102, 0.028, 0.254);
        singleEye.rotation.y = dir * 0.34;

        const eyeball = new THREE.Mesh(new THREE.SphereGeometry(eyeRadius, 36, 36), new THREE.MeshPhysicalMaterial({ color: 0xffffff, roughness: 0.08 }));
        eyeball.scale.set(eyeShapeCfg.sx, eyeShapeCfg.sy, 0.46);
        singleEye.add(eyeball);

        const irisDisc = new THREE.Mesh(new THREE.CircleGeometry(eyeRadius * 0.68, 36), new THREE.MeshPhysicalMaterial({ map: irisTex, roughness: 0.1 }));
        irisDisc.position.z = eyeRadius * 0.465;
        singleEye.add(irisDisc);
        eyesGroup.add(singleEye);
      });

      // Mouth
      const mouthGroup = new THREE.Group();
      mouthGroup.position.set(0, -0.098, 0.274);
      headGroup.add(mouthGroup);
      const smileCurve = new THREE.CatmullRomCurve3([
        new THREE.Vector3(-0.060, 0.024, -0.018),
        new THREE.Vector3(0, -0.002, 0.008),
        new THREE.Vector3(0.060, 0.024, -0.018)
      ]);
      mouthGroup.add(new THREE.Mesh(new THREE.TubeGeometry(smileCurve, 28, 0.0048, 10, false), new THREE.MeshBasicMaterial({ color: 0x6e2626 })));

      buildHairstyleMesh(headGroup, student.hairStyle, hairMat, student);

      // Torso & Clothes
      const topMat = createFabricMaterial(student.topPrimary || '#FF7A1A', 0.65);
      const torsoGeo = new THREE.CylinderGeometry(0.228 * chub, 0.212 * chub, 0.64, 40, 8);
      torsoGeo.scale(1.14, 1.0, 0.76);
      const torsoMesh = new THREE.Mesh(torsoGeo, topMat);
      torsoMesh.position.y = 0.34;
      torsoMesh.castShadow = true;
      torsoGroup.add(torsoMesh);

      // Arms
      [-1, 1].forEach((dir, idx) => {
        const armPivot = new THREE.Group();
        armPivot.position.set(dir * 0.285 * chub, 0.56, 0);
        torsoGroup.add(armPivot);

        const upperMesh = new THREE.Mesh(new THREE.CylinderGeometry(0.070, 0.058, 0.26, 28), topMat);
        upperMesh.position.y = -0.125;
        armPivot.add(upperMesh);

        const foreMesh = new THREE.Mesh(new THREE.CylinderGeometry(0.054, 0.039, 0.24, 28), skinMat);
        foreMesh.position.y = -0.38;
        armPivot.add(foreMesh);

        buildSculptedHandMesh(armPivot, dir, skinMat);
      });

      // Legs & Shoes
      const bottomMat = createFabricMaterial(student.bottomColor || '#3B6BA5', 0.68);
      const shoeMat = createGlossyMaterial(student.shoeColor || '#F8FAFC', 0.3, 0.05);

      [-1, 1].forEach(dir => {
        const legPivot = new THREE.Group();
        legPivot.position.set(dir * 0.125 * chub, -0.08, 0);
        hipsGroup.add(legPivot);

        const thigh = new THREE.Mesh(new THREE.CylinderGeometry(0.096 * chub, 0.078 * chub, 0.42, 28), bottomMat);
        thigh.position.y = -0.21;
        legPivot.add(thigh);

        const calf = new THREE.Mesh(new THREE.CylinderGeometry(0.076, 0.058, 0.42, 28), skinMat);
        calf.position.y = -0.60;
        legPivot.add(calf);

        const shoe = new THREE.Mesh(new THREE.SphereGeometry(0.095, 28, 28), shoeMat);
        shoe.scale.set(0.88, 0.66, 1.58);
        shoe.position.set(0, -0.90, 0.048);
        legPivot.add(shoe);
      });

      buildVehicleOrMount(vehicleGroup, student);
      updateCharacterPose(0);
    }

    function buildVehicleOrMount(vGroup, student) {
      const vType = student.vehicle;
      if (!vType || vType === 'none') return;
      const isGolden = vType === 'golden_bike';
      const frameColor = isGolden ? '#FACC15' : (student.bikeColor || '#38BDF8');
      const frameMat = createGlossyMaterial(frameColor, 0.2, 0.3);

      if (vType === 'mountain_bike' || vType === 'golden_bike') {
        const bike = new THREE.Group();
        const isRiding = animationMode === 'ride';
        bike.position.set(isRiding ? 0 : 0.65, 0, isRiding ? 0.05 : -0.22);
        bike.rotation.y = isRiding ? Math.PI / 2 : -0.35;

        [-0.58, 0.58].forEach(wx => {
          const wheel = new THREE.Mesh(new THREE.TorusGeometry(0.34, 0.048, 16, 40), createFabricMaterial('#0F172A', 0.85));
          wheel.position.set(wx, 0.38, 0);
          bike.add(wheel);
        });
        vGroup.add(bike);
      }
    }

    function updateCharacterPose(t) {
      if (!characterRig.hips) return;
      characterRig.hips.position.y = 1.06;
      characterRig.hips.rotation.set(0, 0, 0);
      if (characterRig.torso) characterRig.torso.rotation.set(0, 0, 0);
      if (characterRig.head) characterRig.head.rotation.set(0, 0, 0);

      if (animationMode === 'idle') {
        const breath = Math.sin(t * 2.0);
        characterRig.hips.position.y = 1.06 + breath * 0.012;
        if (characterRig.head) characterRig.head.rotation.y = Math.sin(t * 0.9) * 0.07;
      }
    }

    function animateLoop() {
      requestAnimationFrame(animateLoop);
      const elapsed = clock.getElapsedTime();
      updateCharacterPose(elapsed);
      if (autoSpin && characterRoot) {
        characterRoot.rotation.y += 0.01;
        if (vehicleGroup) vehicleGroup.rotation.y += 0.01;
      }
      if (controls) controls.update();
      if (renderer && scene && camera) renderer.render(scene, camera);
    }

    function onWindowResize() {
      const container = document.getElementById('canvas-container');
      if (!container || !renderer || !camera) return;
      const w = container.clientWidth || 800;
      const h = container.clientHeight || 600;
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      renderer.setSize(w, h);
    }

    function setAnimationMode(mode) {
      animationMode = mode;
      document.querySelectorAll('.anim-btn').forEach(btn => {
        btn.className = 'anim-btn px-2.5 py-1.5 rounded-xl text-xs font-semibold text-slate-300 hover:bg-slate-800 transition';
      });
      const activeBtn = document.getElementById(`anim-${mode}`);
      if (activeBtn) activeBtn.className = 'anim-btn px-2.5 py-1.5 rounded-xl text-xs font-semibold bg-sky-500 text-slate-950 transition';
      rebuild3DSceneForStudent(getEffectiveStudentState(getActiveStudent()));
    }

    function focusCamera(targetType) {
      if (!controls || !camera) return;
      if (targetType === 'face') {
        camera.position.set(0, 2.15, 2.75);
        controls.target.set(0, 2.02, 0);
      } else {
        camera.position.set(0, 1.88, 6.2);
        controls.target.set(0, 1.38, 0);
      }
      controls.update();
    }

    function toggleAutoRotate() {
      autoSpin = !autoSpin;
      const btn = document.getElementById('btn-autorotate');
      if (autoSpin) {
        btn.className = 'px-2.5 py-1 rounded-lg text-xs font-semibold bg-sky-500 text-slate-950 transition';
      } else {
        btn.className = 'px-2.5 py-1 rounded-lg text-xs font-semibold bg-slate-800 text-slate-300 hover:bg-slate-700 transition';
      }
    }

    function cycleStudioLighting() {
      const themes = ['#0f172a', '#1e1b4b', '#064e3b', '#31102f'];
      studioThemeIndex = (studioThemeIndex + 1) % themes.length;
      if (scene) {
        scene.background = new THREE.Color(themes[studioThemeIndex]);
        scene.fog = new THREE.FogExp2(themes[studioThemeIndex], 0.02);
      }
    }

    function updateStudentProp(prop, val) {
      const s = getActiveStudent();
      s[prop] = val;
      persistStudents();
      updateHeaderCardUI(s);
      renderRosterList();
      renderCustomizerPanel();
      rebuild3DSceneForStudent(getEffectiveStudentState(s));
    }

    function handleShopItemClick(category, itemId, cost, itemName, extraProps = {}) {
      const student = getActiveStudent();
      const itemKey = `${category}:${itemId}`;

      if (isItemUnlocked(student, itemKey)) {
        previewState = null;
        updatePreviewBannerUI();
        equipOwnedItem(student, category, itemId, extraProps);
        persistStudents();
        updateHeaderCardUI(student);
        renderRosterList();
        renderCustomizerPanel();
        rebuild3DSceneForStudent(student);
        showToast(`Equipped ${itemName}!`);
      } else {
        previewState = { category, itemId, itemKey, cost, itemName, extraProps };
        updatePreviewBannerUI();
        renderCustomizerPanel();
        rebuild3DSceneForStudent(getEffectiveStudentState(student));
      }
    }

    function buyAndEquipItem(category, itemId, cost, itemName, extraProps = {}) {
      const student = getActiveStudent();
      const itemKey = `${category}:${itemId}`;

      if ((student.gems || 0) < cost) {
        showToast(`Need ${cost} 💎 EraGems! Click "+ Earn" to get more.`, true);
        openEraGemsModal();
        return;
      }

      student.gems -= cost;
      if (!Array.isArray(student.unlockedItems)) student.unlockedItems = [];
      if (!student.unlockedItems.includes(itemKey)) student.unlockedItems.push(itemKey);

      previewState = null;
      updatePreviewBannerUI();
      equipOwnedItem(student, category, itemId, extraProps);
      persistStudents();
      updateHeaderCardUI(student);
      renderRosterList();
      renderCustomizerPanel();
      rebuild3DSceneForStudent(student);
      showToast(`Unlocked & Equipped ${itemName} (-${cost} 💎)!`);
    }

    function equipOwnedItem(student, category, itemId, extraProps = {}) {
      if (category === 'hair') student.hairStyle = itemId;
      else if (category === 'top') {
        student.topStyle = itemId;
        if (extraProps.primary) student.topPrimary = extraProps.primary;
        if (extraProps.secondary) student.topSecondary = extraProps.secondary;
      }
      else if (category === 'jacket') {
        student.jacketStyle = itemId;
      }
      else if (category === 'bottom') {
        student.bottomStyle = itemId;
        if (extraProps.color) student.bottomColor = extraProps.color;
      }
      else if (category === 'shoe') {
        student.shoeStyle = itemId;
        if (extraProps.color) student.shoeColor = extraProps.color;
      }
      else if (category === 'headgear') student.headgear = itemId;
      else if (category === 'acc') {
        if (!Array.isArray(student.accessories)) student.accessories = [];
        const idx = student.accessories.indexOf(itemId);
        if (idx >= 0) student.accessories.splice(idx, 1);
        else student.accessories.push(itemId);
      }
      else if (category === 'vehicle') student.vehicle = itemId;
    }

    function updatePreviewBannerUI() {
      const banner = document.getElementById('preview-purchase-banner');
      if (!previewState) {
        banner.classList.add('hidden');
        return;
      }
      banner.classList.remove('hidden');
      document.getElementById('preview-item-name').textContent = previewState.itemName;
      document.getElementById('preview-item-cost').textContent = previewState.cost;
      const buyBtn = document.getElementById('preview-buy-btn');
      buyBtn.onclick = () => {
        buyAndEquipItem(previewState.category, previewState.itemId, previewState.cost, previewState.itemName, previewState.extraProps || {});
      };
    }

    function clearPreviewItem() {
      previewState = null;
      updatePreviewBannerUI();
      renderCustomizerPanel();
      rebuild3DSceneForStudent(getActiveStudent());
    }

    function renderRosterList() {
      const listEl = document.getElementById('roster-list');
      const query = (document.getElementById('student-search').value || '').toLowerCase().trim();

      const filtered = studentsData.filter(s => {
        if (activeRosterFilter === 'featured' && !s.featured) return false;
        if (activeRosterFilter === 'boy' && s.gender !== 'boy') return false;
        if (activeRosterFilter === 'girl' && s.gender !== 'girl') return false;
        if (['IELTS 1', 'IELTS 2'].includes(activeRosterFilter) && s.classLevel !== activeRosterFilter) return false;
        if (query) {
          const idStr = `#${String(s.id).padStart(3, '0')}`;
          return s.name.toLowerCase().includes(query) || idStr.includes(query) || s.classLevel.toLowerCase().includes(query);
        }
        return true;
      });

      document.getElementById('roster-count').textContent = `(${filtered.length})`;

      listEl.innerHTML = filtered.map(s => {
        const isActive = s.id === activeStudentId;
        const idFormatted = String(s.id).padStart(3, '0');
        const hasBike = s.vehicle && s.vehicle !== 'none';
        return `
          <div onclick="selectStudentById(${s.id})" class="student-item cursor-pointer p-2.5 rounded-xl border border-slate-800/95 hover:border-slate-600 bg-slate-900/60 flex items-center justify-between transition ${isActive ? 'active' : ''}">
            <div class="flex items-center gap-2.5 min-w-0">
              <div class="w-9 h-9 rounded-lg flex items-center justify-center font-display font-bold text-xs text-white shrink-0 shadow"
                   style="background: linear-gradient(135deg, ${s.topPrimary || '#FF7A1A'}, ${s.hairColor || '#1e293b'})">
                #${idFormatted}
              </div>
              <div class="min-w-0">
                <div class="flex items-center gap-1.5">
                  <p class="text-xs font-bold text-slate-100 truncate">Character #${idFormatted}</p>
                  ${s.id <= 7 ? '<span class="px-1.5 py-0.2 text-[9px] font-bold bg-orange-500/30 text-orange-300 rounded">REF</span>' : ''}
                </div>
                <div class="flex items-center gap-2 text-[10px] text-slate-400 mt-0.5">
                  <span class="${s.classLevel === 'IELTS 2' ? 'text-purple-300 font-semibold' : 'text-sky-300 font-semibold'}">${s.classLevel}</span>
                  <span>•</span>
                  <span class="text-cyan-300 font-bold">💎 ${s.gems}</span>
                  ${hasBike ? '<span class="text-amber-400"><i class="fa-solid fa-bicycle"></i></span>' : ''}
                </div>
              </div>
            </div>
            <i class="fa-solid fa-chevron-right text-[10px] ${isActive ? 'text-orange-400' : 'text-slate-600'}"></i>
          </div>
        `;
      }).join('');
    }

    function setRosterFilter(filter) {
      activeRosterFilter = filter;
      document.querySelectorAll('.filter-pill').forEach(btn => {
        btn.className = 'filter-pill px-2.5 py-1 rounded-lg text-[11px] font-semibold bg-slate-800 text-slate-300 hover:bg-slate-700 shrink-0';
