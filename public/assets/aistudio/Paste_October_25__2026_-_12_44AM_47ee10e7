    /*************************************************************************
     * 4. ANATOMICAL 3D HEAD & JAWLINE TOPOLOGY (10 FACE SHAPES, ZERO DENTING)
     *************************************************************************/
    function createSculptedRealisticHeadGeometry(chub = 1.0, isGirl = false, faceShape = 'oval', jawDefine = 1.0) {
      const geo = new THREE.SphereGeometry(0.305, 64, 64);
      const pos = geo.attributes.position;
      const v = new THREE.Vector3();

      let widthScale = 0.96;
      let verticalScale = 1.08;
      let depthScale = 0.98;
      let jawWidthFactor = isGirl ? 0.84 : 0.88;
      let chinWidthFactor = isGirl ? 0.56 : 0.62;
      let jawAngleRidge = 0.012 * jawDefine;
      let chinForward = 0.014 * jawDefine;
      let cheekApple = 0.018 * chub;

      if (faceShape === 'soft_round' || faceShape === 'round') {
        widthScale = 1.01;
        verticalScale = 1.04;
        jawWidthFactor = 0.93;
        chinWidthFactor = 0.72;
        jawAngleRidge = 0.006 * jawDefine;
        cheekApple = 0.024 * chub;
      } else if (faceShape === 'heart') {
        widthScale = 0.98;
        verticalScale = 1.07;
        jawWidthFactor = 0.78;
        chinWidthFactor = 0.48;
        jawAngleRidge = 0.008 * jawDefine;
        chinForward = 0.016 * jawDefine;
        cheekApple = 0.022 * chub;
      } else if (faceShape === 'v_line') {
        widthScale = 0.95;
        verticalScale = 1.09;
        jawWidthFactor = 0.76;
        chinWidthFactor = 0.45;
        jawAngleRidge = 0.016 * jawDefine;
        chinForward = 0.018 * jawDefine;
      } else if (faceShape === 'chiseled_jaw') {
        widthScale = 0.96;
        verticalScale = 1.09;
        jawWidthFactor = 0.92;
        chinWidthFactor = 0.66;
        jawAngleRidge = 0.028 * jawDefine;
        chinForward = 0.020 * jawDefine;
        cheekApple = 0.014 * chub;
      } else if (faceShape === 'defined_jaw') {
        widthScale = 0.97;
        verticalScale = 1.08;
        jawWidthFactor = 0.90;
        chinWidthFactor = 0.65;
        jawAngleRidge = 0.022 * jawDefine;
        chinForward = 0.018 * jawDefine;
      } else if (faceShape === 'hero_angular') {
        widthScale = 0.98;
        verticalScale = 1.09;
        jawWidthFactor = 0.95;
        chinWidthFactor = 0.70;
        jawAngleRidge = 0.032 * jawDefine;
        chinForward = 0.022 * jawDefine;
        cheekApple = 0.012 * chub;
      } else if (faceShape === 'diamond') {
        widthScale = 0.95;
        verticalScale = 1.08;
        jawWidthFactor = 0.80;
        chinWidthFactor = 0.50;
        jawAngleRidge = 0.020 * jawDefine;
        cheekApple = 0.025 * chub;
      } else if (faceShape === 'square') {
        widthScale = 0.99;
        verticalScale = 1.06;
        jawWidthFactor = 0.96;
        chinWidthFactor = 0.76;
        jawAngleRidge = 0.026 * jawDefine;
        chinForward = 0.016 * jawDefine;
      } else if (faceShape === 'chibi') {
        widthScale = 1.03;
        verticalScale = 1.02;
        jawWidthFactor = 0.92;
        chinWidthFactor = 0.74;
        jawAngleRidge = 0.005 * jawDefine;
        cheekApple = 0.028 * chub;
      }

      for (let i = 0; i < pos.count; i++) {
        v.fromBufferAttribute(pos, i);
        const nx = v.x / 0.305;
        const ny = v.y / 0.305;
        const nz = v.z / 0.305;

        v.x *= widthScale;
        v.y *= verticalScale;
        v.z *= depthScale;

        if (ny > 0.05) {
          const dome = Math.sin(((ny - 0.05) / 0.95) * Math.PI * 0.5);
          v.x *= 1.0 + 0.03 * dome;
          v.z *= 1.0 + 0.03 * dome;
        }

        const frontWeight = Math.max(0, nz);
        if (frontWeight > 0 && ny > -0.65 && ny < 0.35) {
          const facePlane = Math.cos(((ny + 0.15) / 0.55) * Math.PI * 0.5);
          if (facePlane > 0) {
            v.z -= 0.012 * Math.pow(frontWeight, 1.5) * facePlane;
          }
        }

        if (ny < 0.05) {
          const t = Math.min(1.0, (0.05 - ny) / 1.05);
          const smoothT = t * t * (3.0 - 2.0 * t);

          let xFactor;
          if (t < 0.55) {
            const u = t / 0.55;
            const su = u * u * (3.0 - 2.0 * u);
            xFactor = 1.0 - (1.0 - jawWidthFactor) * su;
          } else {
            const u = (t - 0.55) / 0.45;
            const su = u * u * (3.0 - 2.0 * u);
            xFactor = jawWidthFactor - (jawWidthFactor - chinWidthFactor) * su;
          }
          xFactor = xFactor * (0.94 + 0.06 * chub);
          v.x *= xFactor;

          const jawLevel = Math.exp(-Math.pow((ny + 0.42) / 0.24, 2.0));
          const sideWeight = Math.pow(Math.abs(nx), 1.2) * Math.max(0, 1.0 - Math.abs(nz - 0.08) / 0.75);
          v.x += Math.sign(nx) * jawAngleRidge * jawLevel * sideWeight;

          const backWeight = Math.max(0, -nz + 0.15) / 1.15;
          v.z += 0.045 * Math.pow(backWeight, 1.6) * smoothT;

          if (nz > 0.0) {
            const chinHeightBell = Math.exp(-Math.pow((ny + 0.72) / 0.28, 2.0));
            const chinWidthBell = Math.exp(-Math.pow(nx / 0.52, 2.0));
            v.z += chinForward * chinHeightBell * chinWidthBell * frontWeight;
          }
        }

        if (nz > 0.1 && ny > -0.48 && ny < 0.15) {
          const cx = (Math.abs(nx) - 0.36) / 0.38;
          const cy = (ny + 0.14) / 0.30;
          const cDist = Math.hypot(cx, cy);
          if (cDist < 1.0) {
            const cBell = Math.pow(Math.cos(cDist * Math.PI * 0.5), 2.0);
            v.x += Math.sign(nx) * cheekApple * 0.65 * cBell;
            v.z += cheekApple * 0.85 * cBell;
          }
        }

        pos.setXYZ(i, v.x, v.y, v.z);
      }

      geo.computeVertexNormals();
      return geo;
    }

    /*************************************************************************
     * 5. COMPLETE SCENE & CHARACTER BUILDER
     *************************************************************************/
    function disposeGroup(group) {
      if (!group) return;
      while (group.children.length > 0) {
        const obj = group.children[0];
        group.remove(obj);
        if (obj.geometry) obj.geometry.dispose();
        if (obj.material) {
          if (Array.isArray(obj.material)) obj.material.forEach(m => m.dispose());
          else obj.material.dispose();
        }
      }
    }

    function addVolumetricHairLock(parent, points, rRoot, rMid, rTip, hairMat, widthFlatten = 1.25) {
      const curve = new THREE.CatmullRomCurve3(points);
      const tubularSegments = 24;
      const radialSegments = 12;
      const geo = new THREE.TubeGeometry(curve, tubularSegments, 1.0, radialSegments, false);

      const pos = geo.attributes.position;
      const center = new THREE.Vector3();
      const vertex = new THREE.Vector3();
      const normal = new THREE.Vector3();

      for (let i = 0; i <= tubularSegments; i++) {
        const u = i / tubularSegments;
        curve.getPointAt(u, center);

        let radius;
        if (u < 0.45) {
          const t = u / 0.45;
          radius = rRoot + (rMid - rRoot) * Math.sin(t * Math.PI * 0.5);
        } else {
          const t = (u - 0.45) / 0.55;
          radius = rMid * Math.cos(t * Math.PI * 0.5) + rTip * (1 - t);
        }

        for (let j = 0; j <= radialSegments; j++) {
          const idx = i * (radialSegments + 1) + j;
          vertex.fromBufferAttribute(pos, idx);
          normal.subVectors(vertex, center).normalize();
          vertex.copy(center).addScaledVector(normal, radius);
          pos.setXYZ(idx, vertex.x, vertex.y, vertex.z);
        }
      }

      geo.computeVertexNormals();
      const mesh = new THREE.Mesh(geo, hairMat);
      mesh.scale.set(widthFlatten, 1.0, 1.0);
      mesh.castShadow = true;
      mesh.receiveShadow = true;
      parent.add(mesh);
      return mesh;
    }

    function buildHairstyleMesh(headGroup, styleId, hairMat, student) {
      const hairGroup = new THREE.Group();
      headGroup.add(hairGroup);

      const capGeo = new THREE.SphereGeometry(0.312, 48, 48, 0, Math.PI * 2, 0, Math.PI * 0.58);
      capGeo.scale(0.99, 1.12, 1.05);
      const capMesh = new THREE.Mesh(capGeo, hairMat);
      capMesh.rotation.x = -0.52;
      capMesh.position.set(0, 0.032, -0.022);
      capMesh.castShadow = true;
      hairGroup.add(capMesh);

      [-1, 1].forEach(dir => {
        addVolumetricHairLock(hairGroup, [
          new THREE.Vector3(dir * 0.265, 0.16, 0.03),
          new THREE.Vector3(dir * 0.292, 0.05, 0.02),
          new THREE.Vector3(dir * 0.282, -0.04, 0.01)
        ], 0.032, 0.026, 0.008, hairMat, 1.0);
      });

      for (let b = -3; b <= 3; b++) {
        const bx = b * 0.062;
        addVolumetricHairLock(hairGroup, [
          new THREE.Vector3(bx * 0.65, 0.26, -0.18),
          new THREE.Vector3(bx, 0.10, -0.315),
          new THREE.Vector3(bx * 0.92, -0.08, -0.285)
        ], 0.052, 0.048, 0.014, hairMat, 1.2);
      }

      if (styleId === 'bowl_fringe' || styleId === 'side_part') {
        const isSidePart = styleId === 'side_part';
        for (let i = -4; i <= 4; i++) {
          const x0 = i * 0.042;
          const sweepX = isSidePart ? (i >= -1 ? 0.036 : -0.028) : x0 * 0.12;
          const zFront = 0.292 - Math.abs(i) * 0.013;
          addVolumetricHairLock(hairGroup, [
            new THREE.Vector3(x0 * 0.5, 0.34, 0.05),
            new THREE.Vector3(x0 * 0.85 + sweepX * 0.4, 0.265, zFront * 0.92),
            new THREE.Vector3(x0 + sweepX, 0.155, zFront)
          ], 0.036, 0.032, 0.008, hairMat, 1.18);
        }
      }
      else if (styleId === 'swept_boy' || styleId === 'textured_quiff' || styleId === 'cyber_spikes') {
        const lift = styleId === 'cyber_spikes' ? 0.10 : (styleId === 'textured_quiff' ? 0.075 : 0.05);
        for (let i = -4; i <= 4; i++) {
          const xBase = i * 0.042;
          const archY = 0.35 + lift + (2 - Math.abs(i) * 0.4) * 0.02;
          addVolumetricHairLock(hairGroup, [
            new THREE.Vector3(xBase * 0.45, 0.32, -0.02),
            new THREE.Vector3(xBase * 0.8 + 0.03, archY, 0.16),
            new THREE.Vector3(xBase + 0.065, 0.26 + lift * 0.4, 0.292 - Math.abs(i) * 0.014),
            new THREE.Vector3(xBase + 0.09, 0.19 + (i % 2) * 0.015, 0.298 - Math.abs(i) * 0.015)
          ], 0.042, 0.038, 0.009, hairMat, 1.18);
        }
      }
      else if (styleId === 'daisy_buns') {
        for (let i = -4; i <= 4; i++) {
          const bx = i * 0.038;
          addVolumetricHairLock(hairGroup, [
            new THREE.Vector3(bx * 0.5, 0.34, 0.07),
            new THREE.Vector3(bx * 0.88, 0.255, 0.280 - Math.abs(i) * 0.009),
            new THREE.Vector3(bx, 0.155, 0.292 - Math.abs(i) * 0.011)
          ], 0.034, 0.030, 0.008, hairMat, 1.2);
        }
        [-1, 1].forEach(dir => {
          const bunGroup = new THREE.Group();
          bunGroup.position.set(dir * 0.34, 0.03, -0.05);
          const bunCore = new THREE.Mesh(new THREE.SphereGeometry(0.112, 32, 32), hairMat);
          bunCore.scale.set(0.92, 1.05, 1.05);
          bunGroup.add(bunCore);
          hairGroup.add(bunGroup);
        });
      }
      else if (styleId === 'bob_bangs' || styleId === 'long_wavy') {
        const isLong = styleId === 'long_wavy';
        for (let i = -4; i <= 4; i++) {
          const bx = i * 0.039;
          addVolumetricHairLock(hairGroup, [
            new THREE.Vector3(bx * 0.5, 0.34, 0.07),
            new THREE.Vector3(bx * 0.88, 0.255, 0.280 - Math.abs(i) * 0.009),
            new THREE.Vector3(bx, 0.155, 0.290 - Math.abs(i) * 0.011)
          ], 0.034, 0.030, 0.008, hairMat, 1.2);
        }
      }
      else if (styleId === 'high_ponytail' || styleId === 'twin_braids') {
        [-1, 1].forEach(dir => {
          for (let j = 1; j <= 3; j++) {
            addVolumetricHairLock(hairGroup, [
              new THREE.Vector3(dir * 0.03, 0.34, 0.10),
              new THREE.Vector3(dir * (0.075 * j), 0.255, 0.285 - j * 0.022),
              new THREE.Vector3(dir * (0.105 * j), 0.15, 0.255 - j * 0.03)
            ], 0.034, 0.028, 0.008, hairMat, 1.18);
          }
        });
      }
    }

