<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>EduVerse 3D — Realistic Student Profile & Wardrobe Studio (100 Characters)</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Font Awesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <!-- Three.js r128 & OrbitControls -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>

  <style>
    :root {
      --font-display: 'Fredoka', sans-serif;
      --font-sans: 'Plus Jakarta Sans', sans-serif;
    }
    body {
      font-family: var(--font-sans);
      background-color: #0b1120;
      color: #f8fafc;
      overflow-x: hidden;
      user-select: none;
    }
    .font-display {
      font-family: var(--font-display);
    }
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: rgba(15, 23, 42, 0.6);
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb {
      background: rgba(99, 102, 241, 0.5);
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: rgba(99, 102, 241, 0.85);
    }
    .glass-panel {
      background: rgba(15, 23, 42, 0.82);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.09);
    }
    .swatch-btn {
      transition: transform 0.15s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.15s ease;
    }
    .swatch-btn:hover {
      transform: scale(1.12);
    }
    .swatch-btn.active {
      transform: scale(1.16);
      box-shadow: 0 0 0 3px #0f172a, 0 0 0 5px #38bdf8;
    }
    .item-card {
      transition: all 0.18s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .item-card:hover {
      transform: translateY(-2px);
    }
    .item-card.active {
      border-color: #38bdf8;
      background: linear-gradient(135deg, rgba(56, 189, 248, 0.2), rgba(99, 102, 241, 0.2));
      box-shadow: 0 6px 18px -4px rgba(56, 189, 248, 0.3);
    }
    .item-card.previewing {
      border-color: #f59e0b;
      background: linear-gradient(135deg, rgba(245, 158, 11, 0.22), rgba(217, 119, 6, 0.15));
      box-shadow: 0 6px 18px -4px rgba(245, 158, 11, 0.35);
    }
    .student-item.active {
      border-color: #f97316;
      background: linear-gradient(90deg, rgba(249, 115, 22, 0.22), rgba(249, 115, 22, 0.04));
    }
    #canvas-container canvas {
      display: block;
      width: 100% !important;
      height: 100% !important;
      outline: none;
    }
  </style>
</head>
<body class="h-screen w-screen overflow-hidden flex flex-col bg-slate-950 text-slate-100">

  <!-- TOP NAVIGATION BAR -->
  <header class="h-14 px-4 lg:px-6 border-b border-slate-800/80 bg-slate-900/90 backdrop-blur-md flex items-center justify-between shrink-0 z-30">
    <div class="flex items-center gap-3">
      <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-orange-500 via-amber-400 to-sky-400 flex items-center justify-center shadow-lg shadow-orange-500/20">
        <i class="fa-solid fa-cube text-slate-950 text-lg"></i>
      </div>
      <div>
        <div class="flex items-center gap-2">
          <h1 class="font-display text-base lg:text-lg font-bold tracking-wide bg-gradient-to-r from-white via-sky-200 to-orange-300 bg-clip-text text-transparent">
            EduVerse 3D Studio
          </h1>
          <span class="px-2 py-0.5 text-[10px] font-extrabold uppercase tracking-wider rounded-full bg-cyan-500/20 text-cyan-300 border border-cyan-500/30">
            💎 Realistic Mesh v10
          </span>
        </div>
        <p class="text-[10px] text-slate-400 hidden sm:block">Anatomical 3D Student Profiles (#001–#100) • IELTS 1 & IELTS 2</p>
      </div>
    </div>

    <!-- Quick Reference Presets -->
    <div class="hidden xl:flex items-center gap-1.5 bg-slate-800/70 p-1 rounded-xl border border-slate-700/60">
      <span class="text-[11px] font-semibold text-slate-400 px-2"><i class="fa-solid fa-wand-magic-sparkles text-amber-400 mr-1"></i>Ref Presets:</span>
      <button onclick="selectStudentById(1)" class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-orange-500/20 text-orange-300 hover:bg-orange-500/30 border border-orange-500/30 transition">
        #001 Uniform Boy
      </button>
      <button onclick="selectStudentById(2)" class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-amber-500/20 text-amber-300 hover:bg-amber-500/30 border border-amber-500/30 transition">
        #002 Smartwatch Boy
      </button>
      <button onclick="selectStudentById(3)" class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-sky-500/20 text-sky-300 hover:bg-sky-500/30 border border-sky-500/30 transition">
        #003 Daisy Qipao Girl
      </button>
      <button onclick="selectStudentById(4)" class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-indigo-500/20 text-indigo-300 hover:bg-indigo-500/30 border border-indigo-500/30 transition">
        #004 Layered Vest Boy
      </button>
    </div>

    <!-- EraGems Wallet & Actions -->
    <div class="flex items-center gap-2">
      <div class="flex items-center gap-2 bg-slate-900/95 border border-cyan-500/40 px-3 py-1 rounded-xl shadow-inner">
        <i class="fa-solid fa-gem text-cyan-400 text-sm animate-pulse"></i>
        <div>
          <span class="text-[9px] uppercase tracking-wider text-slate-400 block leading-none">EraGems</span>
          <span id="header-gem-balance" class="font-display font-bold text-sm text-cyan-300">420</span>
        </div>
        <button onclick="openEraGemsModal()" class="ml-1 px-2 py-1 rounded-lg bg-gradient-to-r from-cyan-500 to-sky-500 hover:from-cyan-400 hover:to-sky-400 text-slate-950 font-extrabold text-[11px] transition shadow">
          + Earn
        </button>
      </div>

      <button onclick="toggleDirectoryModal()" class="px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 text-xs font-semibold flex items-center gap-1.5 transition">
        <i class="fa-solid fa-table-cells text-sky-400"></i>
        <span class="hidden sm:inline">100 Roster</span>
      </button>
      <button onclick="openStudentCardModal()" class="px-3 py-1.5 rounded-xl bg-gradient-to-r from-orange-500 to-amber-500 hover:from-orange-400 hover:to-amber-400 text-slate-950 font-bold text-xs flex items-center gap-1.5 shadow-lg shadow-orange-500/20 transition">
        <i class="fa-solid fa-id-card"></i>
        <span class="hidden sm:inline">ID Card</span>
      </button>
    </div>
  </header>

  <!-- MAIN WORKSPACE -->
  <div class="flex-1 flex flex-col lg:flex-row overflow-hidden relative">

    <!-- LEFT PANEL: 100 CHARACTER ROSTER -->
    <aside class="w-full lg:w-72 xl:w-80 border-b lg:border-b-0 lg:border-r border-slate-800/80 bg-slate-900/75 flex flex-col shrink-0 max-h-48 lg:max-h-full z-20">
      <div class="p-3 border-b border-slate-800/80 space-y-2.5">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <i class="fa-solid fa-users text-orange-400 text-sm"></i>
            <h2 class="font-display font-bold text-sm tracking-wide text-white">Characters <span id="roster-count" class="text-slate-400 font-normal">(100)</span></h2>
          </div>
          <button onclick="openEditProfileModal()" class="text-[11px] font-semibold text-sky-400 hover:text-sky-300 flex items-center gap-1">
            <i class="fa-solid fa-pen-to-square"></i> Edit Level
          </button>
        </div>

        <!-- Search Input -->
        <div class="relative">
          <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
          <input id="student-search" type="text" oninput="renderRosterList()" placeholder="Search #001 to #100 or IELTS..."
            class="w-full pl-8 pr-3 py-1.5 bg-slate-950/90 border border-slate-700/80 rounded-xl text-xs text-slate-100 placeholder-slate-500 focus:outline-none focus:border-sky-400 transition" />
        </div>

        <!-- Class & Gender Filter Pills -->
        <div class="flex gap-1.5 overflow-x-auto pb-1">
          <button onclick="setRosterFilter('all')" id="filter-all" class="filter-pill px-2.5 py-1 rounded-lg text-[11px] font-semibold bg-orange-500 text-white shrink-0">All (100)</button>
          <button onclick="setRosterFilter('featured')" id="filter-featured" class="filter-pill px-2.5 py-1 rounded-lg text-[11px] font-semibold bg-slate-800 text-slate-300 hover:bg-slate-700 shrink-0">⭐ Ref Presets</button>
          <button onclick="setRosterFilter('boy')" id="filter-boy" class="filter-pill px-2.5 py-1 rounded-lg text-[11px] font-semibold bg-slate-800 text-slate-300 hover:bg-slate-700 shrink-0">Boys</button>
          <button onclick="setRosterFilter('girl')" id="filter-girl" class="filter-pill px-2.5 py-1 rounded-lg text-[11px] font-semibold bg-slate-800 text-slate-300 hover:bg-slate-700 shrink-0">Girls</button>
          <button onclick="setRosterFilter('IELTS 1')" id="filter-IELTS 1" class="filter-pill px-2.5 py-1 rounded-lg text-[11px] font-semibold bg-slate-800 text-slate-300 hover:bg-slate-700 shrink-0">IELTS 1</button>
          <button onclick="setRosterFilter('IELTS 2')" id="filter-IELTS 2" class="filter-pill px-2.5 py-1 rounded-lg text-[11px] font-semibold bg-slate-800 text-slate-300 hover:bg-slate-700 shrink-0">IELTS 2</button>
        </div>
      </div>

      <!-- Scrollable 100 Students List -->
      <div id="roster-list" class="flex-1 overflow-y-auto p-2.5 space-y-1.5"></div>

      <!-- Prev / Next Navigation Footer -->
      <div class="p-2.5 border-t border-slate-800/80 bg-slate-950/60 flex items-center justify-between gap-2 hidden lg:flex">
        <div class="flex items-center gap-1.5">
          <button onclick="navigateStudent(-1)" class="p-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs transition" title="Previous Character">
            <i class="fa-solid fa-chevron-left"></i>
          </button>
          <span id="active-student-index-label" class="text-xs font-bold text-slate-300 px-1">#001 / 100</span>
          <button onclick="navigateStudent(1)" class="p-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs transition" title="Next Character">
            <i class="fa-solid fa-chevron-right"></i>
          </button>
        </div>
        <button onclick="awardGems(50, 'Class Participation Bonus')" class="px-2.5 py-1.5 rounded-lg bg-cyan-500/20 hover:bg-cyan-500/30 text-cyan-300 border border-cyan-500/30 text-xs font-bold flex items-center gap-1 transition">
          <i class="fa-solid fa-gem"></i> +50 Gems
        </button>
      </div>
    </aside>

    <!-- CENTER PANEL: INTERACTIVE 3D CHARACTER VIEWPORT -->
    <main class="flex-1 relative flex flex-col bg-gradient-to-b from-slate-900 via-slate-950 to-slate-900 overflow-hidden">

      <!-- Top Floating Student Badge & Animation Controls -->
      <div class="absolute top-3 left-3 right-3 flex flex-wrap items-start justify-between gap-2 pointer-events-none z-10">
        <!-- Student Profile Badge -->
        <div class="glass-panel px-4 py-3 rounded-2xl shadow-2xl pointer-events-auto flex items-center gap-3.5 border border-white/10 max-w-md">
          <div id="profile-badge-avatar" class="w-12 h-12 rounded-xl bg-gradient-to-br from-orange-400 to-pink-500 flex items-center justify-center text-white font-display font-bold text-lg shadow-inner shrink-0">
            #001
          </div>
          <div class="min-w-0">
            <div class="flex items-center gap-2">
              <h2 id="profile-name" class="font-display text-base lg:text-lg font-bold text-white truncate">Character #001</h2>
              <button onclick="toggleStudentIeltsLevel()" id="profile-class-badge" title="Click to toggle IELTS 1 / IELTS 2" class="px-2 py-0.5 text-[10px] font-bold rounded-md bg-sky-500/20 hover:bg-sky-500/30 text-sky-300 border border-sky-400/30 cursor-pointer transition">IELTS 1</button>
            </div>
            <p id="profile-bio" class="text-xs text-slate-300 truncate mt-0.5">Orange Uniform Squad • Ready for IELTS Speaking</p>
            <div class="flex items-center gap-2.5 mt-1.5 text-[11px] font-bold">
              <span class="text-cyan-300 flex items-center gap-1 bg-cyan-950/70 px-2 py-0.5 rounded-md border border-cyan-500/30">
                <i class="fa-solid fa-gem text-cyan-400"></i> <span id="profile-gems">420</span>
              </span>
              <span class="text-amber-400 flex items-center gap-1"><i class="fa-solid fa-star"></i> <span id="profile-stars">1,850</span> XP</span>
              <span class="text-emerald-400 flex items-center gap-1"><i class="fa-solid fa-unlock"></i> <span id="profile-owned-count">14</span> Owned</span>
            </div>
          </div>
        </div>

        <!-- Pose, Animation & Camera Controls -->
        <div class="glass-panel p-1.5 rounded-2xl shadow-xl pointer-events-auto flex flex-wrap items-center gap-1 border border-white/10">
          <button onclick="setAnimationMode('idle')" id="anim-idle" class="anim-btn px-2.5 py-1.5 rounded-xl text-xs font-semibold bg-sky-500 text-slate-950 transition">
            <i class="fa-solid fa-child-reaching mr-1"></i>Idle
          </button>
          <button onclick="setAnimationMode('walk')" id="anim-walk" class="anim-btn px-2.5 py-1.5 rounded-xl text-xs font-semibold text-slate-300 hover:bg-slate-800 transition">
            <i class="fa-solid fa-person-walking mr-1"></i>Walk
          </button>
          <button onclick="setAnimationMode('wave')" id="anim-wave" class="anim-btn px-2.5 py-1.5 rounded-xl text-xs font-semibold text-slate-300 hover:bg-slate-800 transition">
            <i class="fa-solid fa-hand-spock mr-1"></i>Wave
          </button>
          <button onclick="setAnimationMode('ride')" id="anim-ride" class="anim-btn px-2.5 py-1.5 rounded-xl text-xs font-semibold text-slate-300 hover:bg-slate-800 transition">
            <i class="fa-solid fa-bicycle mr-1"></i>Ride
          </button>
          <button onclick="setAnimationMode('tpose')" id="anim-tpose" class="anim-btn px-2.5 py-1.5 rounded-xl text-xs font-semibold text-slate-300 hover:bg-slate-800 transition">
            <i class="fa-solid fa-arrows-up-down-left-right mr-1"></i>T-Pose
          </button>
          <div class="h-4 w-[1px] bg-slate-700 mx-0.5"></div>
          <button onclick="focusCamera('full')" class="p-1.5 rounded-xl text-xs text-slate-300 hover:bg-slate-800 transition" title="Full Body Camera">
            <i class="fa-solid fa-expand"></i>
          </button>
          <button onclick="focusCamera('face')" class="p-1.5 rounded-xl text-xs text-slate-300 hover:bg-slate-800 transition" title="Close-up Face Camera">
            <i class="fa-solid fa-face-smile"></i>
          </button>
          <button onclick="cycleStudioLighting()" class="p-1.5 rounded-xl text-xs text-amber-300 hover:bg-slate-800 transition" title="Cycle Studio Backdrop">
            <i class="fa-solid fa-sun"></i>
          </button>
        </div>
      </div>

      <!-- Try-On Locked Item Floating Banner -->
      <div id="preview-purchase-banner" class="hidden absolute bottom-16 left-1/2 -translate-x-1/2 z-20 glass-panel px-4 py-2.5 rounded-2xl border border-amber-400/50 shadow-2xl flex items-center gap-3">
        <div class="w-8 h-8 rounded-xl bg-amber-500/20 border border-amber-400/40 flex items-center justify-center text-amber-300">
          <i class="fa-solid fa-eye"></i>
        </div>
        <div>
          <p class="text-xs font-bold text-white">Trying On: <span id="preview-item-name" class="text-amber-300">Item</span></p>
          <p class="text-[10px] text-slate-300">Unlock permanently for this character with EraGems</p>
        </div>
        <button id="preview-buy-btn" class="px-3 py-1.5 rounded-xl bg-gradient-to-r from-cyan-400 to-sky-500 hover:from-cyan-300 hover:to-sky-400 text-slate-950 font-extrabold text-xs flex items-center gap-1.5 shadow-lg transition">
          <i class="fa-solid fa-gem"></i> Buy (<span id="preview-item-cost">100</span>)
        </button>
        <button onclick="clearPreviewItem()" class="p-1.5 rounded-lg text-slate-400 hover:text-white text-xs" title="Revert">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <!-- Three.js 3D Canvas Container -->
      <div id="canvas-container" class="w-full flex-1 cursor-grab active:cursor-grabbing relative"></div>

      <!-- Bottom Floating Quick Controls -->
      <div class="absolute bottom-3 left-1/2 -translate-x-1/2 z-10 pointer-events-none flex items-center gap-2">
        <div class="glass-panel px-3.5 py-2 rounded-2xl shadow-xl pointer-events-auto flex items-center gap-2.5 border border-white/10">
          <span class="text-[11px] text-slate-400 hidden sm:inline"><i class="fa-solid fa-computer-mouse mr-1 text-sky-400"></i>Drag to rotate • Scroll to zoom</span>
          <div class="h-3.5 w-[1px] bg-slate-700 hidden sm:block"></div>
          <button onclick="toggleAutoRotate()" id="btn-autorotate" class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-slate-800 text-slate-300 hover:bg-slate-700 transition">
            <i class="fa-solid fa-rotate mr-1"></i>Auto-Spin
          </button>
          <button onclick="openEraGemsModal()" class="px-2.5 py-1 rounded-lg text-xs font-bold bg-gradient-to-r from-cyan-500/30 to-sky-500/30 text-cyan-200 border border-cyan-400/40 hover:border-cyan-300 transition">
            <i class="fa-solid fa-gem mr-1 text-cyan-300"></i>IELTS Quiz (+Gems)
          </button>
        </div>
      </div>
    </main>

    <!-- RIGHT PANEL: ORGANIZED WARDROBE & ERAGEMS SHOP -->
    <aside class="w-full lg:w-96 xl:w-[430px] border-t lg:border-t-0 lg:border-l border-slate-800/80 bg-slate-900/85 flex flex-col shrink-0 max-h-[48vh] lg:max-h-full z-20">
      <!-- Category Tabs -->
      <div class="p-2.5 border-b border-slate-800/80 bg-slate-950/50">
        <div class="grid grid-cols-6 gap-1">
          <button onclick="switchCustomTab('body')" id="tab-body" class="custom-tab flex flex-col items-center justify-center py-2 rounded-xl text-[10px] font-bold bg-sky-500 text-white shadow-lg shadow-sky-500/25 transition relative">
            <span class="absolute -top-1 right-1 px-1 rounded text-[8px] bg-emerald-500 text-slate-950 font-extrabold">FREE</span>
            <i class="fa-solid fa-user-astronaut text-sm mb-1"></i>
            <span>Body/Skin</span>
          </button>
          <button onclick="switchCustomTab('hair')" id="tab-hair" class="custom-tab flex flex-col items-center justify-center py-2 rounded-xl text-[10px] font-bold bg-slate-800/80 text-slate-400 hover:text-slate-200 transition relative">
            <span class="absolute -top-1 right-1 px-1 rounded text-[8px] bg-cyan-400 text-slate-950 font-extrabold">4 FREE</span>
            <i class="fa-solid fa-scissors text-sm mb-1"></i>
            <span>Hair</span>
          </button>
          <button onclick="switchCustomTab('clothes')" id="tab-clothes" class="custom-tab flex flex-col items-center justify-center py-2 rounded-xl text-[10px] font-bold bg-slate-800/80 text-slate-400 hover:text-slate-200 transition relative">
            <span class="absolute -top-1 right-1 px-1 rounded text-[8px] bg-cyan-400 text-slate-950 font-extrabold">LAYERED</span>
            <i class="fa-solid fa-shirt text-sm mb-1"></i>
            <span>Clothes</span>
          </button>
          <button onclick="switchCustomTab('headgear')" id="tab-headgear" class="custom-tab flex flex-col items-center justify-center py-2 rounded-xl text-[10px] font-bold bg-slate-800/80 text-slate-400 hover:text-slate-200 transition relative">
            <span class="absolute -top-1 right-1 px-1 rounded text-[8px] bg-amber-400 text-slate-950 font-extrabold">💎50+</span>
            <i class="fa-solid fa-hat-cowboy text-sm mb-1"></i>
            <span>Headgear</span>
          </button>
          <button onclick="switchCustomTab('accessories')" id="tab-accessories" class="custom-tab flex flex-col items-center justify-center py-2 rounded-xl text-[10px] font-bold bg-slate-800/80 text-slate-400 hover:text-slate-200 transition relative">
            <span class="absolute -top-1 right-1 px-1 rounded text-[8px] bg-amber-400 text-slate-950 font-extrabold">💎50+</span>
            <i class="fa-solid fa-glasses text-sm mb-1"></i>
            <span>Props</span>
          </button>
          <button onclick="switchCustomTab('bikes')" id="tab-bikes" class="custom-tab flex flex-col items-center justify-center py-2 rounded-xl text-[10px] font-bold bg-slate-800/80 text-slate-400 hover:text-slate-200 transition relative">
            <span class="absolute -top-1 right-1 px-1 rounded text-[8px] bg-purple-400 text-slate-950 font-extrabold">💎120+</span>
            <i class="fa-solid fa-bicycle text-sm mb-1"></i>
            <span>Bikes</span>
          </button>
        </div>
      </div>

      <!-- EraGems Status Subbar -->
      <div class="px-4 py-2 bg-slate-950/80 border-b border-slate-800/80 flex items-center justify-between text-[11px]">
        <span id="shop-rule-text" class="text-emerald-300 font-semibold">
          <i class="fa-solid fa-circle-check mr-1"></i>Anatomical Body & Skin is 100% FREE!
        </span>
        <span class="text-cyan-300 font-bold flex items-center gap-1">
          <i class="fa-solid fa-gem text-cyan-400"></i> <span id="sidebar-gem-balance">420</span>
        </span>
      </div>

      <!-- Customizer Tab Content -->
      <div id="customizer-content" class="flex-1 overflow-y-auto p-4 space-y-5"></div>
    </aside>
  </div>

  <!-- MODAL 1: ERAGEMS REWARDS & IELTS QUIZ CENTER -->
  <div id="eragems-modal" class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-md hidden items-center justify-center p-4">
    <div class="bg-slate-900 border border-cyan-500/40 rounded-3xl max-w-lg w-full p-6 shadow-2xl space-y-5 relative overflow-hidden">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-11 h-11 rounded-2xl bg-cyan-500/20 border border-cyan-400/40 flex items-center justify-center text-cyan-300 text-xl">
            <i class="fa-solid fa-gem"></i>
