rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /homeworkConfig/{configId} {
      allow read: if true;
      allow write: if true;
    }

    match /test_settings/{testId} {
      allow read, write: if true;
    }
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "janrelbugtay03@gmail.com" || 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.uid != null
      );
    }
    function isValidAssignment(data) {
      return data.keys().hasAll(['title', 'type', 'createdBy', 'createdAt']) &&
             data.title is string &&
             data.type is string && 
             data.createdBy is string &&
             data.createdAt is timestamp;
    }
    function isValidSubmission(data) {
      return data.assignmentId is string &&
             data.userId is string &&
             (data.createdAt is timestamp || data.createdAt is number);
    }
    function isValidClass(data) {
      return data.keys().hasAll(['name', 'createdBy', 'createdAt']) &&
             data.keys().size() == 3 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.createdBy is string && data.createdBy == request.auth.uid &&
             data.createdAt is timestamp;
    }
    function isValidStudent(data) {
      return data.keys().hasAll(['classId', 'name', 'avatarSeed', 'points', 'createdAt']) &&
             data.keys().size() == 5 &&
             data.classId is string && isValidId(data.classId) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.avatarSeed is string && data.avatarSeed.size() <= 100 &&
             data.points is number && data.points >= 0 &&
             data.createdAt is timestamp;
    }
    match /test/{docId} {
      allow read, write: if true;
    }
    match /speaking_tests/{testId} {
      allow read, write: if true;
    }
    match /writing_tests/{testId} {
      allow read, write: if true;
    }
    match /reading_tests/{testId} {
      allow read, write: if true;
    }
    match /listening_tests/{testId} {
      allow read, write: if true;
    }
    match /activity_logs/{logId} {
      allow read, write: if true;
    }
    match /leaderboard/{boardId} {
      allow read, write: if true;
    }
    match /assignments/{assignmentId} {
      allow read: if true;
      allow list: if true;
      allow create: if isSignedIn() && isAdmin() && isValidId(assignmentId) &&
                       isValidAssignment(incoming());
      allow update: if isSignedIn() && isAdmin() && isValidId(assignmentId) &&
                       isValidAssignment(incoming());
      allow delete: if isSignedIn() && isAdmin() && isValidId(assignmentId);
    }
    match /submissions/{submissionId} {
      allow read, write: if true;
      match /recordings/{recordingId} {
        allow read, write: if true;
      }
    }
    match /classes/{classId} {
      allow read: if true;
      allow list: if true;
      allow create: if isSignedIn() && isAdmin() && isValidId(classId) && isValidClass(incoming());
      allow update: if isSignedIn() && isAdmin() && isValidId(classId);
      allow delete: if isSignedIn() && isAdmin() && isValidId(classId);
    }
    
    match /students/{studentId} {
      allow read: if true;
      allow list: if true;
      allow create: if isSignedIn() && isAdmin() && isValidId(studentId) && isValidStudent(incoming());
      allow update: if isSignedIn() && isAdmin() && isValidId(studentId);
      allow delete: if isSignedIn() && isAdmin() && isValidId(studentId);
    }
    match /admins/{userId} {
      allow read: if true;
      allow write: if false;
    }
    match /chats/{chatId} {
      allow read, write: if true;
    }
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }
    match /folders/{folderId} {
      allow read, write: if true;
    }
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    function isValidGameDeck(data) {
      return data.keys().hasAll(['title', 'course', 'mode', 'source', 'dollarReward', 'questions']) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 140 &&
             data.course in ['Pre-Starter', 'Starter', 'Movers', 'Flyers', 'KET', 'PET', 'IELTS'] &&
             data.mode in ['trivia', 'board', 'arena'] &&
             data.source in ['native', 'hamster_sync', 'teacher_custom'] &&
             data.dollarReward is number && data.dollarReward >= 0 && data.dollarReward <= 500 &&
             data.questions is list && data.questions.size() > 0 && data.questions.size() <= 100;
    }

    function isValidGameAssignment(data) {
      return data.keys().hasAll(['title', 'deckId', 'course', 'mode', 'dollarReward', 'isActive', 'createdBy']) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 140 &&
             data.deckId is string && isValidId(data.deckId) &&
             data.course in ['Pre-Starter', 'Starter', 'Movers', 'Flyers', 'KET', 'PET', 'IELTS'] &&
             data.mode in ['trivia', 'board', 'arena'] &&
             data.dollarReward is number && data.dollarReward >= 0 && data.dollarReward <= 500 &&
             data.isActive is bool &&
             data.createdBy is string && data.createdBy.size() <= 128;
    }

    function isValidGameProgress(data) {
      return data.keys().hasAll(['deckId', 'userId', 'mode', 'score', 'totalQuestions', 'dollarsAwarded']) &&
             data.deckId is string && isValidId(data.deckId) &&
             data.userId is string && isValidId(data.userId) &&
             data.mode in ['trivia', 'board', 'arena'] &&
             data.score is number && data.score >= 0 &&
             data.totalQuestions is number && data.totalQuestions >= 0 &&
             data.dollarsAwarded is number && data.dollarsAwarded >= 0 && data.dollarsAwarded <= 500;
    }

    match /game_decks/{deckId} {
      allow read: if true;
      allow create, update: if isValidId(deckId) && isValidGameDeck(incoming());
      allow delete: if isValidId(deckId);
    }

    match /game_assignments/{assignmentId} {
      allow read: if true;
      allow create, update: if isValidId(assignmentId) && isValidGameAssignment(incoming());
      allow delete: if isValidId(assignmentId);
    }

    match /game_progress/{progressId} {
      allow read: if true;
      allow create, update: if isValidId(progressId) && isValidGameProgress(incoming());
      allow delete: if isValidId(progressId);
    }

    match /hamster_sync_settings/{settingId} {
      allow read, write: if true;
    }

    match /faculty_employees/{employeeId} {
      allow read, write: if true;
    }

    match /faculty_tasks/{taskId} {
      allow read, write: if true;
    }

    match /faculty_approvals/{approvalId} {
      allow read, write: if true;
    }

    match /faculty_notifications/{notifId} {
      allow read, write: if true;
    }

    match /faculty_gamification/{docId} {
      allow read, write: if true;
    }
  }
}
