{
  "entities": {
    "Assignment": {
      "title": "Assignment",
      "description": "An IELTS homework assignment",
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "reading",
            "listening",
            "writing"
          ]
        },
        "content": {
          "type": "string"
        },
        "createdBy": {
          "type": "string"
        },
        "createdAt": {
          "type": "number"
        },
        "updatedAt": {
          "type": "number"
        }
      },
      "required": [
        "title",
        "description",
        "type",
        "content",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "Submission": {
      "title": "Submission",
      "description": "A student's answer to an assignment",
      "type": "object",
      "properties": {
        "assignmentId": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "answers": {
          "type": "string"
        },
        "createdAt": {
          "type": "number"
        }
      },
      "required": [
        "assignmentId",
        "userId",
        "answers",
        "createdAt"
      ]
    },
    "Class": {
      "title": "Class",
      "description": "A class created by a teacher",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "createdBy": {
          "type": "string"
        },
        "createdAt": {
          "type": "number"
        }
      },
      "required": [
        "name",
        "createdBy",
        "createdAt"
      ]
    },
    "Student": {
      "title": "Student",
      "description": "A student profile within a class",
      "type": "object",
      "properties": {
        "classId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "avatarSeed": {
          "type": "string"
        },
        "points": {
          "type": "number"
        },
        "createdAt": {
          "type": "number"
        }
      },
      "required": [
        "classId",
        "name",
        "avatarSeed",
        "points",
        "createdAt"
      ]
    },
    "TestSetting": {
      "title": "TestSetting",
      "description": "Visibility settings for tests",
      "type": "object",
      "properties": {
        "isPublished": {
          "type": "boolean"
        }
      },
      "required": []
    },
    "Folder": {
      "title": "Folder",
      "description": "A subfolder inside a course or parent folder",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "course": {
          "type": "string"
        },
        "parentId": {
          "type": "string"
        },
        "createdAt": {
          "type": "number"
        }
      },
      "required": [
        "name",
        "course",
        "createdAt"
      ]
    },
    "GameDeck": {
      "title": "GameDeck",
      "description": "Course-matched ESL game question deck synced from Hamster English or created by teachers",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 140 },
        "description": { "type": "string", "maxLength": 400 },
        "course": { "type": "string", "enum": ["Pre-Starter", "Starter", "Movers", "Flyers", "KET", "PET", "IELTS"] },
        "mode": { "type": "string", "enum": ["trivia", "board", "arena"] },
        "source": { "type": "string", "enum": ["native", "hamster_sync", "teacher_custom"] },
        "dollarReward": { "type": "number" },
        "questions": { "type": "array" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["title", "course", "mode", "source", "dollarReward", "questions"]
    },
    "GameAssignment": {
      "title": "GameAssignment",
      "description": "Teacher-assigned game homework tied to a course or subfolder",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 140 },
        "deckId": { "type": "string", "maxLength": 128 },
        "deckTitle": { "type": "string", "maxLength": 140 },
        "course": { "type": "string", "enum": ["Pre-Starter", "Starter", "Movers", "Flyers", "KET", "PET", "IELTS"] },
        "folderId": { "type": "string", "maxLength": 128 },
        "mode": { "type": "string", "enum": ["trivia", "board", "arena"] },
        "dollarReward": { "type": "number" },
        "isActive": { "type": "boolean" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["title", "deckId", "course", "mode", "dollarReward", "isActive", "createdBy"]
    },
    "GameProgress": {
      "title": "GameProgress",
      "description": "Student completion and Era Dollar reward records for games and homework",
      "type": "object",
      "properties": {
        "assignmentId": { "type": "string", "maxLength": 128 },
        "deckId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "studentName": { "type": "string", "maxLength": 120 },
        "course": { "type": "string", "maxLength": 40 },
        "mode": { "type": "string", "enum": ["trivia", "board", "arena"] },
        "score": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "dollarsAwarded": { "type": "number" },
        "completedAt": { "type": "number" }
      },
      "required": ["deckId", "userId", "mode", "score", "totalQuestions", "dollarsAwarded"]
    }
  },
  "firestore": {
    "/folders/{folderId}": {
      "schema": {
        "$ref": "#/entities/Folder"
      },
      "description": "Folders for organizing students within courses"
    },
    "/assignments/{assignmentId}": {
      "schema": {
        "$ref": "#/entities/Assignment"
      },
      "description": "Assignments created by the teacher"
    },
    "/submissions/{submissionId}": {
      "schema": {
        "$ref": "#/entities/Submission"
      },
      "description": "Submissions belonging to students"
    },
    "/classes/{classId}": {
      "schema": {
        "$ref": "#/entities/Class"
      },
      "description": "Classes created by the teacher"
    },
    "/students/{studentId}": {
      "schema": {
        "$ref": "#/entities/Student"
      },
      "description": "Student profiles belonging to a class"
    },
    "/admins/{userId}": {
      "schema": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          }
        }
      },
      "description": "Trusted admin users (teachers)"
    },
    "/test_settings/{testId}": {
      "schema": {
        "$ref": "#/entities/TestSetting"
      },
      "description": "Settings for test visibility"
    },
    "/game_decks/{deckId}": {
      "schema": {
        "$ref": "#/entities/GameDeck"
      },
      "description": "Course-matched ESL game decks synced from Hamster English or authored by teachers"
    },
    "/game_assignments/{assignmentId}": {
      "schema": {
        "$ref": "#/entities/GameAssignment"
      },
      "description": "Teacher-assigned game homework per course folder"
    },
    "/game_progress/{progressId}": {
      "schema": {
        "$ref": "#/entities/GameProgress"
      },
      "description": "Completed student game sessions and homework reward payouts"
    }
  }
}