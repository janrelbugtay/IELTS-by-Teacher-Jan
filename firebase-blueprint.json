{
  "entities": {
    "Assignment": {
      "title": "Assignment",
      "description": "Course assignment or homework task created by a teacher.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "type": { "type": "string" },
        "course": { "type": "string" },
        "description": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "type", "createdBy", "createdAt"]
    },
    "Submission": {
      "title": "Submission",
      "description": "Student test or homework submission and AI/teacher evaluation.",
      "type": "object",
      "properties": {
        "assignmentId": { "type": "string" },
        "userId": { "type": "string" },
        "studentName": { "type": "string" },
        "bandScore": { "type": "number" },
        "score": { "type": "number" },
        "aiFeedback": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["assignmentId", "userId", "createdAt"]
    },
    "User": {
      "title": "User",
      "description": "Student or teacher profile including EraVerse wallet and avatar state.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "course": { "type": "string" },
        "eraGems": { "type": "number" },
        "eraDollars": { "type": "number" }
      }
    },
    "GameDeck": {
      "title": "GameDeck",
      "description": "Bubble Island and EraGames question deck.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 140 },
        "course": { "type": "string", "enum": ["Pre-Starter", "Starter", "Movers", "Flyers", "KET", "PET", "IELTS"] },
        "mode": { "type": "string", "enum": ["trivia", "board", "arena"] },
        "source": { "type": "string", "enum": ["native", "hamster_sync", "teacher_custom"] },
        "dollarReward": { "type": "number" }
      },
      "required": ["title", "course", "mode", "source", "dollarReward"]
    },
    "FacultyTask": {
      "title": "FacultyTask",
      "description": "AI Employee task, exam evaluation, or creative content output in ERA FACULTY HQ.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "employeeId": { "type": "string" },
        "status": { "type": "string" },
        "priority": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["title", "employeeId", "status", "createdAt"]
    },
    "FacultyApproval": {
      "title": "FacultyApproval",
      "description": "Audit log entry for Teacher Jan assessment approvals and revision requests.",
      "type": "object",
      "properties": {
        "taskId": { "type": "string" },
        "action": { "type": "string" },
        "actorName": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["taskId", "action", "actorName", "timestamp"]
    }
  },
  "firestore": {
    "/assignments/{assignmentId}": {
      "schema": { "$ref": "#/entities/Assignment" },
      "description": "Homework and assessment assignments."
    },
    "/submissions/{submissionId}": {
      "schema": { "$ref": "#/entities/Submission" },
      "description": "Student submissions and evaluated scores."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles, courses, and EraVerse wallets."
    },
    "/game_decks/{deckId}": {
      "schema": { "$ref": "#/entities/GameDeck" },
      "description": "Course-matched Bubble Island and EraGames decks."
    },
    "/faculty_tasks/{taskId}": {
      "schema": { "$ref": "#/entities/FacultyTask" },
      "description": "ERA FACULTY HQ AI employee task queue and reports."
    },
    "/faculty_approvals/{approvalId}": {
      "schema": { "$ref": "#/entities/FacultyApproval" },
      "description": "ERA FACULTY HQ approval audit log."
    }
  }
}